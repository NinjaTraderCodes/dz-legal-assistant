---
// How the AI is kept in its place: the four stages, as the workbench's progress panel shows them, each with its picture
// from the desktop app's own capture (the drafting in progress from the live recording); the measured results with their mode and source; and the line that
// matters to a lawyer.
import type { ImageMetadata } from "astro";
import Icon from "./Icon.astro";
import Shot from "./Shot.astro";
import AppPiece from "./AppPiece.astro";
import desktopRun from "../content/desktop-run.json";
import { groundsTitle, splitGrounds } from "../content/steps";
import Source from "./Source.astro";
import { t, type Lang } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const frames = import.meta.glob<ImageMetadata>("../assets/shots/desktop/*.png", { eager: true, import: "default" });
const frame = (name: string) => {
    const hit = Object.entries(frames).find(([path]) => path.endsWith(`/${name}.png`));
    if (!hit) throw new Error(`missing picture ${name}.png in src/assets/shots (node scripts/crops.mjs)`);
    return hit[1];
};
// A crop of the desktop app rendered at scale 2 (src/content/desktop-run.json says which run), in the page's language,
// light and dark.
const desktop = (name: string) => ({ light: frame(`desktop/${name}-${lang}-light`), dark: frame(`desktop/${name}-${lang}-dark`), note: t(lang, "shot.desktop") });
// The activity panel shows the model's words as they arrive: the opening of its first application, from the same run.
const firstApplication = desktopRun.paragraphs.flatMap(splitGrounds).find((line) => line.by === "ai")?.text ?? "";
const live = firstApplication.split(/\s+/).slice(0, 14).join(" ");

// Stage 2 is the code's own step: no model. Stage 4 is the one in progress on the panel, as drafting is the last.
const stages = [1, 2, 3, 4].map((n) => ({
    n,
    title: t(lang, `ai.stage${n}.title`),
    body: t(lang, `ai.stage${n}.body`),
    caption: t(lang, `ai.shot.stage${n}`),
    model: n !== 2,
    // Stages 1 to 3 and the drafted grounds are crops of the desktop capture; the drafting in progress is drawn.
    shot: desktop(n === 1 ? "reading" : n === 2 ? "proposed" : n === 3 ? "confirm" : "paper"),
}));
---
<section class="section page ai" aria-labelledby="ai-title">
    <div class="intro">
        <h2 id="ai-title" class="h1">{t(lang, "ai.title")}</h2>
        <p class="lead">{t(lang, "ai.lead")}</p>
    </div>
    <ol class="stages">
        {stages.map((stage, i) => (
            <li class="stage">
                <div class="row">
                    <span class={`dot ${i === stages.length - 1 ? "active" : "done"}`} aria-hidden="true">{i < stages.length - 1 && <Icon name="checkmark" size={12} />}</span>
                    <div>
                        <h3 class="h3">{stage.title} {stage.model ? <span class="chip chip-accent"><Icon name="sparkle" size={12} /> AI</span> : <span class="chip chip-success"><Icon name="checkmark_circle" size={12} /> {lang === "ar" ? "برمجة" : "code"}</span>}</h3>
                        <p>{stage.body}</p>
                        {stage.n === 4 && <p class="time">{t(lang, "ai.stage4.time")}</p>}
                    </div>
                </div>
                <div class="pictures">
                    {stage.n === 4 && <AppPiece lang={lang} kind="activity" section={groundsTitle[lang]} live={live + " …"} caption={t(lang, "ai.shot.activity")} />}
                    <Shot lang={lang} light={stage.shot.light} dark={stage.shot.dark} alt={stage.caption} caption={stage.caption} note={stage.shot.note} width={stage.n === 4 ? 560 : 360} quality={stage.n === 4 ? 50 : 72} />
                </div>
            </li>
        ))}
    </ol>
    <Source lang={lang} files={["README.md"]} />
    <div class="measure card-alt">
        <p>{t(lang, "ai.measure")}</p>
        <p class="caption">{t(lang, "ai.measureNote")}</p>
        <Source lang={lang} files={["docs/HIDDEN-SET.md"]} />
    </div>
    <p class="sign h2">{t(lang, "ai.sign")}</p>
</section>

<style>
    .ai { display: grid; gap: 36px; }
    .intro { display: grid; gap: 16px; max-width: 820px; }
    /* Each stage is as tall as what it holds, so no card keeps an empty band under its picture. */
    .stages { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; align-items: start; }
    .stage { display: grid; gap: 14px; align-content: start; background: var(--surface-alt); border: 1px solid var(--hairline); border-radius: var(--radius-control); padding: 14px 16px 18px; }
    /* The drafting stage, the long one, takes the whole last row: its text and the activity panel on one side, the
       drafted grounds on the other. */
    .stage:last-child { grid-column: 1 / -1; }
    @media (min-width: 900px) {
        .stage:last-child { grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); column-gap: 28px; }
        .stage:last-child .pictures { display: contents; }
        .stage:last-child .row { grid-column: 1; grid-row: 1; }
        .stage:last-child .pictures > :global(.piece) { grid-column: 1; grid-row: 2; align-self: start; }
        .stage:last-child .pictures > :global(.shot) { grid-column: 2; grid-row: 1 / span 2; justify-self: end; align-self: start; }
    }
    .row { display: grid; grid-template-columns: auto 1fr; gap: 12px; align-items: start; }
    .stage h3 { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-bottom: 8px; font-size: 1.1rem; }
    .stage p { font-size: 0.95rem; }
    .time { margin-top: 8px; font-weight: 600; }
    .pictures { display: grid; gap: 12px; }
    .dot { display: inline-grid; place-items: center; width: 18px; height: 18px; border-radius: 50%; margin-top: 6px; }
    .dot.done { background: var(--success-soft); color: var(--success); }
    .dot.active { width: 10px; height: 10px; margin-inline: 4px; background: var(--accent); animation: pulse 0.9s ease-in-out infinite alternate; }
    @keyframes pulse { to { opacity: 0.2; } }
    .measure { display: grid; gap: 10px; max-width: 820px; }
    .measure p { max-width: none; }
    .sign { color: var(--accent); max-width: none; }
    @media (max-width: 899px) { .stages { grid-template-columns: 1fr; } }
    @media (prefers-reduced-motion: reduce) { .dot.active { animation: none; } }
</style>
