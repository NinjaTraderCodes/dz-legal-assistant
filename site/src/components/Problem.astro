---
// The problem in one sentence, beside what the product shows the lawyer: a fragment of the petition where the
// defendant's domicile is missing, the red note in its margin with the article that requires it, and the formal check
// typed under it at 7 of 9. The petition's text is the fictitious sample case's (src/content/steps.ts).
import Folder from "./Folder.astro";
import CheckReport from "./CheckReport.astro";
import { s, t, type Lang } from "../i18n";
import { paper } from "../content/steps";

interface Props { lang: Lang }
const { lang } = Astro.props;
const defendant = paper.find((sec) => sec.id === "defendant");
const ui = { lang, dir: lang === "ar" ? "rtl" : "ltr" } as const;
---
<Folder tone="kraft" no="02" tab={t(lang, "tab.problem")} id="problem" labelledby="problem-title">
    <div class="page problem">
        <div class="text">
            <h2 id="problem-title" class="h1">{t(lang, "problem.title")}</h2>
            <p class="lead">{t(lang, "problem.body")}</p>
        </div>
        <aside class="sheet fragment" aria-label={s(lang, "Compliance")}>
            <span class="staple" aria-hidden="true"></span>
            <div class="doc" lang="ar" dir="rtl">
                <p class="title">عريضة افتتاح دعوى</p>
                {defendant?.lines.map((line) => <p>{line}</p>)}
                <p class="gap" aria-hidden="true"><span>القاطن بـ:</span><span class="blank"></span></p>
            </div>
            <div class="margin-note" {...ui}>
                <strong>{t(lang, "problem.finding.title")}</strong>
                <span>{t(lang, "problem.finding.article")}</span>
                <span>{t(lang, "problem.finding.text")}</span>
            </div>
            <CheckReport lang={lang} score={7} missing />
        </aside>
    </div>
</Folder>

<style>
    .problem { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(300px, 0.9fr); gap: clamp(32px, 6vw, 88px); align-items: center; }
    .text { display: grid; gap: 20px; }
    .fragment { display: grid; gap: 18px; padding: 30px 28px 24px; }
    .doc { font-family: var(--font-doc); font-size: 1.05rem; line-height: 1.9; text-align: right; }
    .doc p { max-width: none; }
    .doc .title { text-align: center; font-weight: 700; margin-bottom: 8px; }
    .gap { display: flex; gap: 10px; align-items: baseline; }
    .blank { flex: 1; height: 1.1em; border-bottom: 2px dotted var(--w-sheet-red); background: color-mix(in srgb, var(--w-sheet-red) 7%, transparent); }
    /* The note a reviewer writes under the gap: red, in the reader's language, tied to the gap by a red mark. */
    .margin-note { position: relative; display: grid; gap: 2px; padding-top: 10px; color: var(--w-sheet-red); font-size: 0.9rem; line-height: 1.5; }
    .margin-note::before { content: ""; position: absolute; top: 0; inset-inline-start: 0; width: 44px; height: 2px; background: currentColor; }
    .margin-note strong { font-size: 0.95rem; }
    @media (max-width: 899px) { .problem { grid-template-columns: 1fr; } }
</style>
