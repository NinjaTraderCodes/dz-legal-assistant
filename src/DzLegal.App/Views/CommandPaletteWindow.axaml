<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:DzLegal.App.Views" xmlns:app="using:DzLegal.App"
        x:Class="DzLegal.App.Views.CommandPaletteWindow" x:DataType="views:CommandPaletteModel"
        Title="{Binding Owner.L[WB.Commands]}" Width="{StaticResource PaletteWidth}" Height="{StaticResource PaletteHeight}"
        CanResize="False" WindowStartupLocation="CenterOwner" Background="{DynamicResource SurfaceBrush}"
        FontFamily="{StaticResource UiFont}"
        FlowDirection="{Binding Owner.IsRightToLeft, Converter={x:Static app:Converters.RightToLeft}}"
        RequestedThemeVariant="{Binding Owner.IsDarkTheme, Converter={x:Static app:Converters.DarkTheme}}">
  <DockPanel Margin="{StaticResource Inset16}">
    <TextBlock DockPanel.Dock="Top" Text="{Binding Owner.L[WB.Commands]}" FontWeight="SemiBold" Margin="{StaticResource Inset0_0_0_12}"/>
    <TextBox Name="PaletteQuery" Loaded="QueryLoaded" DockPanel.Dock="Top" Text="{Binding Query, Mode=TwoWay}" PlaceholderText="{Binding Owner.L[WB.Search]}"
             AutomationProperties.Name="{Binding Owner.L[WB.Search]}" Margin="{StaticResource Inset0_0_0_12}"/>
    <TextBlock DockPanel.Dock="Bottom" Classes="secondary" Text="{Binding Owner.L[WB.PaletteKeys]}" Margin="{StaticResource Inset0_8_0_0}"/>
    <Grid>
      <ListBox Name="PaletteActions" Classes="steps" Background="{DynamicResource SurfaceBrush}" BorderThickness="0" ItemsSource="{Binding Actions}" SelectedIndex="0" DoubleTapped="ActivateEntry"
               AutomationProperties.Name="{Binding Owner.L[WB.Commands]}">
        <ListBox.ItemTemplate><DataTemplate x:DataType="views:PaletteAction"><Border IsEnabled="{Binding IsEnabled}"><TextBlock Text="{Binding Label}" Classes.muted="{Binding !IsEnabled}" TextWrapping="Wrap"/></Border></DataTemplate></ListBox.ItemTemplate>
        <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="Padding" Value="{StaticResource Inset12_8}"/></Style></ListBox.Styles>
      </ListBox>
      <TextBlock Text="{Binding Owner.L[WB.NoCommands]}" IsVisible="{Binding HasNoActions}" Margin="{StaticResource Inset16}"/>
    </Grid>
  </DockPanel>
</Window>
