---
// The nine steps beside the petition on paper: the one orchestrated moment of the page. The case form is a register
// sheet clipped to the folder: each entry is ticked in violet ink as it is filled, and the formal check is typed under
// it. With JavaScript the entries tick and the petition fills as the reader scrolls (src/scripts/story.ts): the form
// first, then the legal grounds, where the code's quoted rules and the AI's lines are told apart on the sheet and the
// review box is ticked; at 9 of 9 the register is stamped "ready to file", once. Without it, and with reduced motion,
// the final state is simply shown. The petition is the app's own for the sample, section by section, with the layout
// the form definition gives each section (src/content/paper-ar.json); the grounds are whole paragraphs, as the app
// writes them, with the code's part marked on the site only. It keeps the app's draft watermark: the sample case forces
// it, and the lawyer, not the software, files.
import Folder from "./Folder.astro";
import Clip from "./Clip.astro";
import Icon from "./Icon.astro";
import Source from "./Source.astro";
import CheckReport from "./CheckReport.astro";
import { downloadUrl } from "../content/product";
import { steps, paper, paperWatermark, writingOrder } from "../content/steps";
import { s, t, type Lang } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
// The marks beside the Arabic document are in the reader's language, like the workbench's own tags.
const ui = { lang, dir: lang === "ar" ? "rtl" : "ltr" } as const;
---
<Folder tone="salmon" no="03" tab={t(lang, "nav.how")} id="how" class="story" labelledby="story-title">
    <div class="page" data-story data-order={writingOrder.join(" ")}>
        <header class="intro">
            <h2 id="story-title" class="h1">{t(lang, "story.title")}</h2>
            <p class="lead">{t(lang, "story.lead")}</p>
        </header>
        <div class="stage">
            <div class="side sheet register">
                <Clip />
                <h3 class="register-title">{s(lang, "CaseForm")}</h3>
                <ol class="entries" aria-label={s(lang, "CaseForm")}>
                    {steps.map((step, i) => (
                        <li class="step done" data-step={step.id}>
                            <span class="reg-no">{String(i + 1).padStart(2, "0")}</span>
                            <span class="label">{step.label[lang]}</span>
                            <svg class="tick" viewBox="0 0 24 20" aria-hidden="true"><use href="#tick-shape" /></svg>
                        </li>
                    ))}
                </ol>
                <CheckReport lang={lang} score={9} live>
                    <div class="finding" data-finding="domicile" hidden>
                        <strong>{t(lang, "problem.finding.title")}</strong>
                        <span>{t(lang, "problem.finding.article")}</span>
                    </div>
                    <div class="finding" data-finding="grounds" hidden>
                        <strong>{t(lang, "story.finding.grounds.title")}</strong>
                        <span>{t(lang, "story.finding.grounds.article")}</span>
                    </div>
                </CheckReport>
                <p class="stamp ready" data-ready>{t(lang, "stamp.ready")}<span class="sr-only">: </span><small>{t(lang, "stamp.ready.small")}</small></p>
            </div>
            <div class="paper-canvas">
                <article class:list={["paper", !paperWatermark && "no-mark"]} lang="ar" dir="rtl" aria-label="عريضة افتتاح دعوى (مثال خيالي)">
                    <span class="staple" aria-hidden="true"></span>
                    {paper.map((sec) => (
                        <div class="group" data-paper-section={sec.id}>
                            {sec.blocks.map((block) => (
                                <section class:list={["sec", `align-${block.align}`, block.bold && "bold", sec.ai && "ai"]} style={`margin-top: ${(block.spaceBefore * 1.12 / 20.5).toFixed(3)}em`}>
                                    {sec.ai && <span class="ai-mark" {...ui}><Icon name="sparkle" size={10} /> {s(lang, "ModelTag")}</span>}
                                    {block.heading && <div class="document-heading">{block.heading}:</div>}
                                    {sec.grounds
                                        ? sec.grounds.map((g) => <p class="section-text ground" data-ground>{g.rule && <span class="rule">{g.rule}</span>}{g.rule && <span class="chip-code" {...ui} data-chip><Icon name="checkmark_circle" size={11} /> {t(lang, "story.chip.code")}</span>}{g.rest}</p>)
                                        : sec.domicile
                                            ? <div class="section-text">{sec.domicile.before}<span data-domicile>{sec.domicile.domicile}</span>{sec.domicile.after}</div>
                                            : <div class="section-text">{block.text}</div>}
                                    {sec.review && <p class="review" {...ui} data-review data-done="1"><span class="box" aria-hidden="true"><Icon name="checkmark" size={11} /></span> {s(lang, "ReviewedCheck")}</p>}
                                </section>
                            ))}
                        </div>
                    ))}
                </article>
            </div>
        </div>
        <p class="caption">{t(lang, "story.caption")}</p>
        <Source lang={lang} files={["README.md", "docs/PRODUCT-DETAILS.md"]} />
        {/* The story is the page's peak: the two ways to try it follow at once, not eight screens further down. */}
        <div class="next-step">
            <p>{t(lang, "story.cta")}</p>
            <div class="actions">
                <a class="btn btn-primary" href={`/app?lang=${lang}`}>{t(lang, "hero.cta")}</a>
                <a class="btn" href={downloadUrl} rel="noopener"><Icon name="arrow_download" size={18} /> {t(lang, "hero.download")}</a>
            </div>
        </div>
    </div>
</Folder>

<style>
    [data-story] { display: grid; gap: 32px; }
    .intro { display: grid; gap: 16px; max-width: 820px; }
    .stage { display: grid; grid-template-columns: minmax(300px, 380px) minmax(0, 1fr); gap: clamp(24px, 3.5vw, 48px); align-items: start; }
    /* The register must fit a 768 px screen while the story holds it in place: compact rows, and the stamp set in the
       sheet's lower margin instead of taking a line of its own. It stays on the paper: its ink is the sheet's. */
    .side { display: grid; gap: 14px; position: sticky; top: 96px; padding: 22px 22px 128px; }
    .register-title { font-size: 0.82rem; font-weight: 600; color: var(--w-sheet-muted); padding-bottom: 10px; border-bottom: 2px solid var(--w-sheet-text); margin-bottom: -14px; }
    .entries { list-style: none; margin: 0; padding: 0; }
    .step { display: grid; grid-template-columns: 2.4em minmax(0, 1fr) 28px; align-items: center; min-height: 34px; border-radius: 0; color: var(--w-sheet-text); border-bottom: 1px solid var(--w-sheet-rule); font-size: 0.95rem; transition: background-color 200ms ease; }
    :global(html[lang="ar"]) .step { font-size: 1rem; }
    /* An entry not yet filled has its tick undrawn; the one being written is set bold on a faint violet wash. */
    .step:not(.done) .tick { stroke-dashoffset: 30; }
    .step.current { font-weight: 600; color: var(--w-sheet-text); background: color-mix(in srgb, var(--w-sheet-ink) 8%, transparent); }
    .finding { display: grid; gap: 2px; color: var(--w-sheet-red); font-size: 0.86rem; line-height: 1.5; }
    .finding[hidden] { display: none; }
    .ready { position: absolute; bottom: 16px; inset-inline-end: 18px; margin: 0; --stamp-turn: -6deg; font-size: 1.5rem; }
    /* The frame: while the story runs, the sheet scrolls inside a viewport-high window so the current section is in view. */
    :global(.framed) .paper-canvas { height: calc(100vh - var(--story-top, 96px) - 16px); box-sizing: border-box; overflow: hidden; padding: 6px; margin: -6px; }
    :global(.framed) .paper { will-change: transform; }
    /* The sheet as the app lays it out (app.css of the demo, from the desktop's paper): Noto Naskh at the app's 20.5 / 31
       ratio, each section aligned and spaced as the form definition says, headings bold and underlined, the place, date
       and signature in a narrow block at the end. Sizes are in em, so the sheet scales with the column. */
    .paper { padding-top: clamp(40px, 5vw, 60px); line-height: 1.512; }
    .paper.no-mark::before { content: none; }
    .group { display: block; }
    .sec { position: relative; padding-inline: 6px; border-inline-start: 2px solid transparent; }
    .document-heading { font-weight: 700; text-decoration: underline; text-underline-offset: 0.25em; }
    .section-text { white-space: pre-wrap; text-align: right; max-width: none; }
    .align-center .section-text { text-align: center; }
    .align-justify .section-text { text-align: justify; }
    .align-end .section-text { text-align: center; max-width: 12.7em; margin-inline-start: auto; }
    .bold .section-text { font-weight: 700; }
    /* The AI-written section, as the app marks it: a gold side line and the "AI" tag. The sheet is always light, so
       these colours are the light theme's, fixed; the tag is set at the site's 12 px floor for small text. */
    .sec.ai { border-inline-start-color: #c6a76d; }
    .paper .ai-mark { position: absolute; top: 2px; left: 0; /* the sheet is always right to left: its end is the left, whatever the tag's own direction */ display: inline-flex; align-items: center; gap: 4px; padding: 1px 8px; border-radius: 999px; font: 600 12px/1.6 var(--font-ui); background: #fff3dc; color: #786039; }
    .ground + .ground { margin-top: 0.5em; }
    /* The code's part of a paragraph, marked on the site only (the app prints the paragraph plain). */
    .paper .rule { background: linear-gradient(transparent 62%, rgb(43 122 75 / 0.14) 0); }
    .paper .chip-code { display: inline-flex; align-items: center; gap: 4px; margin-inline: 6px; padding: 0 7px; border-radius: 999px; font: 600 12px/1.7 var(--font-ui); vertical-align: middle; white-space: nowrap; background: #e5f3ea; color: #2b7a4b; }
    .paper .ground[data-writing="1"]::after { content: ""; display: inline-block; width: 2px; height: 1em; margin-inline-start: 3px; vertical-align: -0.15em; background: #c6a76d; }
    .paper .review { display: inline-flex; align-items: center; gap: 8px; width: fit-content; max-width: 100%; margin-top: 0.6em; padding: 6px 10px; border-radius: 6px; background: #f3f1ec; color: #1c2321; font: 600 13px/1.5 var(--font-ui); }
    .paper .review .box { display: inline-grid; place-items: center; flex: none; width: 16px; height: 16px; border-radius: 4px; border: 1.5px solid #a9a39a; background: #fff; color: transparent; }
    .paper .review[data-done="1"] .box { background: #786039; border-color: #786039; color: #fff; }
    .next-step { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 32px; padding-top: 24px; border-top: 2px solid var(--w-text); }
    .next-step p { font-family: var(--w-display); font-size: clamp(1.2rem, 1rem + 0.6vw, 1.5rem); line-height: 1.4; max-width: 40ch; }
    .next-step .actions { display: flex; flex-wrap: wrap; gap: 12px; }
    @media (max-width: 899px) { .stage { grid-template-columns: 1fr; } .side { position: relative; top: auto; } }
    @media (max-width: 599px) { .next-step .actions, .next-step .btn { width: 100%; } }
</style>
