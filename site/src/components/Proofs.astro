---
// What the product guarantees, in the vocabulary of its "Elements present" list: a check mark, a title, the fact,
// and a picture of the screen that shows it. The library and the app bar come from the desktop app's own frames
// (the headless UI tests, both languages and themes); the refused export from the desktop app's own frame; the
// drafted grounds from the live recording with the local model.
import type { ImageMetadata } from "astro";
import Icon from "./Icon.astro";
import Shot from "./Shot.astro";
import Source from "./Source.astro";
import { s, t, fmt, type Lang } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const shots = import.meta.glob<ImageMetadata>("../assets/shots/proofs/*.png", { eager: true, import: "default" });
const pick = (name: string) => {
    const hit = Object.entries(shots).find(([path]) => path.endsWith(`/${name}.png`));
    if (!hit) throw new Error(`missing picture ${name}.png in src/assets/shots (node scripts/crops.mjs, node tests/guide-shots.mjs)`);
    return hit[1];
};
const themed = (name: string) => ({ light: pick(`${name}-${lang}-light`), dark: pick(`${name}-${lang}-dark`) });
const items = [
    { icon: "book_open", title: t(lang, "proofs.texts.title"), body: fmt(s(lang, "AboutSources"), "1,361", "6") + " " + t(lang, "proofs.texts.body"), shot: themed("proofs/library"), caption: t(lang, "proofs.shot.texts") },
    { icon: "shield_checkmark", title: t(lang, "proofs.offline.title"), body: t(lang, "proofs.offline.body"), shot: themed("proofs/offline"), caption: t(lang, "proofs.shot.offline"), natural: true },
    { icon: "checkmark_circle", title: t(lang, "proofs.review.title"), body: t(lang, "proofs.review.body"), shot: { light: pick("proofs/export-blocked") }, caption: t(lang, "proofs.shot.review") },
    { icon: "sparkle", title: t(lang, "proofs.grounds.title"), body: t(lang, "proofs.grounds.body"), shot: { light: pick("proofs/grounds-live") }, caption: t(lang, "proofs.shot.grounds") },
];
---
<section class="section page proofs" aria-labelledby="proofs-title">
    <h2 id="proofs-title" class="h2">{t(lang, "proofs.title")}</h2>
    <ul class="list">
        {items.map((item) => (
            <li class="card">
                <div class="head">
                    <span class="tick"><Icon name={item.icon} size={22} /></span>
                    <div>
                        <h3 class="h3">{item.title}</h3>
                        <p>{item.body}</p>
                    </div>
                </div>
                <Shot lang={lang} light={item.shot.light} dark={item.shot.dark} alt={item.caption} caption={item.caption} note={item.note} width={540} natural={item.natural} />
            </li>
        ))}
    </ul>
    <Source lang={lang} files={["README.md", "docs/PRODUCT-DETAILS.md", "docs/OFFLINE.md", "data/law/codes"]} />
</section>

<style>
    .proofs { display: grid; gap: 28px; }
    .list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
    /* One column per card (the global .list rule puts an icon column first). */
    .list li { display: grid; grid-template-columns: minmax(0, 1fr); gap: 18px; align-content: start; padding: 22px 22px 24px; }
    .head { display: grid; grid-template-columns: auto 1fr; gap: 14px; align-items: start; }
    .tick { display: inline-grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--success-soft); color: var(--success); }
    .list h3 { margin-bottom: 8px; }
    .list p { font-size: 0.95rem; }
    @media (max-width: 899px) { .list { grid-template-columns: 1fr; } }
</style>
