@using DzLegal.Presentation.ViewModels
@* One case field, as the definition describes it: text, multi-line text, yes/no, a choice or a date. *@
<div class="field @(Field.IsMissing ? "missing" : "")">
    @if (Field.IsBoolean)
    {
        <label class="check">
            <input type="checkbox" checked="@Field.BoolValue" @onchange="e => Field.BoolValue = e.Value is true" />
            <span>@Field.Label</span>
        </label>
    }
    else
    {
        <div class="field-heading">
          <label for="@InputId">@Field.Label</label>
          @if(!string.IsNullOrEmpty(Field.Hint))
          {
            <details class="field-help">
              <summary aria-label="@(HelpLabel + " · " + Field.Label)"><Icon Name="question_circle"/></summary>
              <p class="small" id="@(InputId + "-help")">@Field.Hint</p>
            </details>
          }
        </div>
        @if (Field.IsChoice)
        {
            <select id="@InputId" value="@Field.Value" @onchange="e => Field.Value = e.Value?.ToString() ?? string.Empty">
                <option value="">@ChooseLabel</option>
                @foreach (var option in Field.Options)
                {
                    <option value="@option.Value">@option.Label</option>
                }
            </select>
        }
        else if (Field.IsMultiline)
        {
            <textarea id="@InputId" class="arabic" dir="rtl" lang="ar" rows="7" maxlength="@(Field.MaxLength * 3)" aria-describedby="@(Field.IsMissing ? InputId + "-note" : null)"
                      @bind="Field.Value" @bind:event="oninput"></textarea>
        }
        else
        {
            <input id="@InputId" class="arabic" dir="rtl" lang="ar" maxlength="@(Field.MaxLength * 3)" aria-describedby="@(Field.IsMissing ? InputId + "-note" : null)"
                   @bind="Field.Value" @bind:event="oninput" />
        }
    }
    @if (Field.IsMissing)
    {
        <div class="field-note" id="@(InputId + "-note")">@Field.MissingNote</div>
    }
    @if (Field.IsTooLong)
    {
        @* Kept whole and pointed out, as on the desktop; the browser's own limit (three times the field's) only stops a
           paste so large it would break the page's connection. *@
        <div class="field-note" role="status">@Field.TooLongNote</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public FieldViewModel Field { get; set; } = default!;

    [Parameter] public string ChooseLabel { get; set; } = string.Empty;

    [Parameter] public string HelpLabel { get; set; } = "Help";

    private string InputId => "f-" + Field.Id.Replace('.', '-');
}
