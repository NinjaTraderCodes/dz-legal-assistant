@using DzLegal.Presentation.ViewModels
@* A proposed or found article: tick to use it as a ground; its role, the model's reason, and where to check the text. *@
<div class="card article-card @(Article.IsSelected ? "selected" : "")">
    <label class="check">
        <input type="checkbox" checked="@Article.IsSelected" @onchange="e => Article.IsSelected = e.Value is true" />
        <span class="arabic citation" dir="rtl">@Article.Citation</span>
        @if (Article.HasRole)
        {
            <span class="tag">@Article.RoleText</span>
        }
    </label>
    @if (Article.HasModelReason)
    {
        <div class="reason arabic" dir="rtl">@Article.ModelReason</div>
    }
    @if (Article.HasWhy)
    {
        <div class="small arabic" dir="rtl">@Article.Why</div>
    }
    <div class="small muted @(Article.IsAvailable ? "arabic article-text" : "")" dir="@(Article.IsAvailable ? "rtl" : "auto")">@Article.Text</div>
    <div class="small muted arabic" dir="rtl">@Article.ReferenceText</div>
    <div class="row small">
        @if (Article.HasSource)
        {
            <a href="@Article.SourceUrl" target="_blank" rel="noopener" title="@Article.LinkTooltip">↗ @Article.LinkLabel</a>
        }
        <span class="tag warn">@Article.ProvenanceTag</span>
        @if (Article.SourceText.Length > 0)
        {
            <span class="muted">@Article.SourceText</span>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ArticleChoiceViewModel Article { get; set; } = default!;

    [Parameter, EditorRequired] public MainWindowViewModel Vm { get; set; } = default!;
}
