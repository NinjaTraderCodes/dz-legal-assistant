---
// Who built it, in the words of the About screen, plus the programme line and the honest note on how it was built.
import { s, t, type Lang } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const people = ["AboutTeamLead", "AboutTeamDesign", "AboutTeamLegal"].map((key) => s(lang, key));
---
<section id="team" class="section page team" aria-labelledby="team-title">
    <h2 id="team-title" class="h2">{t(lang, "team.title")}</h2>
    <ul class="people">
        {people.map((line) => { const [name, role] = line.split(" — "); return <li><strong>{name}</strong><span>{role}</span></li>; })}
    </ul>
    <p class="lead">{s(lang, "AboutThirdUni")}</p>
    <p class="caption">{t(lang, "team.lead")}</p>
</section>

<style>
    .team { display: grid; gap: 20px; }
    .people { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
    .people li { display: grid; gap: 4px; padding: 16px 0; border-top: 2px solid var(--edge); }
    .people span { color: var(--muted-aa); }
    @media (max-width: 899px) { .people { grid-template-columns: 1fr; } }
</style>
