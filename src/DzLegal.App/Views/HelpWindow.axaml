<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DzLegal.Presentation.ViewModels" xmlns:app="using:DzLegal.App" xmlns:ic="using:FluentIcons.Avalonia"
        x:Class="DzLegal.App.Views.HelpWindow" x:DataType="vm:HelpViewModel"
        Width="{DynamicResource OnboardingWindowWidth}" Height="{DynamicResource OnboardingWindowHeight}"
        MinWidth="{DynamicResource OnboardingWindowMinWidth}" MinHeight="{DynamicResource OnboardingWindowMinHeight}"
        WindowStartupLocation="CenterOwner" Title="{Binding L[HelpTitle]}"
        FontFamily="{DynamicResource UiFont}" Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource WelcomeTextBrush}"
        FlowDirection="{Binding IsRightToLeft, Converter={x:Static app:Converters.RightToLeft}}">
  <Window.Styles><StyleInclude Source="/Styles/Guide.axaml" /></Window.Styles>
  <Grid ClipToBounds="True">
    <Border Name="HelpBackground" Background="{DynamicResource OnboardingPhotograph}" FlowDirection="LeftToRight">
      <Border.Effect><BlurEffect Radius="{DynamicResource OnboardingBackgroundBlur}" /></Border.Effect>
    </Border>
    <Border Background="{DynamicResource WelcomeOverlayBrush}" />
    <Grid Name="HelpContent" RowDefinitions="Auto,*" Margin="{DynamicResource OnboardingPageMargin}" RowSpacing="{DynamicResource OnboardingPageGap}">
      <Border Name="HelpHeadingPanel" Background="{DynamicResource WelcomeReadingBrush}" CornerRadius="{DynamicResource OnboardingCardRadius}" Padding="{DynamicResource OnboardingHeaderPadding}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource OnboardingPageGap}">
          <Border Background="{DynamicResource WelcomeControlBrush}" CornerRadius="{DynamicResource ControlRadius}" Padding="{DynamicResource OnboardingIconPadding}" VerticalAlignment="Center">
            <ic:SymbolIcon Name="HelpHeadingIcon" Classes="onboarding-icon" Symbol="Info" />
          </Border>
          <TextBlock Name="HelpTitle" Grid.Column="1" Classes="onboarding-title" Text="{Binding Title}" />
        </Grid>
      </Border>
      <Border Name="HelpCard" Grid.Row="1" Classes="onboarding-card" MaxWidth="{DynamicResource OnboardingContentWidth}" HorizontalAlignment="Stretch">
        <Grid RowDefinitions="*,Auto" RowSpacing="{DynamicResource OnboardingPageGap}">
          <ScrollViewer Name="HelpScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Panel>
              <StackPanel IsVisible="{Binding IsIndex}">
                <ItemsControl Name="HelpPages" ItemsSource="{Binding Pages}">
                  <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:HelpPageViewModel">
                    <Button Classes="onboarding" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Title}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="{DynamicResource OnboardingRowMargin}">
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource OnboardingPageGap}">
                        <ic:SymbolIcon Classes="onboarding-icon" Symbol="DocumentText" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Classes="onboarding-body" Text="{Binding Title}" />
                      </Grid>
                    </Button>
                  </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Name="HelpTour" Classes="onboarding onboarding-primary" Command="{Binding TourCommand}" AutomationProperties.Name="{Binding L[StartTour]}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource OnboardingPageGap}">
                    <ic:SymbolIcon Classes="onboarding-icon" Symbol="Info" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding L[StartTour]}" FontSize="{DynamicResource OnboardingBodySize}" TextWrapping="Wrap" />
                  </Grid>
                </Button>
                <Button Name="HelpLibrary" Classes="onboarding" Command="{Binding LibraryCommand}" AutomationProperties.Name="{Binding L[HomeLibrary]}"
                        IsVisible="{Binding CanOpenLibrary}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,12,0,0">
                  <TextBlock Text="{Binding L[HomeLibrary]}" FontSize="{DynamicResource OnboardingBodySize}" TextWrapping="Wrap" />
                </Button>
              </StackPanel>
              <ItemsControl Name="HelpParagraphs" ItemsSource="{Binding Paragraphs}" IsVisible="{Binding !IsIndex}" MaxWidth="{DynamicResource OnboardingReadingWidth}" HorizontalAlignment="Stretch">
                <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:HelpParagraphViewModel">
                  <TextBlock Classes="onboarding-body" Text="{Binding Text}" Margin="{DynamicResource OnboardingParagraphMargin}" />
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </Panel>
          </ScrollViewer>
          <WrapPanel Grid.Row="1" HorizontalAlignment="Left">
            <Button Name="HelpBack" Classes="onboarding" Content="{Binding L[HelpBack]}" Command="{Binding BackCommand}" IsVisible="{Binding !IsIndex}" Margin="0,0,8,0" />
            <Button Name="HelpLibraryPage" Classes="onboarding" Content="{Binding L[HomeLibrary]}" Command="{Binding LibraryCommand}"
                    IsVisible="{Binding ShowLibraryPageLink}" />
          </WrapPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
