  "cSays": {
    "openPoints": [
      {
        "question": "Does the three-month cap on reconciliation run against the claim itself or only limit the attempts, and what follows if it is exceeded?",
        "readings": [
          "It only bounds the attempts; no sanction is stated",
          "The judge must move to the merits once it passes"
        ]
      },
      {
        "question": "Does the mandatory reconciliation of 439 apply to every family claim or only to divorce claims?",
        "readings": [
          "Only divorce, as placed in the divorce section",
          "Also to other claims where the Family Code requires attempts (for example khul)"
        ]
      },
      {
        "question": "Who starts the periods in 536 مكرر 4 (five days, three months)?",
        "readings": [
          "The five days run from the request and the three months from the appointment",
          "Both run from the request"
        ]
      },
      {
        "question": "Can the court raise on its own the inadmissibility for a missing non-conciliation record?",
        "readings": [
          "Yes, as a form defect",
          "Only a party may raise it"
        ]
      },
      {
        "question": "Does the exclusion of family and labour cases from mediation in 994 also bar voluntary conciliation under 990?",
        "readings": [
          "No, 990 allows settlement at every stage",
          "Family conciliation is governed only by 439 and following"
        ]
      },
      {
        "question": "Does the mediator's period of three months run from the appointment order or from the mediator's acceptance?",
        "readings": [
          "From the order",
          "From acceptance and first meeting"
        ]
      }
    ],
