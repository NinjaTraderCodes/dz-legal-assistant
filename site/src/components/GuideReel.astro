---
// Folder 05, "Test it in 5 minutes": the demo's own guide, step by step. The five steps are tabs; each shows the demo
// as it looks at that step, the gold ring on what to press and the guide's card beside it, with the hint the card
// shows, verbatim (tests/guide-reel-shots.mjs; steps 3 to 5 from a real run of the demo's hosted model). The reel
// moves on by itself while it is on screen, each step long enough to read its hint (reel.ts), stops on hover or focus, has a pause button, and stands still
// with reduced motion. Without scripts the five steps are shown one under the other.
import type { ImageMetadata } from "astro";
import Folder from "./Folder.astro";
import Shot from "./Shot.astro";
import reel from "../content/guide-reel.json";
import { t, fmt, type Lang } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const shots = import.meta.glob<ImageMetadata>("../assets/shots/reel/*.webp", { eager: true, import: "default" });
const pick = (n: number, theme: "light" | "dark") => {
    const hit = Object.entries(shots).find(([path]) => path.endsWith(`/step${n}-${lang}-${theme}.webp`));
    if (!hit) throw new Error(`missing picture reel/step${n}-${lang}-${theme}.webp (node tests/guide-reel-shots.mjs, then scripts/reel-sources.mjs)`);
    return hit[1];
};
const run = reel[lang];
if (!run || run.steps.length !== 5) throw new Error(`guide-reel.json: the five steps in ${lang} (node tests/guide-reel-shots.mjs)`);
// Each step waits long enough to read its hint: 4 s, and a quarter of a second a word.
const steps = run.steps.map((step) => ({
    ...step, ai: step.step === 3 || step.step === 4, light: pick(step.step, "light"), dark: pick(step.step, "dark"),
    wait: Math.round((4 + 0.25 * step.hint.split(/\s+/).length) * 10) / 10,
    zoom: step.focus ? { x: step.focus.x, y: step.focus.y, scale: step.focus.zoom } : undefined,
}));
// The days the pictures were taken, one date or a range.
const days = steps.map((step) => new Date(step.date)).sort((a, b) => +a - +b);
const dates = new Intl.DateTimeFormat(lang === "ar" ? "ar-DZ-u-nu-latn" : "en-GB", { day: "numeric", month: "long", year: "numeric" });
const date = +days[0] === +days.at(-1)! ? dates.format(days[0]) : dates.formatRange(days[0], days.at(-1)!);
const no = (n: number) => String(n).padStart(2, "0");
---
<Folder tone="blue" no="05" tab={t(lang, "try.eyebrow")} id="try" labelledby="try-title">
    <div class="page reel" data-reel>
        <div class="intro">
            <h2 id="try-title" class="h1">{t(lang, "try.title")}</h2>
            <p class="lead">{t(lang, "reel.lead")}</p>
        </div>
        <div class="stage">
            <div class="step-tabs" role="tablist" aria-label={t(lang, "try.title")}>
                {steps.map((step, i) => (
                    <button type="button" role="tab" class="step-tab" style={`--reel-wait: ${step.wait}s`} id={`reel-tab-${step.step}`} aria-controls={`reel-panel-${step.step}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} data-reel-tab>
                        <span class="num">{no(step.step)}</span>
                        <span class="name">{step.title}{step.ai && <span class="tag">AI</span>}</span>
                        <span class="bar" aria-hidden="true"></span>
                    </button>
                ))}
            </div>
            <div class="screens">
                {steps.map((step, i) => (
                    <div class:list={["screen", i === 0 && "current"]} role="tabpanel" id={`reel-panel-${step.step}`} aria-labelledby={`reel-tab-${step.step}`} data-reel-panel>
                        <p class="screen-title"><span class="num">{no(step.step)}</span> {step.title}</p>
                        <Shot lang={lang} light={step.light} dark={step.dark} alt={fmt(t(lang, "reel.alt"), step.step, step.title)} width={720} zoom={step.zoom} large />
                        <p class="hint">{step.hint}</p>
                    </div>
                ))}
            </div>
        </div>
        <div class="foot">
            <button type="button" class="btn toggle" data-reel-toggle data-state="paused" hidden><span class="on">{t(lang, "reel.pause")}</span><span class="off">{t(lang, "reel.play")}</span></button>
            <p class="small note">{fmt(t(lang, "reel.note"), date)}</p>
        </div>
        <div class="actions">
            <a class="btn btn-primary" href={`/app?lang=${lang}&guide=1`}>{t(lang, "try.cta")}</a>
            <a class="btn" href={`/${lang}/try/`}>{t(lang, "try.full")}</a>
        </div>
    </div>
</Folder>

<style>
    .reel { display: grid; gap: 24px; }
    .intro { display: grid; gap: 12px; max-width: 760px; }
    .stage { display: grid; grid-template-columns: minmax(220px, 300px) minmax(0, 720px); gap: 28px; align-items: start; }
    /* The steps: a register of five, the current one in ink, a thin line filling while the reel waits on it. */
    .step-tabs { display: grid; gap: 4px; border-top: 2px solid var(--w-text); }
    .step-tab { position: relative; display: grid; grid-template-columns: 2.2em minmax(0, 1fr); gap: 4px 8px; align-items: baseline; padding: 14px 4px 16px; border: 0; border-bottom: 1px solid var(--w-rule);
        background: none; color: var(--w-muted); font: inherit; text-align: start; cursor: pointer; }
    .step-tab .num { font-variant-numeric: tabular-nums; font-size: 0.9rem; }
    .step-tab .name { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; font-weight: 600; line-height: 1.35; }
    .step-tab[aria-selected="true"] { color: var(--w-text); }
    .step-tab[aria-selected="true"] .num { color: var(--w-ink); font-weight: 700; }
    .step-tab:hover { color: var(--w-text); }
    .step-tab:focus-visible { outline: 3px solid var(--w-focus); outline-offset: -3px; }
    .bar { position: absolute; inset-inline: 0; bottom: -1px; height: 2px; transform: scaleX(0); transform-origin: left; background: var(--w-ink); }
    :global([dir="rtl"]) .bar { transform-origin: right; }
    .step-tab[aria-selected="true"] .bar { transform: scaleX(1); }
    :global(.reel.live.playing.inview) .step-tab[aria-selected="true"] .bar { animation: reel-fill var(--reel-wait, 7s) linear forwards; }
    /* Held while the pointer is over the reel or the keyboard is in it (a mouse click on Play is not a reason to hold). */
    :global(.reel.live.playing.inview:is(:hover, :has(:focus-visible))) .step-tab[aria-selected="true"] .bar { animation-play-state: paused; }
    @keyframes reel-fill { from { transform: scaleX(0); } to { transform: scaleX(1); } }
    /* The screens: without scripts, one under the other; with them, stacked in one place, the tallest setting the height. */
    .screens { display: grid; gap: 32px; }
    :global(.reel.live) .screens { gap: 0; }
    :global(.reel.live) .screen { grid-area: 1 / 1; visibility: hidden; }
    :global(.reel.live) .screen.current { visibility: visible; }
    .screen { display: grid; gap: 12px; align-content: start; }
    .screen :global(.shot) { max-width: 100%; }
    .screen-title { display: none; font-weight: 600; }
    :global(.reel:not(.live)) .screen-title { display: block; }
    .hint { max-width: 64ch; }
    .foot { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; }
    .toggle { min-height: 36px; padding-inline: 14px; }
    /* The button says what it will do: Pause while the reel plays, Play while it waits. */
    .toggle[data-state="paused"] .on, .toggle[data-state="playing"] .off { display: none; }
    .note { color: var(--w-muted); }
    .actions { display: flex; flex-wrap: wrap; gap: 12px; }
    /* A phone: the steps become a row of numbers over the screen, whose own title says which step it is. */
    @media (max-width: 899px) {
        .stage { grid-template-columns: minmax(0, 1fr); gap: 16px; }
        .step-tabs { grid-template-columns: repeat(5, minmax(0, 1fr)); border-top: 0; gap: 6px; }
        .step-tab { grid-template-columns: 1fr; justify-items: center; padding: 10px 0 12px; }
        .step-tab .name { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
        .screen-title, :global(.reel.live) .screen-title { display: block; }
    }
    @media (prefers-reduced-motion: reduce) { .bar { transition: none; } }
</style>
