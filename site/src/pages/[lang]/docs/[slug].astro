---
// One of the six documents, rendered with the site's own layout: a table of contents from its headings, its code
// blocks and tables styled, its links adapted (src/content/docs-pages.ts). The documents are written in English;
// the Arabic page shows the same text with a line saying so.
import { getCollection, render } from "astro:content";
import Base from "../../../layouts/Base.astro";
import PageHead from "../../../components/PageHead.astro";
import { langs, t, type Lang } from "../../../i18n";

export async function getStaticPaths() {
    const docs = await getCollection("docs");
    return langs.flatMap((lang) => docs.map((entry) => ({ params: { lang, slug: entry.id }, props: { entry } })));
}
const lang = Astro.params.lang as Lang;
const { entry } = Astro.props;
const { Content, headings, remarkPluginFrontmatter: meta } = await render(entry);
const name = entry.id.toUpperCase();
const title = (meta?.title as string | undefined) ?? headings.find((h) => h.depth === 1)?.text ?? name;
// The description is the document's first paragraph, as plain text.
const firstParagraph = (entry.body ?? "").split(/\r?\n\s*\r?\n/).map((p) => p.trim()).find((p) => p && !/^[#`|<>-]/.test(p)) ?? "";
const plain = firstParagraph.replace(/\[([^\]]+)\]\([^)]*\)/g, "$1").replace(/[`*_]/g, "").replace(/\s+/g, " ").slice(0, 160);
const description = lang === "ar" ? `${t(lang, "docs.englishOnly")} ${plain}` : plain;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
<Base lang={lang} title={title} description={description} path={`/docs/${entry.id}/`} og="docs">
    <PageHead eyebrow={t(lang, "about.docs.title")} title={title}>
        {lang === "ar" && <p class="lead">{t(lang, "docs.englishOnly")}</p>}
        <p class="source caption">{t(lang, "source.label")} <span dir="ltr">docs/{name}.md</span></p>
    </PageHead>
    <div class="section page layout" lang="en" dir="ltr">
        <nav class="toc" aria-labelledby="toc-title">
            <p id="toc-title" class="caption">{t("en", "docs.toc")}</p>
            <ol>{toc.map((h) => <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </nav>
        <article class="body"><Content /></article>
    </div>
</Base>

<style>
    .layout { display: grid; grid-template-columns: minmax(0, 1fr) 240px; gap: 40px; align-items: start; padding-top: 0; }
    .toc { position: sticky; top: 88px; order: 2; font-size: 0.9rem; }
    .toc ol { margin: 8px 0 0; padding: 0; list-style: none; display: grid; gap: 6px; }
    .toc .d3 { padding-inline-start: 14px; }
    .toc a { color: var(--muted-aa); }
    .toc a:hover { color: var(--text); }
    /* The documents are English prose: their own measure and rhythm, whatever the page's language. */
    .body { display: grid; gap: 14px; font-size: 17px; line-height: 1.6; }
    .body :global(h2) { margin-top: 28px; font-size: 1.5rem; line-height: 1.3; scroll-margin-top: 96px; }
    .body :global(h3) { margin-top: 14px; font-size: 1.15rem; scroll-margin-top: 96px; }
    .body :global(h4) { margin-top: 8px; font-size: 1rem; }
    .body :global(p), .body :global(li) { max-width: var(--measure); }
    .body :global(ul), .body :global(ol) { padding-inline-start: 24px; display: grid; gap: 6px; }
    .body :global(img) { max-width: 100%; height: auto; border: 1px solid var(--hairline); border-radius: 8px; }
    .body :global(pre) { margin: 0; padding: 14px 16px; border: 1px solid var(--hairline); border-radius: var(--radius-control); font: 0.85rem/1.6 ui-monospace, "Cascadia Mono", Consolas, monospace; overflow-x: auto; }
    .body :global(pre:not(.astro-code)) { background: var(--surface-alt); }
    .body :global(pre:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
    .body :global(:not(pre) > code) { font: 0.9em/1.4 ui-monospace, "Cascadia Mono", Consolas, monospace; padding: 1px 6px; border: 1px solid var(--hairline); border-radius: 4px; background: var(--surface-alt); overflow-wrap: anywhere; }
    .body :global(.table-wrap) { overflow-x: auto; }
    .body :global(table) { border-collapse: collapse; font-size: 0.92rem; }
    .body :global(th), .body :global(td) { text-align: left; vertical-align: top; padding: 8px 10px; border-top: 1px solid var(--hairline); }
    .body :global(th) { font-weight: 600; }
    .body :global(blockquote) { margin: 0; padding: 10px 14px; border-inline-start: 3px solid var(--gold); background: var(--surface-alt); border-radius: 6px; }
    .body :global(hr) { border: 0; border-top: 1px solid var(--hairline); margin: 12px 0; }
    .body :global(a) { overflow-wrap: anywhere; }
    @media (max-width: 899px) { .layout { grid-template-columns: 1fr; } .toc { position: static; order: 0; } }
</style>
