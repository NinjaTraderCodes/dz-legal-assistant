---
// How the AI is kept in its place, as a drafting log: the four stages in order, each entry numbered, tagged AI or code,
// with its picture from the desktop app's own capture clipped beside it (the drafting in progress from the live
// recording); the measured results typed as a report with their mode and source; and the line that matters to a lawyer.
import type { ImageMetadata } from "astro";
import Icon from "./Icon.astro";
import Shot from "./Shot.astro";
import Folder from "./Folder.astro";
import Clip from "./Clip.astro";
import AppPiece from "./AppPiece.astro";
import desktopRun from "../content/desktop-run.json";
import { groundsTitle, splitGrounds } from "../content/steps";
import Source from "./Source.astro";
import { t, type Lang } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const frames = import.meta.glob<ImageMetadata>("../assets/shots/desktop/*.png", { eager: true, import: "default" });
const frame = (name: string) => {
    const hit = Object.entries(frames).find(([path]) => path.endsWith(`/${name}.png`));
    if (!hit) throw new Error(`missing picture ${name}.png in src/assets/shots (node scripts/crops.mjs)`);
    return hit[1];
};
// A crop of the desktop app rendered at scale 2 (src/content/desktop-run.json says which run), in the page's language,
// light and dark.
const desktop = (name: string) => ({ light: frame(`desktop/${name}-${lang}-light`), dark: frame(`desktop/${name}-${lang}-dark`), note: t(lang, "shot.desktop") });
// The activity panel shows the model's words as they arrive: the opening of its first application, from the same run.
const firstApplication = desktopRun.paragraphs.flatMap(splitGrounds).find((line) => line.by === "ai")?.text ?? "";
const live = firstApplication.split(/\s+/).slice(0, 14).join(" ");

// Stage 2 is the code's own step: no model. Stage 4 is the one in progress on the panel, as drafting is the last.
const stages = [1, 2, 3, 4].map((n) => ({
    n,
    title: t(lang, `ai.stage${n}.title`),
    body: t(lang, `ai.stage${n}.body`),
    caption: t(lang, `ai.shot.stage${n}`),
    model: n !== 2,
    // Stages 1 to 3 and the drafted grounds are crops of the desktop capture; the drafting in progress is drawn.
    shot: desktop(n === 1 ? "reading" : n === 2 ? "proposed" : n === 3 ? "confirm" : "paper"),
}));
// The measured results, as the hidden-set report gives them (docs/HIDDEN-SET.md, the sentence ai.measure says the same).
const figures = [{ value: "94", of: "85 / 90", label: t(lang, "ai.fig.1") }, { value: "67", of: "60 / 90", label: t(lang, "ai.fig.2") }, { value: "36", of: "32 / 90", label: t(lang, "ai.fig.3") }];
const percent = lang === "ar" ? "٪" : "%";
---
<Folder tone="kraft" no="04" tab={t(lang, "tab.ai")} labelledby="ai-title">
    <div class="page ai">
        <div class="intro">
            <h2 id="ai-title" class="h1">{t(lang, "ai.title")}</h2>
            <p class="lead">{t(lang, "ai.lead")}</p>
        </div>
        <ol class="log">
            {stages.map((stage) => (
                <li class:list={["entry", stage.n === 4 && "last"]}>
                    <span class="reg-no">{String(stage.n).padStart(2, "0")}</span>
                    <div class="words">
                        <h3 class="h3">{stage.title} {stage.model ? <span class="tag"><Icon name="sparkle" size={12} /> AI</span> : <span class="tag by-code"><Icon name="checkmark_circle" size={12} /> {t(lang, "ai.code")}</span>}</h3>
                        <p>{stage.body}</p>
                        {stage.n === 4 && <p class="time">{t(lang, "ai.stage4.time")}</p>}
                        {stage.n === 4 && <AppPiece lang={lang} kind="activity" section={groundsTitle[lang]} live={live + " …"} caption={t(lang, "ai.shot.activity")} />}
                    </div>
                    <div class="picture">
                        <Shot lang={lang} light={stage.shot.light} dark={stage.shot.dark} alt={stage.caption} caption={stage.caption} note={stage.shot.note} width={stage.n === 4 ? 520 : 400} quality={stage.n === 4 ? 50 : 72} />
                    </div>
                </li>
            ))}
        </ol>
        <Source lang={lang} files={["README.md"]} />
        <div class="sheet results">
            <Clip />
            <h3 class="results-title">{t(lang, "ai.fig.title")}</h3>
            <dl class="figures">
                {figures.map((f) => (
                    <div class="figure">
                        <dt>{f.label}</dt>
                        <dd><span class="value" dir="ltr">{f.value}{percent}</span> <span class="of" dir="ltr">{f.of}</span></dd>
                    </div>
                ))}
            </dl>
            <p class="caption">{t(lang, "ai.measureNote")}</p>
            <Source lang={lang} files={["docs/HIDDEN-SET.md"]} />
        </div>
        <p class="sign">{t(lang, "ai.sign")}</p>
    </div>
</Folder>

<style>
    .ai { display: grid; gap: 36px; }
    .intro { display: grid; gap: 16px; max-width: 820px; }
    /* The log: one entry per stage under a heavy rule, the register number, the words, and the picture clipped beside. */
    .log { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--w-text); }
    .entry { display: grid; grid-template-columns: 3em minmax(0, 1fr) minmax(0, 400px); gap: 12px 32px; align-items: start; padding-block: 28px; border-bottom: 1px solid var(--w-rule); }
    .entry .reg-no { padding-top: 4px; font-size: 0.9rem; }
    .entry.last { grid-template-columns: 3em minmax(0, 1fr) minmax(0, 520px); }
    .words { display: grid; gap: 10px; align-content: start; }
    .entry h3 { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
    .entry p { font-size: 0.97rem; }
    .tag.by-code { color: var(--w-text); }
    .time { font-weight: 600; }
    .picture { display: grid; justify-items: end; }
    /* The results, typed on a sheet: each figure large, its count and its exact mode beside it. */
    .results { display: grid; gap: 16px; padding: 30px 30px 24px; max-width: 900px; }
    .results-title { font-size: 0.9rem; font-weight: 600; color: var(--w-sheet-muted); padding-bottom: 10px; border-bottom: 2px solid var(--w-sheet-text); }
    .figures { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px 28px; margin: 0; }
    .figure { display: flex; flex-direction: column-reverse; gap: 6px; justify-content: flex-end; }
    .figure dt { font-size: 0.9rem; line-height: 1.5; }
    .figure dd { margin: 0; display: flex; align-items: baseline; gap: 10px; }
    .value { font-family: var(--w-display); font-weight: 700; font-size: clamp(2.6rem, 2rem + 2vw, 3.6rem); line-height: 1; font-variant-numeric: tabular-nums; }
    .of { color: var(--w-sheet-muted); font-size: 0.9rem; font-variant-numeric: tabular-nums; }
    .sign { font-family: var(--w-display); font-weight: 600; font-size: clamp(1.6rem, 1.2rem + 1.2vw, 2.3rem); line-height: 1.3; max-width: none; }
    @media (max-width: 1099px) { .entry, .entry.last { grid-template-columns: 3em minmax(0, 1fr); } .picture { grid-column: 2; justify-items: start; } }
    @media (max-width: 699px) { .figures { grid-template-columns: 1fr; } .entry, .entry.last { grid-template-columns: 2.2em minmax(0, 1fr); gap: 12px 12px; } }
</style>
