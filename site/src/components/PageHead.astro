---
// The opening of a secondary page: the title, one lead sentence, and whatever the page adds. The words that used to
// sit above the title are the folder's tab now (Base.astro, folder).
interface Props { title: string; lead?: string }
const { title, lead } = Astro.props;
---
<section class="section page head">
    <h1 class="h1">{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
</section>

<style>
    .head { display: grid; gap: 14px; padding-top: clamp(40px, 6vw, 72px); padding-bottom: clamp(32px, 4vw, 48px); }
    .head .lead { max-width: 760px; }
</style>
