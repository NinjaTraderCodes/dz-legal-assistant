<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:DzLegal.App.Views" x:Class="DzLegal.App.Views.FieldHelpView" x:Name="HelpRoot">
  <StackPanel Spacing="{StaticResource Space2}">
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Text="{Binding Label, ElementName=HelpRoot}" TextWrapping="Wrap" FontWeight="Medium" VerticalAlignment="Center"/>
      <Button Name="HelpButton" Grid.Column="1" Classes="subtle" Content="ⓘ"
              AutomationProperties.Name="{Binding Label, ElementName=HelpRoot}" AutomationProperties.HelpText="{Binding Text, ElementName=HelpRoot}"
              IsVisible="{Binding Text, ElementName=HelpRoot, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
    </Grid>
    <Border Name="HelpDisclosure" IsVisible="False" Classes="notice" Background="{DynamicResource AccentSoftBrush}" CornerRadius="{StaticResource ControlRadius}">
      <TextBlock Text="{Binding Text, ElementName=HelpRoot}" TextWrapping="Wrap" Classes="secondary"/>
    </Border>
  </StackPanel>
</UserControl>
