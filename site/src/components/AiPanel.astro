---
// The proof folder, in three blocks: who writes what (the four stages in order, each one line, tagged AI or code,
// with the one picture beside them, the model's reading of the facts from the desktop app's capture); the measured
// results on one slim sheet with their source; and what the software guarantees, one line each. The drafted paper is
// the story's (folder 03) and the review before export is the guide's (folder 05), so neither is shown again here.
import type { ImageMetadata } from "astro";
import Icon from "./Icon.astro";
import Shot from "./Shot.astro";
import Folder from "./Folder.astro";
import Clip from "./Clip.astro";
import Source from "./Source.astro";
import { s, t, fmt, type Lang } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const frames = import.meta.glob<ImageMetadata>("../assets/shots/desktop/*.png", { eager: true, import: "default" });
const frame = (name: string) => {
    const hit = Object.entries(frames).find(([path]) => path.endsWith(`/${name}.png`));
    if (!hit) throw new Error(`missing picture ${name}.png in src/assets/shots (node scripts/crops.mjs)`);
    return hit[1];
};
// The model's reading, cropped from the desktop app rendered at scale 2 (src/content/desktop-run.json says which run).
const reading = { light: frame(`desktop/reading-${lang}-light`), dark: frame(`desktop/reading-${lang}-dark`) };
// Stage 2 is the code's own step; the others are the model's.
const rows = [1, 2, 3, 4].map((n) => ({ n, title: t(lang, `ai.stage${n}.title`), line: t(lang, `ai.row${n}`), model: n !== 2 }));
// The measured results, as the hidden-set report gives them (docs/HIDDEN-SET.md): the two local models on the same second
// set, then the online model on the first.
const figures = [{ value: "64", of: "58 / 90", label: t(lang, "ai.fig.1") }, { value: "43", of: "39 / 90", label: t(lang, "ai.fig.2") }, { value: "71", of: "64 / 90", label: t(lang, "ai.fig.3") }];
const percent = lang === "ar" ? "٪" : "%";
const guarantees = [
    { title: t(lang, "proofs.texts.title"), line: fmt(s(lang, "AboutSources"), "1,361", "6") },
    { title: t(lang, "proofs.offline.title"), line: t(lang, "proofs.offline.short") },
    { title: t(lang, "proofs.review.title"), line: t(lang, "proofs.review.short") },
    { title: t(lang, "proofs.grounds.title"), line: t(lang, "proofs.grounds.short") },
];
const no = (n: number) => String(n).padStart(2, "0");
---
<Folder tone="kraft" no="04" tab={t(lang, "tab.ai")} labelledby="ai-title">
    <div class="page ai">
        <div class="intro">
            <h2 id="ai-title" class="h1">{t(lang, "ai.title")}</h2>
            <p class="lead">{t(lang, "ai.lead")}</p>
        </div>
        <div class="who">
            <div>
                <h3 class="label">{t(lang, "ai.who")}</h3>
                <ol class="rows">
                    {rows.map((row) => (
                        <li>
                            <span class="reg-no">{no(row.n)}</span>
                            <span class="what"><strong>{row.title}</strong> {row.model ? <span class="tag">AI</span> : <span class="tag by-code"><Icon name="checkmark_circle" size={12} /> {t(lang, "ai.code")}</span>}</span>
                            <span class="line">{row.line}</span>
                        </li>
                    ))}
                </ol>
            </div>
            <Shot lang={lang} light={reading.light} dark={reading.dark} alt={t(lang, "ai.shot.stage1")} caption={t(lang, "ai.pic")} width={440} quality={72} class="picture" />
        </div>
        <div class="sheet results">
            <Clip />
            <p class="new"><span class="tag">{t(lang, "ai.new")}</span></p>
            <h3 class="results-title">{t(lang, "ai.fig.title")}</h3>
            <dl class="figures">
                {figures.map((f) => (
                    <div class="figure">
                        <dt>{f.label}</dt>
                        <dd><span class="value" dir="ltr">{f.value}{percent}</span> <span class="of" dir="ltr">{f.of}</span></dd>
                    </div>
                ))}
            </dl>
            <p class="caption">{t(lang, "ai.measureNote")}</p>
            <Source lang={lang} files={["docs/HIDDEN-SET.md"]} />
        </div>
        <div class="guarantees">
            <h3 id="proofs-title" class="label">{t(lang, "proofs.title")}</h3>
            <ol>
                {guarantees.map((g) => (
                    <li><p><strong>{g.title}</strong> {g.line}</p></li>
                ))}
            </ol>
            <Source lang={lang} files={["README.md", "docs/PRODUCT-DETAILS.md", "docs/OFFLINE.md", "data/law/codes"]} />
        </div>
    </div>
</Folder>

<style>
    .ai { display: grid; gap: 40px; }
    .intro { display: grid; gap: 14px; max-width: 760px; }
    .label { font-size: 0.95rem; font-weight: 600; padding-bottom: 10px; border-bottom: 2px solid var(--w-text); }
    /* Who writes what: a register of four lines, the tag and the one-line job beside each stage; the picture beside. */
    .who { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 440px); gap: 24px 48px; align-items: start; }
    .rows { list-style: none; margin: 0; padding: 0; }
    .rows li { display: grid; grid-template-columns: 2.4em minmax(0, 18em) minmax(0, 1fr); gap: 4px 16px; align-items: baseline; padding-block: 14px; border-bottom: 1px solid var(--w-rule); }
    .what { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; }
    .tag.by-code { color: var(--w-text); }
    .line { color: var(--w-muted); }
    /* The results: three figures in one line on a slim sheet, each with its count. */
    .results { display: grid; gap: 14px; padding: 24px 28px 20px; }
    .results-title { font-size: 0.9rem; font-weight: 600; color: var(--w-sheet-muted); padding-bottom: 10px; border-bottom: 2px solid var(--w-sheet-text); }
    /* What changed since the submission, said openly above the figures; it may wrap on a phone. */
    .new { margin: 0; padding-inline-end: 44px; }
    .new .tag { color: var(--w-sheet-text); white-space: normal; }
    .figures { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px 28px; margin: 0; }
    .figure { display: flex; flex-direction: column-reverse; gap: 4px; justify-content: flex-end; }
    .figure dt { font-size: 0.9rem; line-height: 1.5; }
    .figure dd { margin: 0; display: flex; align-items: baseline; gap: 10px; }
    .value { font-family: var(--w-display); font-weight: 700; font-size: clamp(2.2rem, 1.8rem + 1.6vw, 3rem); line-height: 1; font-variant-numeric: tabular-nums; }
    .of { color: var(--w-sheet-muted); font-size: 0.9rem; font-variant-numeric: tabular-nums; }
    /* The guarantees: four lines, two by two on a wide screen; not numbered, as they are not a sequence. */
    .guarantees { display: grid; gap: 4px; }
    .guarantees ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 40px; }
    .guarantees li { padding-block: 14px; border-bottom: 1px solid var(--w-rule); }
    .guarantees p { color: var(--w-muted); }
    .guarantees strong { color: var(--w-text); margin-inline-end: 4px; }
    @media (max-width: 1099px) {
        .who { grid-template-columns: minmax(0, 1fr); }
        .rows li { grid-template-columns: 2.4em minmax(0, 1fr); }
        .line { grid-column: 2; }
    }
    @media (max-width: 699px) {
        .figures, .guarantees ol { grid-template-columns: 1fr; }
        .rows li { grid-template-columns: 2em minmax(0, 1fr); gap: 4px 10px; }
    }
</style>
