<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DzLegal.App.ViewModels"
        x:Class="DzLegal.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding L[AppTitle]}"
        Width="1440" Height="900" MinWidth="1000" MinHeight="600"
        FontFamily="{StaticResource UiFont}"
        FlowDirection="{Binding FlowDirection}">

  <Window.Styles>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#6B6B6B" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#DDD8CC" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="Margin" Value="6" />
    </Style>
    <Style Selector="Border.finding">
      <Setter Property="BorderThickness" Value="4,0,0,0" />
      <Setter Property="BorderBrush" Value="#B8C4B0" />
      <Setter Property="Background" Value="#F6F7F4" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector="Border.finding.missing">
      <Setter Property="BorderBrush" Value="#B3261E" />
      <Setter Property="Background" Value="#FCEEEE" />
    </Style>
    <Style Selector="Border.finding.warning">
      <Setter Property="BorderBrush" Value="#B26A00" />
      <Setter Property="Background" Value="#FFF6E5" />
    </Style>
    <Style Selector="Border.finding.na">
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="Border.summary">
      <Setter Property="Background" Value="#FCEEEE" />
      <Setter Property="BorderBrush" Value="#B3261E" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="Border.summary.ok">
      <Setter Property="Background" Value="#EDF7EE" />
      <Setter Property="BorderBrush" Value="#2E7D32" />
    </Style>
    <Style Selector="TextBox.document">
      <Setter Property="FontFamily" Value="{StaticResource DocumentFont}" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="FlowDirection" Value="RightToLeft" />
      <Setter Property="TextAlignment" Value="Start" />
    </Style>
    <Style Selector="TextBlock.review">
      <Setter Property="Foreground" Value="#8A4B00" />
      <Setter Property="Background" Value="#FFF6E5" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.toolbar">
      <Setter Property="Background" Value="#3E655B" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.toolbar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#4F7A6E" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <!-- Case inputs are Arabic document content: always right-to-left, whatever the UI language. -->
    <Style Selector="TextBox.input">
      <Setter Property="FlowDirection" Value="RightToLeft" />
      <Setter Property="FontFamily" Value="{StaticResource DocumentFont}" />
    </Style>
    <Style Selector="TextBox.document:readonly">
      <Setter Property="Background" Value="#F7F5EF" />
    </Style>
  </Window.Styles>

  <DockPanel Background="#F1EEE6">
    <!-- Title bar -->
    <Border DockPanel.Dock="Top" Background="#1F3A34" Padding="12,8">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <TextBlock Classes="h1" Foreground="White" Text="{Binding L[AppTitle]}" />
          <TextBlock Foreground="#CFE0D8" VerticalAlignment="Center" Text="{Binding DocumentTypeName}" />
        </StackPanel>
        <Button Grid.Column="1" Name="LanguageButton" Classes="toolbar" Command="{Binding SwitchLanguageCommand}" Content="{Binding L[SwitchLanguage]}" />
      </Grid>
    </Border>

    <!-- Command bar -->
    <Border DockPanel.Dock="Top" Background="#2B4C44" Padding="12,6">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Classes="toolbar" Command="{Binding NewCommand}" Content="{Binding L[New]}" />
          <Button Classes="toolbar" Command="{Binding OpenCommand}" Content="{Binding L[Open]}" />
          <Button Classes="toolbar" Command="{Binding SaveCommand}" Content="{Binding L[Save]}" />
          <Button Classes="toolbar" Command="{Binding CopyTextCommand}" Content="{Binding L[CopyText]}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
          <TextBlock Foreground="White" VerticalAlignment="Center" Text="{Binding L[ProviderLabel]}" />
          <ComboBox MinWidth="240" ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ProviderOption">
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Name="GenerateButton" Classes="accent" Command="{Binding GenerateCommand}"
                  Content="{Binding L[Generate]}" ToolTip.Tip="{Binding L[GenerateHint]}" />
          <Button Classes="toolbar" Command="{Binding GenerateCancelCommand}" Content="{Binding L[Cancel]}"
                  IsVisible="{Binding GenerateCommand.IsRunning}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Draft banner: generated content is never final -->
    <Border DockPanel.Dock="Top" Background="#FFF1C2" BorderBrush="#E0B94A" BorderThickness="0,0,0,1" Padding="12,6">
      <TextBlock Name="DraftBanner" FontWeight="Bold" Foreground="#5C4300" TextWrapping="Wrap" Text="{Binding L[DraftBanner]}" />
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Background="#E6E1D5" Padding="12,4">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Name="StatusText" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis"
                   Foreground="{Binding IsError, Converter={x:Static vm:Converters.ErrorBrush}}" />
        <TextBlock Grid.Column="1" Foreground="#2E7D32" Text="{Binding L[OfflineStatus]}" />
      </Grid>
    </Border>

    <Grid ColumnDefinitions="380,4,*,4,380">
      <!-- Case form -->
      <Border Classes="panel">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="h2" Text="{Binding L[CaseForm]}" />
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding FieldGroups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FieldGroupViewModel">
                  <StackPanel Margin="0,0,8,14" Spacing="4">
                    <TextBlock FontWeight="Bold" Foreground="#1F3A34" Text="{Binding Label}" />
                    <ItemsControl ItemsSource="{Binding Fields}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FieldViewModel">
                          <StackPanel Margin="0,2" Spacing="2" IsVisible="{Binding IsVisible}">
                            <TextBlock Classes="muted" Text="{Binding Label}" IsVisible="{Binding !IsBoolean}" />
                            <TextBox Classes="input" Text="{Binding Value}" PlaceholderText="{Binding Hint}" IsVisible="{Binding IsSingleLine}" />
                            <TextBox Classes="input" Text="{Binding Value}" PlaceholderText="{Binding Hint}" IsVisible="{Binding IsMultiline}"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="220" />
                            <CheckBox IsChecked="{Binding BoolValue}" Content="{Binding Label}" IsVisible="{Binding IsBoolean}" />
                            <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" IsVisible="{Binding IsChoice}"
                                      MinWidth="160" PlaceholderText="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).L[ChooseOption]}">
                              <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ChoiceOptionViewModel">
                                  <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />

      <!-- Draft editor -->
      <Border Grid.Column="2" Classes="panel">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="h2" Text="{Binding L[Document]}" />
          <Expander DockPanel.Dock="Bottom" Header="{Binding L[Evaluation]}" HorizontalAlignment="Stretch" Margin="0,8,0,0">
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
              <TextBlock VerticalAlignment="Center" Text="{Binding L[Verdict]}" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding Verdicts}" SelectedItem="{Binding SelectedVerdict}" MinWidth="220">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:VerdictOption">
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="{Binding L[MinutesSaved]}" />
              <TextBox Grid.Row="1" Grid.Column="1" Width="120" HorizontalAlignment="Left" Text="{Binding MinutesSaved}" />
              <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="{Binding L[Comments]}" />
              <TextBox Grid.Row="2" Grid.Column="1" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" Text="{Binding EvaluationComments}" />
              <Button Grid.Row="3" Grid.Column="1" Command="{Binding SaveEvaluationCommand}" Content="{Binding L[SaveEvaluation]}" />
            </Grid>
          </Expander>
          <ScrollViewer>
            <ItemsControl Name="SectionsList" ItemsSource="{Binding Sections}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SectionViewModel">
                  <StackPanel Margin="0,0,8,10" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock FontWeight="Bold" Text="{Binding Title}" />
                      <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding Hint}" />
                    </StackPanel>
                    <TextBox Classes="document" Text="{Binding Text}" IsReadOnly="{Binding IsReadOnly}"
                             PlaceholderText="{Binding Watermark}" MinHeight="40" />
                    <TextBlock Classes="review" Text="{Binding ReviewText}" IsVisible="{Binding HasReview}" TextWrapping="Wrap" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="3" ResizeDirection="Columns" Background="Transparent" />

      <!-- Compliance report -->
      <Border Grid.Column="4" Classes="panel">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="h2" Text="{Binding L[Compliance]}" />
          <Border DockPanel.Dock="Top" Classes="summary" Classes.ok="{Binding IsAdmissible}">
            <StackPanel Spacing="2">
              <TextBlock Name="SummaryText" FontWeight="Bold" TextWrapping="Wrap" Text="{Binding Summary}" />
              <TextBlock TextWrapping="Wrap" Text="{Binding WarningSummary}" IsVisible="{Binding WarningSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding L[SummaryDisclaimer]}" />
            </StackPanel>
          </Border>
          <ScrollViewer>
            <ItemsControl Name="FindingsList" ItemsSource="{Binding Findings}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FindingViewModel">
                  <Border Classes="finding" Classes.missing="{Binding IsMissingMandatory}"
                          Classes.warning="{Binding IsMissingWarning}" Classes.na="{Binding IsNotApplicable}">
                    <StackPanel Spacing="2">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock FontWeight="Bold" TextWrapping="Wrap" Text="{Binding Label}" />
                        <TextBlock Grid.Column="1" Margin="8,0,0,0" FontWeight="Bold" Text="{Binding StatusText}" />
                      </Grid>
                      <TextBlock Classes="muted" Text="{Binding Article}" />
                      <TextBlock TextWrapping="Wrap" Text="{Binding Message}" IsVisible="{Binding HasMessage}" />
                      <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding MissingPartsText}" IsVisible="{Binding HasMissingParts}" />
                      <TextBlock Classes="muted" FontStyle="Italic" Foreground="#8A5A00"
                                 Text="{Binding UnverifiedText}"
                                 IsVisible="{Binding IsUnverified}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
