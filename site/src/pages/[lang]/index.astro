---
// The home page, in Arabic (/ar/) and English (/en/), as one case file of seven folders: the welcome, the problem,
// the nine steps on paper (closing on the two actions), the proof (the AI in its place, the measured results and the
// guarantees), the five-minute test, the team, and the two ways to use the product, so the file ends on the action.
import Base from "../../layouts/Base.astro";
import Hero from "../../components/Hero.astro";
import TryGuide from "../../components/TryGuide.astro";
import Problem from "../../components/Problem.astro";
import StepStory from "../../components/StepStory.astro";
import AiPanel from "../../components/AiPanel.astro";
import DemoDownload from "../../components/DemoDownload.astro";
import Team from "../../components/Team.astro";
import { getImage } from "astro:assets";
import laptop from "../../assets/hero/laptop.png";
import { laptopImage } from "../../components/Hero.astro";
import { langs, s, t, type Lang } from "../../i18n";

export function getStaticPaths() {
    return langs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
// The laptop is the largest thing on the first screen: the head preloads the same AVIF set the hero renders.
const hero = await getImage({ src: laptop, widths: laptopImage.widths, format: "avif", quality: laptopImage.quality });
// Its href is the largest rendition of the set, so the preload adds no file of its own.
const preloadImage = { src: hero.srcSet.values.at(-1)?.url ?? hero.src, srcSet: hero.srcSet.attribute, sizes: laptopImage.sizes, type: "image/avif" };
---
<Base lang={lang} title={s(lang, "AppTitle")} description={t(lang, "meta.home.description")} path="/" preloadImage={preloadImage}>
    <Hero lang={lang} />
    <Problem lang={lang} />
    <StepStory lang={lang} />
    <AiPanel lang={lang} />
    <TryGuide lang={lang} compact />
    <Team lang={lang} />
    <DemoDownload lang={lang} />
</Base>
<script>
    import "../../scripts/home";
</script>
