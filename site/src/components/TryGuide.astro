---
// "Test it in 5 minutes": the five steps of the live demo, with what to click (the demo's own button labels, from
// its string tables), what should happen, how long it takes, and why it matters for a lawyer, each step a numbered
// sheet, on the /try/ page (a blue folder of its own; the home's folder 05 is the guide reel, GuideReel.astro), where each step shows what the demo looks like at that
// point (tests/guide-shots.mjs: the steps with AI output come from real model runs, never from the stand-in). The
// demo's guide walks through the same steps, and the button here opens the demo with it.
import type { ImageMetadata } from "astro";
import Icon from "./Icon.astro";
import Folder from "./Folder.astro";
import Shot from "./Shot.astro";
import AppPiece from "./AppPiece.astro";
import { groundsTitle } from "../content/steps";
import Source from "./Source.astro";
import { s, t, fmt, type Lang } from "../i18n";

interface Props { lang: Lang; heading?: "h1" | "h2" }
const { lang, heading = "h2" } = Astro.props;
const groundsHeading = groundsTitle[lang];
const q = (key: string) => (lang === "ar" ? `«${s(lang, key)}»` : `“${s(lang, key)}”`);
const shots = import.meta.glob<ImageMetadata>("../assets/shots/guide/*.png", { eager: true, import: "default" });
const pick = (name: string) => {
    const hit = Object.entries(shots).find(([path]) => path.endsWith(`/${name}-${lang}-light.png`));
    const dark = Object.entries(shots).find(([path]) => path.endsWith(`/${name}-${lang}-dark.png`));
    if (!hit || !dark) throw new Error(`missing picture guide/${name}-${lang}-{light,dark}.png (node tests/guide-shots.mjs)`);
    return { light: hit[1], dark: dark[1] };
};
const steps = [
    {
        title: fmt(t(lang, "try.step1.title"), q("Sample.debt")),
        click: fmt(t(lang, "try.step1.click"), q("Web.Samples"), q("Sample.debt")),
        expect: fmt(t(lang, "try.step1.expect"), q("CaseForm"), q("Document"), q("Compliance")),
        time: t(lang, "try.step1.time"),
        why: t(lang, "try.step1.why"),
        shots: [{ name: "step1-steps", width: 380 }, { name: "step1-check", width: 320 }],
        note: t(lang, "try.shot.demo"),
    },
    {
        title: t(lang, "try.step2.title"),
        click: fmt(t(lang, "try.step2.click"), q("Compliance")),
        expect: fmt(t(lang, "try.step2.expect"), q("ExportPdf")),
        time: t(lang, "try.step2.time"),
        why: t(lang, "try.step2.why"),
        shots: [],
        pieces: [{ kind: "check" as const, score: 7, finding: { title: t(lang, "problem.finding.title"), article: t(lang, "problem.finding.article") } }],
        note: t(lang, "try.shot.demo"),
    },
    {
        title: fmt(t(lang, "try.step3.title"), s(lang, "AnalyseGrounds")),
        click: fmt(t(lang, "try.step3.click"), q("AnalyseGrounds")),
        expect: fmt(t(lang, "try.step3.expect"), q("ConfirmClaim")),
        time: t(lang, "try.step3.time"),
        why: t(lang, "try.step3.why"),
        shots: [{ name: "step3-reading", width: 380 }],
        note: t(lang, "try.shot.real"),
    },
    {
        title: fmt(t(lang, "try.step4.title"), s(lang, "Generate")),
        click: fmt(t(lang, "try.step4.click"), q("Document"), q("Generate")),
        expect: fmt(t(lang, "try.step4.expect"), q("NarrativeSectionHint"), q("ReviewedCheck")),
        time: t(lang, "try.step4.time"),
        why: t(lang, "try.step4.why"),
        shots: [{ name: "step4-grounds", width: 520 }],
        pieces: [{ kind: "review" as const, section: groundsHeading, checked: false }],
        note: t(lang, "try.shot.real"),
    },
    {
        title: t(lang, "try.step5.title"),
        click: fmt(t(lang, "try.step5.click"), q("ExportPdf"), q("ReviewedCheck")),
        expect: fmt(t(lang, "try.step5.expect"), q("ExportBlocked"), q("ExportWord"), q("Preview")),
        time: t(lang, "try.step5.time"),
        why: t(lang, "try.step5.why"),
        shots: [],
        pieces: [{ kind: "export" as const, section: groundsHeading }, { kind: "review" as const, section: groundsHeading, checked: true }],
        note: t(lang, "try.shot.real"),
    },
];
const Heading = heading;
// The step titles sit one level under the section's heading, whatever that is.
const Sub = heading === "h1" ? "h2" : "h3";
const labels = { click: t(lang, "try.click"), expect: t(lang, "try.expect"), time: t(lang, "try.time"), why: t(lang, "try.why") };
---
<Folder tone="kraft" id="try" class="try-folder flat" labelledby="try-title">
<div class="page try">
    <Heading id="try-title" class={heading === "h1" ? "h1" : "h2"}>{t(lang, "try.title")}</Heading>
    <p class="lead">{t(lang, "try.lead")}</p>
    <ol class="try-steps lined" data-progress>
        {steps.map((step, i) => (
            <li class="try-step sheet" data-reveal>
                <span class="num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                <div class="words">
                    <Sub class="h3">{step.title}</Sub>
                    <dl class="howto">
                        <dt>{labels.click}</dt><dd>{step.click}</dd>
                        <dt>{labels.expect}</dt><dd>{step.expect}</dd><dt>{labels.time}</dt><dd>{step.time}</dd><dt>{labels.why}</dt><dd>{step.why}</dd>
                    </dl>
                </div>
                {(
                    <div class="pictures">
                        {step.shots.map((shot, k) => { const img = pick(shot.name); const last = !step.pieces?.length && k === step.shots.length - 1; return <Shot lang={lang} light={img.light} dark={img.dark} alt={t(lang, `try.shot.${i + 1}`)} caption={last ? t(lang, `try.shot.${i + 1}`) : undefined} note={last ? step.note : undefined} width={shot.width} large />; })}
                        {step.pieces?.map((piece, k) => <AppPiece lang={lang} {...piece} caption={k === step.pieces!.length - 1 ? t(lang, `try.shot.${i + 1}`) : undefined} />)}
                    </div>
                )}
            </li>
        ))}
    </ol>
    {(
        <div class="note card-alt">
            <Sub class="h3">{t(lang, "try.note.title")}</Sub>
            <ul class="list plain">
                {[1, 2, 3].map((n) => <li><Icon name="info" size={16} /> <span>{t(lang, `try.note.${n}`)}</span></li>)}
            </ul>
            <p class="small">{fmt(t(lang, "try.same"), q("Web.GuideShow"))}</p>
        </div>
    )}
    <div class="actions">
        {/* The demo opens with its guide (?guide=1): the visitor came here to follow it. */}
        <a class="btn btn-primary" href={`/app?lang=${lang}&guide=1`}>{t(lang, "try.cta")}</a>
        <a class="btn" href={`/${lang}/`}>{t(lang, "nav.home")}</a>
    </div>
    {<Source lang={lang} files={["src/DzLegal.Web/Services/WebText.cs", "src/DzLegal.Presentation/Resources/Strings.resx", "docs/WEB-DEMO.md", "docs/HIDDEN-SET.md", "src/DzLegal.Web/appsettings.json"]} />}
</div>
</Folder>

<style>
    /* On the /try/ page the folder is the page's own (Base.astro): this one only lays the steps out. */
    .try-folder.flat { background: transparent; box-shadow: none; padding-block: clamp(40px, 6vw, 72px) clamp(48px, 7vw, 88px); }
    .try { display: grid; gap: 16px; }
    .try .lead { max-width: 760px; }
    .try-steps { list-style: none; margin: 12px 0 0; padding: 0; display: grid; gap: 16px; }
    .try-step { display: grid; gap: 8px; padding: 24px 24px 24px; }
    .num { font-family: var(--w-display); font-weight: 700; font-size: 2rem; line-height: 1; color: var(--w-sheet-ink); font-variant-numeric: tabular-nums; }
    .words { display: grid; gap: 8px; }
    .howto { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 6px 16px; margin: 0; }
    .howto dt { color: var(--w-sheet-muted); font-weight: 600; font-size: 0.9rem; }
    .howto dd { margin: 0; }
    /* The full guide: the number, the words, the pictures, on one sheet per step, joined by a violet line that fills as
       the steps come into view. */
    .lined { position: relative; gap: 24px; }
    .lined .try-step { grid-template-columns: 3.2rem minmax(0, 1fr) minmax(280px, 42%); gap: 12px 24px; align-items: start; }
    .lined::before, .lined::after { content: ""; position: absolute; top: 48px; bottom: 48px; inset-inline-start: 48px; width: 2px; z-index: 1; }
    .lined::before { background: var(--w-rule); }
    .lined::after { background: var(--w-ink); height: var(--progress, 100%); bottom: auto; max-height: calc(100% - 96px); transition: height 600ms ease; }
    .lined .try-step { z-index: 2; }
    .pictures { display: grid; gap: 12px; }
    .note { display: grid; gap: 10px; }
    .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
    @media (max-width: 899px) { .lined .try-step { grid-template-columns: 1fr; } .lined::before, .lined::after { display: none; } }
    @media (max-width: 599px) { .howto { grid-template-columns: 1fr; gap: 2px 0; } .howto dd { margin-bottom: 6px; } .actions .btn { width: 100%; } }
</style>
