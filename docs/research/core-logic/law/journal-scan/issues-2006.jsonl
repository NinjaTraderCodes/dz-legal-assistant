{"year": 2006, "issue": 18, "issueDate": "2006-03-22", "dateSource": "masthead", "url": "https://www.joradp.dz/FTP/jo-francais/2006/F2006018.pdf", "sha256": "4c23ec7e3d76fd7b083f9da234194dd23d9cfcdab58ff799cc7754e64183b74b", "bytes": 356668, "pages": 36, "textChars": 159388, "textSha256": "38ed20ae0fe91ba2af50011714a12c6d42ce8f40b8a798ad0406fe9cfc84620b", "blind": false, "readOn": "2026-11-13", "patternsVersion": 1, "error": null, "hits": [{"instrument": "civil-code", "pattern": "code civil", "page": 5, "class": "other", "sentence": "l’union internationale pour la conservation de la nature et de ses ressources (uicn) (aussi connue sous le nom d’union mondiale pour la nature) est constituee, conformement a l’article 60 du code civil suisse, en tant qu’association internationale de membres gouvernementaux et non-gouvernementaux."}, {"instrument": "labour-relations", "pattern": "relations de travail", "page": 13, "class": "other", "sentence": "le directeur general, avec l’accord du conseil, peut etablir des relations de travail appropriees entre l’uicn et des gouvernements et des organisations, qu’elles soient nationales ou internationales, gouvernementales ou non."}, {"instrument": "labour-relations", "pattern": "relations de travail", "page": 15, "class": "other", "sentence": "les membres des groupes de travail de l’uicn officiellement constitues et d’autres personnes ayant des relations de travail analogues avec l’uicn qui ne sont pas membres d’une delegation peuvent, a l’invitation du directeur general, participer au congres mondial en qualite d’observateurs."}], "visaHits": {}, "textVersion": 3, "decodedLines": 0, "unreadablePages": [], "readable": true}
