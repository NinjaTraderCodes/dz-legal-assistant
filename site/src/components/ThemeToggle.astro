---
// The theme tile of the welcome screen: a sun on the dark theme (the default), a moon on the light one. ui.js wires
// the click and remembers the choice; without JavaScript the page simply stays dark.
import Icon from "./Icon.astro";
import { t, type Lang } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
---
<button type="button" class="theme" data-theme-toggle aria-pressed="true" aria-label={t(lang, "theme.light")} title={t(lang, "theme.light")} data-label-dark={t(lang, "theme.dark")} data-label-light={t(lang, "theme.light")}>
    <span data-icon="moon" hidden><Icon name="weather_moon" /></span>
    <span data-icon="sun"><Icon name="weather_sunny" /></span>
</button>

<style>
    .theme { display: inline-grid; place-items: center; width: 40px; height: 40px; border: 1.5px solid var(--w-btn); border-radius: 2px; background: transparent; color: var(--w-text); cursor: pointer; }
    .theme:hover { background: color-mix(in srgb, var(--w-btn) 10%, transparent); }
    .theme span { display: inline-grid; }
    .theme span[hidden] { display: none; }
</style>
