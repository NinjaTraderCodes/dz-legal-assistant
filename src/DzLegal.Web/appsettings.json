{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Hosted engines for the public demo. API keys are NOT here: set GOOGLE_API_KEY (and optionally GROQ_API_KEY,
  // OPENROUTER_API_KEY) as environment variables or host secrets. See docs/WEB-DEMO.md.
  "Engines": {
    // Gemma 3 on Google AI Studio, tried in order; each model has its own rate limit.
    "GoogleModels": [ "gemma-3-4b-it", "gemma-3-12b-it", "gemma-3-27b-it" ],
    "GroqModel": "llama-3.3-70b-versatile",
    "OpenRouterModel": "google/gemma-3-27b-it",
    // Model calls running at once across all visitors; the rest wait their turn.
    "MaxConcurrentCalls": 2,
    "RunsPerSessionPerHour": 30,
    "Temperature": 0.2,
    "MaxTokens": 1000
  }
}
