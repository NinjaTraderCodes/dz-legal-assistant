---
// The page frame shared by every page: language and direction on <html>, the head (title, description, canonical,
// hreflang, Open Graph, favicon, the theme script), the header and the footer. Everything comes from this origin.
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { dirOf, localeOf, otherLang, s, t, type Lang } from "../i18n";
import naskhUrl from "../assets/fonts/NotoNaskhArabic-Regular.woff2?url";
import interUrl from "../assets/fonts/Inter-latin.woff2?url";

interface Props { lang: Lang; title: string; description: string; path: string; ogImage?: string; noindex?: boolean; preloadImage?: { src: string; srcSet: string; sizes: string } }
const { lang, title, description, path, ogImage, noindex = false, preloadImage } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, "") ?? "";
const canonical = `${site}/${lang}${path}`;
const other = otherLang(lang);
const appTitle = s(lang, "AppTitle");
const fullTitle = title === appTitle ? appTitle : `${title} — ${appTitle}`;
const image = `${site}${ogImage ?? `/og/home-${lang}.png`}`;
---
<!doctype html>
<html lang={lang} dir={dirOf(lang)}>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={localeOf(lang)} href={canonical} />
    <link rel="alternate" hreflang={localeOf(other)} href={`${site}/${other}${path}`} />
    <link rel="alternate" hreflang="x-default" href={`${site}/ar${path}`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={lang === "ar" ? naskhUrl : interUrl} />
    {preloadImage && <link rel="preload" as="image" href={preloadImage.src} imagesrcset={preloadImage.srcSet} imagesizes={preloadImage.sizes} fetchpriority="high" />}
    <meta name="theme-color" content="#786039" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={appTitle} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === "ar" ? "ar_DZ" : "en_GB"} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline src="/theme-init.js"></script>
</head>
<body class="min-h-dvh flex flex-col">
    <a href="#main" class="skip">{t(lang, "skip")}</a>
    <Header lang={lang} path={path} />
    <main id="main" class="flex-1">
        <slot />
    </main>
    <Footer lang={lang} />
    <script is:inline src="/ui.js" defer></script>
</body>
</html>

<style is:global>
    .skip { position: absolute; inset-inline-start: 16px; top: -100px; z-index: 50; padding: 10px 16px; border-radius: var(--radius-control); background: var(--gold); color: var(--on-gold); font-weight: 600; }
    .skip:focus { top: 12px; }
</style>
