@using DzLegal.Web.Services
@using DzLegal.Web.Site
@inject IHttpContextAccessor Http
@{
    // The language and theme of the page itself, before the circuit exists: the visitor's remembered choice, the
    // ?lang= query, or the browser's language; light unless dark was chosen.
    var request = HttpContext?.Request ?? Http.HttpContext?.Request;
    var lang = request is null ? LanguageChoice.English : LanguageChoice.FromRequest(request);
    var dark = request?.Cookies[LanguageSwitch.ThemeCookieName] == "dark";
}
<!DOCTYPE html>
<html lang="@lang" dir="@LanguageChoice.Dir(lang)" data-theme="@(dark ? "dark" : null)">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <meta name="description" content="DZ Legal Assistant: drafts Algerian court petitions in formal Arabic and checks every mandatory element. Live demo." />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="@Assets["tokens.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["DzLegal.Web.styles.css"]" />
    @* The page is interactive without prerendering, so HeadOutlet alone left the tab without a title. *@
    <title>@WebText.Get("Title", lang)</title>
    <HeadOutlet />
</head>

<body>
    @* The product's own welcome, shown until the circuit connects (on the free host the first visit wakes the server). *@
    <div id="app-loading" class="app-loading" role="status" aria-live="polite">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 96 96" width="72" height="72" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M48,9 L48,78 M43,9 C43,3 53,3 53,9 C53,15 43,15 43,9 M18,25 C28,25 34,18 48,18 C62,18 68,25 78,25 M23,25 L10,53 L36,53 Z M73,25 L60,53 L86,53 Z M10,53 C12,69 34,69 36,53 M60,53 C62,69 84,69 86,53 M42,78 L54,78 M38,85 C38,75 58,75 58,85 M28,88 L68,88" /></svg>
        <p class="app-loading-title">@WebText.Get("Title", lang)</p>
        <p class="app-loading-text">@WebText.Get("Loading", lang)</p>
        <p class="app-loading-hint">@WebText.Get("LoadingHint", lang)</p>
    </div>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["dzlegal.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }
}
