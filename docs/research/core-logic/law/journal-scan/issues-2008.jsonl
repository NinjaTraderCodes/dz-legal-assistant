{"year": 2008, "issue": 21, "issueDate": "2008-04-23", "dateSource": "masthead", "url": "https://www.joradp.dz/FTP/jo-francais/2008/F2008021.pdf", "sha256": "ab20f3ce14bcfb9c1164397c55b2231c1106b9f61ea801480bc9448065e2e1a1", "bytes": 493009, "pages": 83, "textChars": 380931, "textSha256": "be4834e6203580263ee16d90ef6d5a03c834e9225235ea30de5af3144e9ce0f8", "blind": false, "readOn": "2026-11-13", "patternsVersion": 1, "error": null, "hits": [{"instrument": "cpca", "pattern": "08-09", "page": 2, "class": "title", "sentence": "2 journal officiel de la republique algerienne n° 21 17 rabie ethani 1429 23 avril 2008 sommaire loi n° 08-09 du 18 safar 1429 correspondant au 25 fevrier 2008 portant code de procedure civile et administrative"}, {"instrument": "cpca", "pattern": "08-09", "page": 3, "class": "title", "sentence": "17 rabie ethani 1429 23 avril 2008 journal officiel de la republique algerienne n° 21 3 lois loi n° 08-09 du 18 safar 1429 correspondant au 25 fevrier 2008 portant code de procedure civile et administrative."}, {"instrument": "family-code", "pattern": "code de la famille", "page": 26, "class": "other", "sentence": "6 - violation de la loi etrangere relative au code de la famille ;"}, {"instrument": "family-code", "pattern": "code de la famille", "page": 31, "class": "other", "sentence": "1 - des actions liees aux fiancailles, au mariage, a la reintegration au domicile conjugal, a la dissolution du mariage ainsi que de ses consequences, dans les cas et conditions prevus par le code de la famille ;"}, {"instrument": "family-code", "pattern": "code de la famille", "page": 33, "class": "other", "sentence": "- si, en cours d'instance, le tort n'a pu etre etabli, le juge peut designer deux arbitres pour reconcilier les epoux, conformement aux dispositions du code de la famille."}, {"instrument": "family-code", "pattern": "code de la famille", "page": 33, "class": "other", "sentence": "- le juge constate et qualifie les faits constitutifs de la ou des causes alleguees au soutien de la demande de divorce presentee par l'epouse, conformement au code de la famille."}, {"instrument": "family-code", "pattern": "code de la famille", "page": 33, "class": "other", "sentence": "le juge constate et qualifie egalement les faits constitutifs de la demande de khol'a‚ conformement au code de la famille."}, {"instrument": "family-code", "pattern": "code de la famille", "page": 34, "class": "other", "sentence": "il peut, a cet effet, confier provisoirement la garde du mineur a l'autre parent ou, a defaut, a l'une des autres personnes prevues dans le code de la famille."}, {"instrument": "family-code", "pattern": "code de la famille", "page": 34, "class": "other", "sentence": "- le juge designe un curateur en application du code de la famille, parmi les proches du mineur ou, a defaut, une autre personne qu'il aura choisie."}, {"instrument": "family-code", "pattern": "code de la famille", "page": 34, "class": "other", "sentence": "- la demande de designation du curateur est presentee sous forme de requete par les personnes habilitees a cet effet, par le code de la famille, ou sous forme de requisition du ministere public."}, {"instrument": "commercial-code", "pattern": "code de commerce", "page": 38, "class": "other", "sentence": "- la section commerciale connait des litiges commerciaux et, le cas echeant, des litiges maritimes conformement au code de commerce, au code maritime et aux textes particuliers, sous reserve des dispositions de l'article 32 du present code."}, {"instrument": "commercial-code", "pattern": "code de commerce", "page": 38, "class": "other", "sentence": "- le president de la section commerciale rend la decision apres avis des assesseurs, selon les regles prevues dans le present code et celles du code de commerce et des lois particulieres."}, {"instrument": "commercial-code", "pattern": "code de commerce", "page": 44, "class": "other", "sentence": "10 - les cheques et les lettres de change apres signification des protets au debiteur conformement aux dispositions du code de commerce ;"}, {"instrument": "civil-code", "pattern": "code civil", "page": 58, "class": "other", "sentence": "toutefois, le vendeur de l'immeuble saisi, le preteur de deniers et le copartageant ont le droit d'inscrire leurs privileges dans les delais et conditions prevus par le code civil."}, {"instrument": "civil-code", "pattern": "code civil", "page": 62, "class": "other", "sentence": "- le creancier peut, conformement aux dispositions de l'article 721 ci-dessus, saisir les biens immobiliers non publies de son debiteur, s'il detient une decision administrative ou un acte sous seing prive, dont la date est valide, conformement au code civil."}, {"instrument": "civil-code", "pattern": "code civil", "page": 63, "class": "other", "sentence": "les creances relatives a la pension alimentaire beneficient de la preference lors du payement au regard des autres creances, conformement a l'ordre prevu dans le code civil."}], "visaHits": {"civil-code": 2, "commercial-code": 2, "family-code": 2}, "textVersion": 3, "decodedLines": 0, "unreadablePages": [], "readable": true}
{"year": 2008, "issue": 22, "issueDate": "2008-04-30", "dateSource": "masthead", "url": "https://www.joradp.dz/FTP/jo-francais/2008/F2008022.pdf", "sha256": "32bab839f2df71afeeb9cab1be88818a891067d8dcc042bbb6f55c0b5017d47c", "bytes": 300110, "pages": 22, "textChars": 97885, "textSha256": "4630bbe1ec348c40290d9794c5af6014716aea9d2f48b50cf887f259e70208e7", "blind": false, "readOn": "2026-11-13", "patternsVersion": 1, "error": null, "hits": [{"instrument": "labour-relations", "pattern": "relations de travail", "page": 8, "class": "other", "sentence": "8 journal officiel de la republique algerienne n° 22 24 rabie ethani 1429 30 avril 2008 - il propose les instruments d'encadrement juridique des relations de travail ;"}, {"instrument": "labour-relations", "pattern": "relations de travail", "page": 8, "class": "other", "sentence": "- d’elaborer et d’adapter les normes juridiques et reglementaires de regulation et d'encadrement des relations de travail, notamment en ce qui concerne les relations individuelles et collectives de travail, la participation des travailleurs et l'exercice du droit syndical ;"}, {"instrument": "labour-relations", "pattern": "relations de travail", "page": 9, "class": "other", "sentence": "- la direction des relations de travail ;"}, {"instrument": "labour-relations", "pattern": "relations de travail", "page": 12, "class": "other", "sentence": "-la direction des relations de travail est chargee :"}, {"instrument": "labour-relations", "pattern": "relations de travail", "page": 12, "class": "other", "sentence": "- d'elaborer et d'adapter les normes juridiques d'encadrement et de regulation des relations de travail ;"}, {"instrument": "labour-relations", "pattern": "relations de travail", "page": 12, "class": "other", "sentence": "- de suivre, en liaison avec les services de l'inspection du travail l’application des dispositions legislatives et reglementaires en vigueur, en matiere de relations de travail, de conditions de travail , de negociation collective et d'exercice du droit syndical ;"}], "visaHits": {}, "textVersion": 3, "decodedLines": 0, "unreadablePages": [], "readable": true}
