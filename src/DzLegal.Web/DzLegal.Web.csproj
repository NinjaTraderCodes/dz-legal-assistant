<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <Description>Public web demo: the desktop app's engine and view models in the browser (Blazor Server). The AI steps run on a hosted Gemma model, so it is for fictitious cases only; the product itself runs offline.</Description>
    <IncludeLegalData>true</IncludeLegalData>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DzLegal.Presentation\DzLegal.Presentation.csproj" />
    <ProjectReference Include="..\DzLegal.ModelProviders.Hosted\DzLegal.ModelProviders.Hosted.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="Samples\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- The official PDFs the law library's texts were taken from, so a reader can open the exact page. -->
    <None Include="..\..\docs\official-law-texts\75-58_wipo_Version.pdf;..\..\docs\official-law-texts\75-59_wipo_Version.pdf;..\..\docs\official-law-texts\A2008021.pdf"
          LinkBase="law-sources" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DzLegal.Web.Tests" />
  </ItemGroup>
</Project>
