@using DzLegal.Presentation.ViewModels
@* The section assistant, in a side drawer as on the desktop: the AI rewords one section on request and shows the change
   to accept or reject. *@
@* A non-modal drawer (the page stays usable beside it); Escape closes it. *@
<aside class="assistant" role="dialog" aria-labelledby="assistant-title" dir="@(Vm.IsRightToLeft ? "rtl" : "ltr")"
       @onkeydown="@(e => { if (e.Key == "Escape") Vm.CloseAssistantCommand.Execute(null); })">
    <div class="head">
        <h2 id="assistant-title"><Icon Name="sparkle" /> @Vm.AssistantTitle</h2>
        <button type="button" class="quiet" aria-label="@Vm.L["CloseAssistant"]" @onclick="() => Vm.CloseAssistantCommand.Execute(null)"><Icon Name="dismiss" /></button>
    </div>
    <p class="muted small">@Vm.L["AssistantScope"]</p>
    <div class="shortcuts">
        @foreach (var s in Vm.Shortcuts)
        {
            <button type="button" class="small" disabled="@CommandRunner.IsAiBusy(Vm)" @onclick="() => CommandRunner.RunAsync(Vm, Vm.UseShortcutCommand, s)">@s.Label</button>
        }
    </div>
    <div class="ask">
        <label class="small muted" for="assistant-instruction">@Vm.L["InstructionPlaceholder"]</label>
        <textarea id="assistant-instruction" rows="3" dir="auto" maxlength="1000" @bind="Vm.AssistantInstruction" @bind:event="oninput"></textarea>
        <div class="row">
            @if (Vm.SendInstructionCommand.IsRunning)
            {
                <button type="button" @onclick="() => Vm.SendInstructionCancelCommand.Execute(null)"><Icon Name="stop" /> @Vm.L["Cancel"]</button>
            }
            else
            {
                <button type="button" class="ai" disabled="@CommandRunner.IsAiBusy(Vm)" @onclick="() => CommandRunner.RunAsync(Vm, Vm.SendInstructionCommand)">@Vm.L["Send"]</button>
            }
        </div>
    </div>
    @foreach (var m in Vm.AssistantThread)
    {
        <div class="bubble @(m.FromLawyer ? "mine" : "")" dir="auto">@m.Text</div>
    }
    <ModelActivity Model="Vm.AssistantActivity" LiveLabel="@Vm.L["ActivityLive"]" />
    @if (Vm.HasProposal)
    {
        <div class="diff" dir="rtl" lang="ar">
            @foreach (var t in Vm.ProposalDiff)
            {
                <span class="@(t.IsAdded ? "added" : t.IsRemoved ? "removed" : "")">@t.Text</span>
            }
        </div>
        @if (Vm.ProposalHints.Length > 0)
        {
            <div class="review">@Vm.ProposalHints</div>
        }
        <div class="decide">
            <button type="button" class="primary" disabled="@(!Vm.CanAcceptProposal)" @onclick="() => Vm.AcceptProposalCommand.Execute(null)"><Icon Name="checkmark" /> @Vm.L["Accept"]</button>
            <button type="button" @onclick="() => Vm.RejectProposalCommand.Execute(null)">@Vm.L["Reject"]</button>
            <button type="button" disabled="@CommandRunner.IsAiBusy(Vm)" @onclick="() => CommandRunner.RunAsync(Vm, Vm.RetryProposalCommand)"><Icon Name="arrow_clockwise" Size="16" /> @Vm.L["TryAgain"]</button>
        </div>
    }
</aside>

@code {
    [Parameter, EditorRequired] public MainWindowViewModel Vm { get; set; } = default!;
}
