  "cSays": {
    "openPoints": [
      {
        "question": "Wages and sums owed to workers: article 309 gives five years for wages and salaries, article 312 gives one year for sums owed to workers for their work. Which applies to a labour wage claim?",
        "readings": [
          "312 (one year) is the special rule for workers and prevails over 309",
          "309 (five years) applies to periodic wages, 312 to other sums owed to workers",
          "A labour-law text not given here governs"
        ]
      },
      {
        "question": "Does CPCA 405 (day of notification and last day not counted, holidays counted, extension to next working day) govern civil-code limitation periods?",
        "readings": [
          "No: 405 says periods 'in this law' (the procedure code), and civil-code 314 governs limitation (first day not counted, period complete at the end of the last day)",
          "Yes by analogy, so that a limitation period ending on a non-working day extends to the next working day"
        ]
      },
      {
        "question": "Does civil-code 314 (counted by days; first day not counted) apply to periods stated in months or years?",
        "readings": [
          "Yes: the period is counted by calendar dates from the day after the starting event and ends at the end of the last day",
          "No fixed text: the conversion of years into days is not stated"
        ]
      },
      {
        "question": "Who raises limitation: civil-code 321 forbids the court to rule it of its own motion, while CPCA 67 lists limitation among pleas of inadmissibility and CPCA 69 requires the judge to raise public-order inadmissibility of his own motion.",
        "readings": [
          "Limitation is not public order: only a party or interested person raises it (321, the special rule for limitation)",
          "CPCA 67 treats limitation as inadmissibility, so 69 could apply if it is public order; no text given says it is"
        ]
      },
      {
        "question": "Is the period in CPCA 504 (labour claim time limit) a limitation or a forfeiture, and who may raise it?",
        "readings": [
          "Text not given: cannot be decided here"
        ]
      },
      {
        "question": "Start of the 1-year, 2-year and 15-year (article 313 para 2) periods: article 313 para 1 names only 309 and 311.",
        "readings": [
          "General start of article 315 (day the debt becomes payable)",
          "Completion of services, by extension of 313 para 1"
        ]
      },
      {
        "question": "Is the acknowledgment/interruption by notice (article 317, 'بالتنبيه') satisfied by any formal notice, including a registered letter?",
        "readings": [
          "Only formal notice in the legal sense (e.g. by bailiff)",
          "Any notice served on the debtor; the text does not say the means"
        ]
      },
      {
        "question": "How do the slots (notice, defendant abroad, bankruptcy, public servant, work accident) affect periods? Only abroad residence is addressed (404 extends appeal-type periods, not limitation); the others have no text here.",
        "readings": [
          "No effect from the texts given",
          "Effects exist in texts not given (labour code, commercial code, public-service statutes)"
        ]
      }
