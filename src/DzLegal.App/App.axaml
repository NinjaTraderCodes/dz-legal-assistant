<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DzLegal.App.App"
             RequestedThemeVariant="Light">
  <Application.Resources>
    <ResourceDictionary>
      <FontFamily x:Key="DocumentFont">fonts:Naskh#Noto Naskh Arabic, fonts:Inter#Inter</FontFamily>
      <FontFamily x:Key="UiFont">fonts:Inter#Inter, fonts:Naskh#Noto Naskh Arabic</FontFamily>
      <CornerRadius x:Key="CardRadius">12</CornerRadius>
      <CornerRadius x:Key="ControlRadius">8</CornerRadius>
      <ImageBrush x:Key="OnboardingPhotograph" Source="avares://DzLegalAssistant/Assets/Images/welcome-bg.jpg" Stretch="UniformToFill" />

      <!-- Design tokens: one palette per theme variant. -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="CanvasBrush" Color="#F2F0EA" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F8F6F1" />
          <SolidColorBrush x:Key="PaperBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="PaperCanvasBrush" Color="#E7E3DA" />
          <SolidColorBrush x:Key="HairlineBrush" Color="#E4DFD4" />
          <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1C2321" />
          <SolidColorBrush x:Key="TextMutedBrush" Color="#6A706D" />
          <SolidColorBrush x:Key="AppBarBrush" Color="#16392F" />
          <SolidColorBrush x:Key="AppBarTextBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="AccentBrush" Color="#1E5A4B" />
          <SolidColorBrush x:Key="AccentSoftBrush" Color="#E1EEE9" />
          <SolidColorBrush x:Key="PrimaryButtonBrush" Color="#1E5A4B" />
          <SolidColorBrush x:Key="PrimaryButtonTextBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="InputBorderBrush" Color="#8B8274" />
          <SolidColorBrush x:Key="FieldToolsBrush" Color="#DFE7E9" />
          <SolidColorBrush x:Key="FieldToolsTextBrush" Color="#344D5A" />
          <SolidColorBrush x:Key="DangerBrush" Color="#B3261E" />
          <SolidColorBrush x:Key="DangerSoftBrush" Color="#FCEBE9" />
          <SolidColorBrush x:Key="WarningBrush" Color="#935600" />
          <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFF3DC" />
          <SolidColorBrush x:Key="SuccessBrush" Color="#2B7A4B" />
          <SolidColorBrush x:Key="SuccessSoftBrush" Color="#E5F3EA" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <LinearGradientBrush x:Key="CanvasBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#5C4932" Offset="0" /><GradientStop Color="#1D201E" Offset="0.46" /><GradientStop Color="#3B3029" Offset="1" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="PanelBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#D43C352B" Offset="0" /><GradientStop Color="#EB24221E" Offset="0.45" /><GradientStop Color="#E822211E" Offset="1" />
          </LinearGradientBrush>
          <SolidColorBrush x:Key="SurfaceBrush" Color="#24201B" />
          <SolidColorBrush x:Key="SurfaceAltBrush" Color="#302A23" />
          <SolidColorBrush x:Key="PaperBrush" Color="#FFFEFC" />
          <SolidColorBrush x:Key="PaperCanvasBrush" Color="#181715" />
          <SolidColorBrush x:Key="HairlineBrush" Color="#6C604C" />
          <SolidColorBrush x:Key="InputBorderBrush" Color="#8C7B65" />
          <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2EDE5" />
          <SolidColorBrush x:Key="TextMutedBrush" Color="#C2B8A9" />
          <SolidColorBrush x:Key="AppBarBrush" Color="#1D1812" />
          <SolidColorBrush x:Key="AppBarTextBrush" Color="#F2EDE5" />
          <SolidColorBrush x:Key="AccentBrush" Color="#D2B981" />
          <SolidColorBrush x:Key="AccentSoftBrush" Color="#423724" />
          <SolidColorBrush x:Key="PrimaryButtonBrush" Color="#C6A76D" />
          <SolidColorBrush x:Key="PrimaryButtonTextBrush" Color="#28231D" />
          <SolidColorBrush x:Key="FieldToolsBrush" Color="#DFE7E9" />
          <SolidColorBrush x:Key="FieldToolsTextBrush" Color="#344D5A" />
          <SolidColorBrush x:Key="DangerBrush" Color="#FFC0B3" />
          <SolidColorBrush x:Key="DangerSoftBrush" Color="#462C27" />
          <SolidColorBrush x:Key="WarningBrush" Color="#F2CB83" />
          <SolidColorBrush x:Key="WarningSoftBrush" Color="#43331E" />
          <SolidColorBrush x:Key="SuccessBrush" Color="#ACD3BD" />
          <SolidColorBrush x:Key="SuccessSoftBrush" Color="#263B30" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#1E5A4B" />
        <ColorPaletteResources x:Key="Dark" Accent="#C6A76D" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="/Styles/ThemeToggle.axaml" />
  </Application.Styles>
</Application>
