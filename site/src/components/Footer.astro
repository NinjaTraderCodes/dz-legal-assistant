---
// The foot of every page, the back cover of the case file: the pages, the version and the licences of what the site bundles (fonts and icons), as AGENTS.md requires.
import { s, t, fmt, type Lang } from "../i18n";
import { pages, version } from "../content/product";

interface Props { lang: Lang; path: string }
const { lang, path } = Astro.props;
const current = (page: string) => (page === path ? "page" : undefined);
---
<footer class="site-footer">
    <div class="page foot">
        <nav class="links pages" aria-label={t(lang, "footer.pages")}>
            <a href={`/${lang}/`} aria-current={current("/")}>{t(lang, "nav.home")}</a>
            {pages(lang).filter((p) => p.key !== "how").map((link) => <a href={link.href} aria-current={current(link.path)}>{link.label}</a>)}
            <a href={`/app?lang=${lang}`}>{t(lang, "nav.demo")}</a>
        </nav>
        <p class="caption">{fmt(t(lang, "footer.version"), version)} · {s(lang, "AboutThirdUni")}</p>
        <p class="caption">{t(lang, "footer.licences")} <a href="/licences/OFL-MarkaziText.txt">Markazi Text (OFL)</a>, <a href="/licences/OFL-ReadexPro.txt">Readex Pro (OFL)</a>, <a href="/licences/OFL-ArefRuqaa.txt">Aref Ruqaa (OFL)</a>, <a href="/licences/OFL-Inter.txt">Inter (OFL)</a>, <a href="/licences/OFL-NotoNaskhArabic.txt">Noto Naskh Arabic (OFL)</a>, <a href="/licences/MIT-FluentIcons.txt">Fluent UI System Icons (MIT)</a>.</p>
    </div>
</footer>

<style>
    .site-footer { background: var(--w-grain) var(--w-kraft); color: var(--w-text); }
    .foot { display: grid; gap: 12px; padding-block: 36px 44px; border-top: 2px solid var(--w-text); }
    .links { display: flex; flex-wrap: wrap; gap: 6px 20px; }
    .links a { color: var(--w-text); }
    .pages a[aria-current="page"] { font-weight: 600; }
    .caption a { color: var(--w-muted); }
</style>
