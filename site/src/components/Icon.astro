---
// Fluent UI System Icons (MIT, src/icons/fluent/LICENSE): the same 20 px regular glyphs the desktop app uses, inlined
// so nothing is fetched at run time. Decorative by default; pass a label to make one meaningful.
interface Props { name: string; size?: number; class?: string; label?: string }
const { name, size = 20, class: cls = "", label } = Astro.props;
const files = import.meta.glob("../icons/fluent/*.svg", { query: "?raw", import: "default", eager: true }) as Record<string, string>;
const raw = files[`../icons/fluent/${name}.svg`];
if (!raw) throw new Error(`icon ${name} is not in src/icons/fluent`);
const svg = raw
    .replace(/<svg[^>]*>/, "")
    .replace(/<\/svg>\s*$/, "")
    .replace(/fill="#212121"/g, 'fill="currentColor"');
---
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" width={size} height={size} class={`icon ${cls}`.trim()} aria-hidden={label ? undefined : "true"} role={label ? "img" : undefined} aria-label={label} set:html={svg} />
