---
// What the product guarantees, set out like the petition's list of attached documents: each guarantee is an exhibit,
// numbered, with its title, the fact, and the thing itself attached beside it, as pieces of the interface drawn in
// HTML (AppPiece.astro: the library's card from law.generated.json, the offline badge, the review row and the
// refused-export notice). The drafted grounds themselves are the picture of the drafting log just above (AiPanel,
// stage 04), so the fourth exhibit attaches the reviewed row under them rather than the same picture a second time.
import Folder from "./Folder.astro";
import AppPiece from "./AppPiece.astro";
import Source from "./Source.astro";
import { groundsTitle } from "../content/steps";
import { s, t, fmt, type Lang } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const groundsHeading = groundsTitle[lang];
const items = [
    { title: t(lang, "proofs.texts.title"), body: fmt(s(lang, "AboutSources"), "1,361", "6") + " " + t(lang, "proofs.texts.body"), pieces: [{ kind: "library" as const }], caption: t(lang, "proofs.shot.texts") },
    { title: t(lang, "proofs.offline.title"), body: t(lang, "proofs.offline.body"), pieces: [{ kind: "offline" as const }], caption: t(lang, "proofs.shot.offline") },
    { title: t(lang, "proofs.review.title"), body: t(lang, "proofs.review.body"), pieces: [{ kind: "review" as const, section: groundsHeading, checked: false }, { kind: "export" as const, section: groundsHeading }], caption: t(lang, "proofs.shot.review") },
    { title: t(lang, "proofs.grounds.title"), body: t(lang, "proofs.grounds.body"), pieces: [{ kind: "review" as const, section: groundsHeading, checked: true }], caption: undefined },
];
---
<Folder tone="salmon" no="05" tab={t(lang, "tab.proofs")} labelledby="proofs-title">
    <div class="page proofs">
        <h2 id="proofs-title" class="h1">{t(lang, "proofs.title")}</h2>
        <ol class="exhibits">
            {items.map((item, i) => (
                <li class="exhibit">
                    <div class="words">
                        <p class="reg-no">{fmt(t(lang, "proofs.exhibit"), String(i + 1))}</p>
                        <h3 class="h3">{item.title}</h3>
                        <p>{item.body}</p>
                    </div>
                    <div class="attached">
                        {item.pieces.map((piece, k) => <AppPiece lang={lang} {...piece} caption={k === item.pieces.length - 1 ? item.caption : undefined} replicaNote={false} />)}
                    </div>
                </li>
            ))}
        </ol>
        <p class="caption">{t(lang, "proofs.replica")}</p>
        <Source lang={lang} files={["README.md", "docs/PRODUCT-DETAILS.md", "docs/OFFLINE.md", "data/law/codes"]} />
    </div>
</Folder>

<style>
    .proofs { display: grid; gap: 28px; }
    /* The list of exhibits: one row per guarantee under a heavy rule, the words on the reading side and the exhibit
       attached on the other, each as tall as what it holds. */
    .exhibits { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--w-text); }
    .exhibit { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 16px clamp(28px, 4vw, 56px); align-items: start; padding-block: 30px; border-bottom: 1px solid var(--w-rule); }
    .words { display: grid; gap: 10px; align-content: start; }
    .words p:not(.reg-no) { font-size: 0.97rem; }
    .attached { display: grid; gap: 14px; }
    @media (max-width: 899px) { .exhibit { grid-template-columns: 1fr; } }
</style>
