---
// "Test it in 5 minutes": the full guide to the live demo, for the ThirdUni judges first. The home shows its
// compact form under the hero; both come from TryGuide.astro, so they never diverge.
import Base from "../../layouts/Base.astro";
import TryGuide from "../../components/TryGuide.astro";
import { langs, t, type Lang } from "../../i18n";

export function getStaticPaths() {
    return langs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
---
<Base lang={lang} title={t(lang, "try.title")} description={t(lang, "meta.try.description")} path="/try/" og="try">
    <TryGuide lang={lang} heading="h1" />
</Base>
