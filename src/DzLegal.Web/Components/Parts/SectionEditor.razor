@using System.Globalization
@using DzLegal.Domain
@using DzLegal.Presentation.ViewModels
@* One section of the requête on paper, laid out as the desktop lays it out from the definition: alignment, weight,
   the space before it, and an underlined heading when the definition prints one. Clicking or focusing it selects it
   (the strip above the paper then shows its tools); an AI-written section carries its mark in the paper itself.
   Same view model as the desktop editor. *@
<div class="section @Classes" style="margin-top:@Spacing" @onclick="Select" @onfocusin="Select">
    @if (Section.Definition.ShowTitle)
    {
        <div class="document-heading">@Section.Definition.Title.Ar:</div>
    }
    @if (Section.IsAiWritten)
    {
        <span class="ai-mark" title="@Vm.L["NarrativeSectionHint"]"><Icon Name="sparkle" Size="10" /> @Vm.L["ModelTag"]</span>
    }
    @if (Section.IsReadOnly)
    {
        <div class="section-text">@Section.Text</div>
    }
    else
    {
        <textarea class="section-text" dir="rtl" rows="@Rows" maxlength="12000" aria-label="@Section.Title" placeholder="@Section.Watermark" @bind="Section.Text" @bind:event="oninput"></textarea>
    }
</div>

@code {
    [Parameter, EditorRequired] public SectionViewModel Section { get; set; } = default!;

    [Parameter, EditorRequired] public MainWindowViewModel Vm { get; set; } = default!;

    [Parameter] public bool IsSelected { get; set; }

    [Parameter] public EventCallback<SectionViewModel> OnSelect { get; set; }

    private Task Select() => OnSelect.InvokeAsync(Section);

    private string Classes => string.Join(' ', new[]
    {
        "align-" + Section.Definition.Layout.Align.ToString().ToLowerInvariant(),
        Section.Definition.Layout.Bold ? "bold" : "",
        Section.IsWriting ? "writing" : "",
        Section.IsAiWritten ? "ai" : "",
        IsSelected ? "selected" : "",
    }.Where(c => c.Length > 0));

    // The desktop converts the definition's points to pixels the same way.
    private string Spacing => (Section.Definition.Layout.SpaceBefore * 1.12).ToString("0.##", CultureInfo.InvariantCulture) + "px";

    // Enough rows for the text (about 60 characters a line at the paper's size), so it reads like a page.
    private int Rows => Math.Max(1, Section.Text.Split('\n').Sum(l => 1 + l.Length / 60));
}
