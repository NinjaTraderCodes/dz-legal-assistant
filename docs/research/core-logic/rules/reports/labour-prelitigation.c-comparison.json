  "cSays": {
    "openPoints": [
      {
        "question": "Is a missing conciliation (no non-conciliation record attached) a bar to the action?",
        "readings": [
          "Art. 19 para 1 and art. 37 make it a mandatory precondition, though no text given states a sanction",
          "No sanction is stated for labour (unlike cpca 536 bis 4 para 3 for commercial courts), so the action may not be barred"
        ]
      },
      {
        "question": "What starts the 6 months in cpca 504 when the record was handed over at the meeting (labour-disputes 30 para 2) or sent later?",
        "readings": [
          "The date of handing over at the meeting",
          "The date of actual delivery to the plaintiff if later"
        ]
      },
      {
        "question": "How is the 6-month period counted (first/last day, non-working day)?",
        "readings": [
          "No text given says; counting rule is missing from these texts"
        ]
      },
      {
        "question": "Who may raise the forfeiture of cpca 504?",
        "readings": [
          "The court of its own motion",
          "Only a party"
        ]
      },
      {
        "question": "Does the 6-month period apply where conciliation was optional (art. 19 para 2) so no record exists?",
        "readings": [
          "The period cannot start without a record",
          "The period does not apply but a general time limit may"
        ]
      },
      {
        "question": "Scope of the optional conciliation: does 'حالة الإفلاس أو تسوية قضائية' cover bankruptcy of the employer only?",
        "readings": [
          "Employer only (as read in the text)",
          "Any bankruptcy or settlement affecting the defendant"
        ]
      },
      {
        "question": "Are the internal procedures of arts. 3 to 5 a condition before conciliation or filing?",
        "readings": [
          "Art. 5 says 'can notify', so optional",
          "They must be exhausted first"
        ]
      },
      {
        "question": "Where do disputes of public officials go?",
        "readings": [
          "Administrative court (not stated in the texts)",
          "Another section"
        ]
      },
      {
        "question": "Which territorial rule prevails when cpca 501 (place of conclusion or performance, or domicile) and labour-disputes 24 (place of performance or residence) differ?",
        "readings": [
          "Both give options; the plaintiff may choose among all places",
          "Law 90-04 art. 24 specific, so conclusion place is not available"
        ]
      },
      {
        "question": "A partial agreement (art. 31 para 1): is a non-conciliation record issued for the rest and does the 6-month period run?",
        "readings": [
          "A record of partial conciliation is issued and the remainder needs a non-conciliation record",
          "Texts silent"
        ]
      },
      {
        "question": "Date for the first hearing: from filing (cpca 505) or from sending the petition (labour-disputes 38)?",
        "readings": [
          "Filing date",
          "Date the petition is directed to the court"
        ]
      }
    ],
