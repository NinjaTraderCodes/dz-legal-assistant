---
// "Test it in 5 minutes": the full guide to the live demo, for the ThirdUni judges first. The home's folder 05 shows
// the demo's own guide at each of the same five steps (GuideReel.astro).
import Base from "../../layouts/Base.astro";
import TryGuide from "../../components/TryGuide.astro";
import Lightbox from "../../components/Lightbox.astro";
import { langs, t, type Lang } from "../../i18n";

export function getStaticPaths() {
    return langs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
---
<Base lang={lang} title={t(lang, "try.title")} description={t(lang, "meta.try.description")} path="/try/" og="try" folder={{ tone: "blue", tab: t(lang, "try.eyebrow") }}>
    <TryGuide lang={lang} heading="h1" />
    <Lightbox lang={lang} />
</Base>
