<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>DzLegalAssistant</AssemblyName>
    <RootNamespace>DzLegal.App</RootNamespace>
    <Description>Desktop shell: guided case form, draft editor and compliance report. Runs fully offline.</Description>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <IncludeLegalData>true</IncludeLegalData>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- The generated P/Invoke for the Windows power state (Services/WindowsPowerStatus.cs). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- Shared Arabic fonts (also embedded in PDFs by DzLegal.Documents). -->
    <AvaloniaResource Include="..\..\assets\fonts\*.ttf" Link="Assets\Fonts\%(Filename)%(Extension)" />
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\DzLegal.Web\Samples\debt.json" Link="Samples\debt.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Personal overrides, git-ignored; copied next to the executable when present. -->
    <None Update="appsettings.local.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="FluentIcons.Avalonia" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DzLegal.Documents\DzLegal.Documents.csproj" />
    <ProjectReference Include="..\DzLegal.Drafting\DzLegal.Drafting.csproj" />
    <ProjectReference Include="..\DzLegal.FormEngine\DzLegal.FormEngine.csproj" />
    <ProjectReference Include="..\DzLegal.Law\DzLegal.Law.csproj" />
    <ProjectReference Include="..\DzLegal.ModelProviders.Ollama\DzLegal.ModelProviders.Ollama.csproj" />
    <ProjectReference Include="..\DzLegal.ModelProviders.Stub\DzLegal.ModelProviders.Stub.csproj" />
    <ProjectReference Include="..\DzLegal.Presentation\DzLegal.Presentation.csproj" />
    <ProjectReference Include="..\DzLegal.Storage\DzLegal.Storage.csproj" />
  </ItemGroup>
  <!--
    TEMPORARY, for testing only (docs/ONLINE-TESTING.md): `dotnet run -p:OnlineTesting=true` adds an online engine
    (OpenRouter) next to the local one, to measure the AI on many runs. The normal build and the package for a lawyer
    never include it: no case data leaves the computer. OfflineGuaranteeTests checks that this stays conditional.
  -->
  <PropertyGroup Condition="'$(OnlineTesting)' == 'true'">
    <DefineConstants>$(DefineConstants);ONLINE_TESTING</DefineConstants>
    <!-- Its own folders, so a normal build never picks up code compiled for the testing build. -->
    <OutputPath>bin\$(Configuration)-online\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)-online\</IntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(OnlineTesting)' == 'true'">
    <ProjectReference Include="..\DzLegal.ModelProviders.Hosted\DzLegal.ModelProviders.Hosted.csproj" />
  </ItemGroup>
  <!-- The testing build must never become a package for a lawyer: publishing it fails. -->
  <Target Name="RefuseToPublishTheOnlineTestingBuild" BeforeTargets="PrepareForPublish" Condition="'$(OnlineTesting)' == 'true'">
    <Error Text="Refusing to publish with -p:OnlineTesting=true: that build can send case data to OpenRouter (docs/ONLINE-TESTING.md). Publish without it." />
  </Target>
  <ItemGroup>
    <Using Include="DzLegal.Presentation" />
    <Using Include="DzLegal.Presentation.Services" />
    <Using Include="DzLegal.Presentation.ViewModels" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DzLegal.App.Tests" />
  </ItemGroup>
</Project>
