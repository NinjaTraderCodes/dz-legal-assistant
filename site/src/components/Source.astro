---
// The line under a figure or a claim: where it comes from. The callers name the repository files behind it, so the
// code keeps the trail, but the site shows only the documents it renders as its own pages (src/content/docs-pages.ts),
// by their titles: it neither links nor names anything else of the repository. With no such page, there is no line.
import { t, type Lang } from "../i18n";
import { isDocPage, docPath } from "../content/docs-pages";

interface Props { lang: Lang; files: string[]; note?: string }
const { lang, files, note } = Astro.props;
const pages = files.filter(isDocPage);
const separator = lang === "ar" ? "، " : ", ";
---
{(pages.length > 0 || note) && <p class="source caption">{t(lang, "source.label")} {pages.map((file, i) => <><a class="file" href={`/${lang}${docPath(file)}`}>{t(lang, `doc.${file.slice("docs/".length, -".md".length)}`)}</a>{i < pages.length - 1 ? separator : ""}</>)}{note && <>{pages.length > 0 ? " · " : ""}{note}</>}</p>}

<style>
    .source { margin-top: 6px; }
    .source .file { color: var(--w-muted); text-decoration: underline; overflow-wrap: anywhere; }
</style>
