@using DzLegal.Presentation.ViewModels
@* One section of the requête on paper. Generated sections follow the form; narrative ones are written by the model and
   stay editable. Same view model as the desktop editor. *@
<div class="section @(Section.IsWriting ? "writing" : "")">
    <div class="section-head" dir="@(Vm.IsRightToLeft ? "rtl" : "ltr")" lang="@Vm.L.Language">
        <span class="title">@Section.Title</span>
        @if (Section.IsWriting)
        {
            <span class="writing-mark"><span class="pulse"></span> @Vm.L["SectionWriting"]</span>
        }
        else if (Section.IsLocked)
        {
            <span class="origin"><Icon Name="lock_closed" Size="12" /> @Section.Hint</span>
        }
        else if (Section.IsEditable)
        {
            <span class="origin ai"><Icon Name="sparkle" Size="12" /> @Section.Hint</span>
        }
        else
        {
            <span class="origin">@Section.Hint</span>
        }
        <span class="actions">
            @if (Section.CanOverride)
            {
                <button type="button" class="link" @onclick="() => Section.OverrideCommand.Execute(null)"><Icon Name="edit" Size="14" /> @Vm.L["EditManually"]</button>
            }
            @if (Section.IsOverridden)
            {
                <button type="button" class="link" @onclick="() => Section.RestoreCommand.Execute(null)">@Vm.L["RestoreFromForm"]</button>
            }
            @if (Section.IsEditable)
            {
                @if (Section.CanUndo)
                {
                    <button type="button" class="link" @onclick="() => Section.UndoCommand.Execute(null)"><Icon Name="arrow_undo" Size="14" /> @Vm.L["Undo"]</button>
                }
                <button type="button" class="link" disabled="@CommandRunner.IsAiBusy(Vm)" @onclick="() => CommandRunner.RunAsync(Vm, Section.RedraftCommand)"><Icon Name="arrow_clockwise" Size="14" /> @Vm.L["Redraft"]</button>
                <button type="button" class="link" @onclick="() => Section.OpenAssistantCommand.Execute(null)"><Icon Name="sparkle" Size="14" /> @Vm.L["Assistant"]</button>
            }
        </span>
    </div>
    @if (Section.IsConfirmingRedraft)
    {
        <div class="confirm" dir="@(Vm.IsRightToLeft ? "rtl" : "ltr")" lang="@Vm.L.Language">
            <button type="button" class="primary small" @onclick="() => CommandRunner.RunAsync(Vm, Section.RedraftCommand)">@Vm.L["ConfirmRedraft"]</button>
            <button type="button" class="small" @onclick="() => Section.CancelRedraftCommand.Execute(null)">@Vm.L["Cancel"]</button>
        </div>
    }
    @if (Section.IsReadOnly)
    {
        <div class="section-text">@Section.Text</div>
    }
    else
    {
        <textarea class="section-text" dir="rtl" rows="@Rows" maxlength="12000" aria-label="@Section.Title" placeholder="@Section.Watermark" @bind="Section.Text" @bind:event="oninput"></textarea>
    }
    @if (Section.HasReview)
    {
        <div class="review" dir="@(Vm.IsRightToLeft ? "rtl" : "ltr")" lang="@Vm.L.Language">@Section.ReviewText</div>
    }
    @if (Section.IsAiWritten)
    {
        <label class="check small reviewed"><input type="checkbox" @bind="Section.IsReviewed" /> @Vm.L["ReviewedCheck"]</label>
    }
</div>

@code {
    [Parameter, EditorRequired] public SectionViewModel Section { get; set; } = default!;

    [Parameter, EditorRequired] public MainWindowViewModel Vm { get; set; } = default!;

    // Enough rows for the text (about 70 characters a line on the paper), so it reads like a page.
    private int Rows => Math.Max(3, Section.Text.Split('\n').Sum(l => 1 + l.Length / 70));
}
