---
// What the software guarantees, inside the proof folder (AiPanel.astro): one sheet listing the four guarantees as
// numbered entries, with two pieces of the app attached beside it, drawn in HTML (AppPiece.astro: the law library's
// card from law.generated.json, and the refused-export notice). The offline badge and the drafted grounds are shown
// elsewhere on the home (the hero's stamp, the story's paper), so they are not attached a second time.
import Clip from "./Clip.astro";
import AppPiece from "./AppPiece.astro";
import Source from "./Source.astro";
import { groundsTitle } from "../content/steps";
import { s, t, fmt, type Lang } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const groundsHeading = groundsTitle[lang];
const items = [
    { title: t(lang, "proofs.texts.title"), body: fmt(s(lang, "AboutSources"), "1,361", "6") + " " + t(lang, "proofs.texts.body") },
    { title: t(lang, "proofs.offline.title"), body: t(lang, "proofs.offline.body") },
    { title: t(lang, "proofs.review.title"), body: t(lang, "proofs.review.body") },
    { title: t(lang, "proofs.grounds.title"), body: t(lang, "proofs.grounds.body") },
];
---
<div class="guarantees">
    <div class="sheet list">
        <Clip />
        <h3 id="proofs-title" class="list-title">{t(lang, "proofs.title")}</h3>
        <ol>
            {items.map((item, i) => (
                <li>
                    <span class="reg-no">{String(i + 1).padStart(2, "0")}</span>
                    <div><strong>{item.title}</strong><p>{item.body}</p></div>
                </li>
            ))}
        </ol>
        <Source lang={lang} files={["README.md", "docs/PRODUCT-DETAILS.md", "docs/OFFLINE.md", "data/law/codes"]} />
    </div>
    <div class="attached">
        <AppPiece lang={lang} kind="library" caption={t(lang, "proofs.shot.texts")} replicaNote={false} />
        <AppPiece lang={lang} kind="export" section={groundsHeading} caption={t(lang, "proofs.shot.review")} replicaNote={false} />
        <p class="caption">{t(lang, "proofs.replica")}</p>
    </div>
</div>

<style>
    .guarantees { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); gap: clamp(24px, 3.5vw, 48px); align-items: start; }
    .list { display: grid; gap: 14px; padding: 30px 30px 24px; }
    .list-title { font-size: 0.9rem; font-weight: 600; color: var(--w-sheet-muted); padding-bottom: 10px; border-bottom: 2px solid var(--w-sheet-text); }
    .list ol { list-style: none; margin: 0; padding: 0; }
    .list li { display: grid; grid-template-columns: 2.4em minmax(0, 1fr); gap: 4px 10px; padding-block: 14px; border-bottom: 1px solid var(--w-sheet-rule); }
    .list li .reg-no { padding-top: 3px; }
    .list strong { display: block; margin-bottom: 4px; font-size: 1.02rem; }
    .list li p { font-size: 0.93rem; max-width: none; }
    .attached { display: grid; gap: 18px; padding-top: 28px; }
    @media (max-width: 899px) { .guarantees { grid-template-columns: 1fr; } .attached { padding-top: 0; } }
</style>
