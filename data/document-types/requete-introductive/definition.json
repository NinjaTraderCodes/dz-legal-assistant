// Requête introductive d'instance — عريضة افتتاح الدعوى
// Legal basis: Loi n° 08-09 (CPCA), as amended. Every element carries "verified": false until a
// practicing lawyer confirms it against the current official text (see docs/UPDATING-LEGAL-RULES.md).
{
  "id": "requete-introductive",
  "version": "0.9.4",
  "name": { "ar": "عريضة افتتاح الدعوى", "en": "Statement of claim (requête introductive d'instance)" },
  "description": {
    "ar": "العريضة التي ترفع بها الدعوى أمام المحكمة (المواد 14 و15 و17 من قانون الإجراءات المدنية والإدارية).",
    "en": "The document that opens a case before the court (CPCA arts. 14, 15 and 17)."
  },
  "systemPrompt": "prompts/system.ar.txt",
  "revisionPrompt": "prompts/revise.ar.txt",
  "formaliseRequestsPrompt": "prompts/formalise-requests.ar.txt",
  "revisionShortcuts": [
    { "label": { "ar": "أكثر رسمية", "en": "More formal" }, "instruction": "اجعل الصياغة أكثر رسمية وفق أسلوب العرائض أمام المحاكم الجزائرية." },
    { "label": { "ar": "أوجز", "en": "Shorter" }, "instruction": "اختصر النص مع الإبقاء على كل الوقائع والمواد والأرقام." },
    { "label": { "ar": "صحح اللغة", "en": "Fix grammar" }, "instruction": "صحح الأخطاء النحوية والإملائية فقط دون تغيير المعنى." },
    { "label": { "ar": "اربط كل مادة بطلبها", "en": "Tie each article to its request" }, "instruction": "اختم كل فقرة بربط المادة المذكورة فيها بالطلب الذي تؤسسه." },
    { "label": { "ar": "لا تكرر الخاتمة", "en": "Vary the closing" }, "instruction": "لا تكرر العبارة الختامية نفسها في كل فقرة؛ نوّع الصياغة." }
  ],

  // Exact fixes applied to model-written text only (grounds, requests), never to the lawyer's own words.
  // The noun after «إنّ» is accusative: small models write the nominative dual.
  "corrections": [
    { "find": "إن المادتان", "replace": "إن المادتين" },
    // «وطبق المادة» seen in the argued-grounds sample (Week 2).
    { "find": "وطبق المادة", "replace": "وطبقا للمادة" },
    { "find": "لمضمون المادة", "replace": "للمادة" },
    { "find": "ضمن مضمون المادة", "replace": "ضمن حكم المادة" },
    { "find": "إن الطرفان", "replace": "إن الطرفين" },
    { "find": "إن المدعيان", "replace": "إن المدعيين" },
    // «امتنان» (gratitude) written for «امتناع» (refusal), seen in bench4.
    { "find": "امتنانه بالسداد", "replace": "امتناعه عن السداد" },
    { "find": "امتنانه عن", "replace": "امتناعه عن" },
    { "find": "امتنانها عن", "replace": "امتناعها عن" }
  ],

  // Legal qualifications model text may use only if the lawyer's inputs contain them; otherwise they are
  // flagged («عقد المقاولة» was invented in a loan case). Add terms here as lawyers report new inventions.
  "groundedTerms": [
    "عقد المقاولة", "عقد البيع", "عقد الإيجار", "عقد الوديعة", "عقد الوكالة", "عقد العمل", "عقد الشركة",
    "عقد التأمين", "عقد الهبة", "عقد القرض", "العقد التجاري",
    "المسؤولية التقصيرية", "المسؤولية العقدية", "التدليس", "الغلط", "الإكراه", "الغبن", "التقادم", "الفسخ", "البطلان"
  ],

  "fieldGroups": [
    { "id": "court", "label": { "ar": "الجهة القضائية", "en": "Court" } },
    { "id": "plaintiff", "label": { "ar": "المدعي", "en": "Plaintiff" } },
    { "id": "defendant", "label": { "ar": "المدعى عليه", "en": "Defendant" } },
    { "id": "claim", "label": { "ar": "موضوع الدعوى", "en": "Claim" } },
    { "id": "facts", "label": { "ar": "الوقائع", "en": "Facts" } },
    { "id": "grounds", "label": { "ar": "الأسانيد القانونية", "en": "Legal grounds" } },
    { "id": "requests", "label": { "ar": "الطلبات", "en": "Requests" } },
    { "id": "documents", "label": { "ar": "المستندات", "en": "Supporting documents" } },
    { "id": "signature", "label": { "ar": "التاريخ والتوقيع", "en": "Date and signature" } }
  ],

  "fields": [
    { "id": "court.council", "group": "court", "label": { "ar": "المجلس القضائي", "en": "Judicial council (cour)" }, "hint": { "ar": "مثال: الجزائر", "en": "e.g. Alger" } },
    { "id": "court.name", "group": "court", "label": { "ar": "المحكمة", "en": "Court (tribunal)" }, "hint": { "ar": "مثال: محكمة سيدي امحمد", "en": "e.g. Tribunal de Sidi M'Hamed" } },
    { "id": "court.section", "group": "court", "label": { "ar": "القسم", "en": "Section" }, "hint": { "ar": "مثال: القسم المدني", "en": "e.g. civil section" } },

    { "id": "plaintiff.isLegalEntity", "group": "plaintiff", "kind": "boolean", "default": "false", "label": { "ar": "المدعي شخص معنوي", "en": "Plaintiff is a legal person" } },
    { "id": "plaintiff.lastName", "group": "plaintiff", "label": { "ar": "اللقب", "en": "Surname" }, "visibleWhen": [ { "field": "plaintiff.isLegalEntity", "isNot": "true" } ] },
    { "id": "plaintiff.firstName", "group": "plaintiff", "label": { "ar": "الاسم", "en": "First name(s)" }, "visibleWhen": [ { "field": "plaintiff.isLegalEntity", "isNot": "true" } ] },
    { "id": "plaintiff.gender", "group": "plaintiff", "kind": "choice", "label": { "ar": "الجنس", "en": "Gender" }, "options": [ { "value": "male", "label": { "ar": "ذكر", "en": "Male" } }, { "value": "female", "label": { "ar": "أنثى", "en": "Female" } } ], "visibleWhen": [ { "field": "plaintiff.isLegalEntity", "isNot": "true" } ] },
    { "id": "plaintiff.profession", "group": "plaintiff", "label": { "ar": "المهنة", "en": "Occupation" }, "visibleWhen": [ { "field": "plaintiff.isLegalEntity", "isNot": "true" } ] },
    { "id": "plaintiff.domicile", "group": "plaintiff", "label": { "ar": "الموطن", "en": "Domicile" }, "visibleWhen": [ { "field": "plaintiff.isLegalEntity", "isNot": "true" } ] },
    { "id": "plaintiff.entityName", "group": "plaintiff", "label": { "ar": "تسمية الشخص المعنوي", "en": "Name of the legal person" }, "visibleWhen": [ { "field": "plaintiff.isLegalEntity", "is": "true" } ] },
    { "id": "plaintiff.entityNature", "group": "plaintiff", "label": { "ar": "طبيعته (شكله القانوني)", "en": "Nature (legal form)" }, "hint": { "ar": "مثال: شركة ذات مسؤولية محدودة", "en": "e.g. SARL" }, "visibleWhen": [ { "field": "plaintiff.isLegalEntity", "is": "true" } ] },
    { "id": "plaintiff.headOffice", "group": "plaintiff", "label": { "ar": "المقر الاجتماعي", "en": "Registered office" }, "visibleWhen": [ { "field": "plaintiff.isLegalEntity", "is": "true" } ] },
    { "id": "plaintiff.representativeName", "group": "plaintiff", "label": { "ar": "اسم الممثل", "en": "Representative's name" }, "visibleWhen": [ { "field": "plaintiff.isLegalEntity", "is": "true" } ] },
    { "id": "plaintiff.representativeCapacity", "group": "plaintiff", "label": { "ar": "صفة الممثل القانوني أو الاتفاقي", "en": "Capacity of the legal or contractual representative" }, "hint": { "ar": "مثال: المسير", "en": "e.g. gérant" }, "visibleWhen": [ { "field": "plaintiff.isLegalEntity", "is": "true" } ] },

    { "id": "defendant.isLegalEntity", "group": "defendant", "kind": "boolean", "default": "false", "label": { "ar": "المدعى عليه شخص معنوي", "en": "Defendant is a legal person" } },
    { "id": "defendant.lastName", "group": "defendant", "label": { "ar": "اللقب", "en": "Surname" }, "visibleWhen": [ { "field": "defendant.isLegalEntity", "isNot": "true" } ] },
    { "id": "defendant.firstName", "group": "defendant", "label": { "ar": "الاسم", "en": "First name(s)" }, "visibleWhen": [ { "field": "defendant.isLegalEntity", "isNot": "true" } ] },
    { "id": "defendant.gender", "group": "defendant", "kind": "choice", "label": { "ar": "الجنس", "en": "Gender" }, "options": [ { "value": "male", "label": { "ar": "ذكر", "en": "Male" } }, { "value": "female", "label": { "ar": "أنثى", "en": "Female" } } ], "visibleWhen": [ { "field": "defendant.isLegalEntity", "isNot": "true" } ] },
    { "id": "defendant.domicile", "group": "defendant", "label": { "ar": "الموطن", "en": "Domicile" }, "visibleWhen": [ { "field": "defendant.isLegalEntity", "isNot": "true" } ] },
    { "id": "defendant.lastKnownDomicile", "group": "defendant", "label": { "ar": "آخر موطن معلوم (إن لم يكن له موطن معلوم)", "en": "Last known domicile (if domicile unknown)" }, "visibleWhen": [ { "field": "defendant.isLegalEntity", "isNot": "true" } ] },
    { "id": "defendant.entityName", "group": "defendant", "label": { "ar": "تسمية الشخص المعنوي", "en": "Name of the legal person" }, "visibleWhen": [ { "field": "defendant.isLegalEntity", "is": "true" } ] },
    { "id": "defendant.entityNature", "group": "defendant", "label": { "ar": "طبيعته (شكله القانوني)", "en": "Nature (legal form)" }, "visibleWhen": [ { "field": "defendant.isLegalEntity", "is": "true" } ] },
    { "id": "defendant.headOffice", "group": "defendant", "label": { "ar": "المقر الاجتماعي", "en": "Registered office" }, "visibleWhen": [ { "field": "defendant.isLegalEntity", "is": "true" } ] },
    { "id": "defendant.representativeName", "group": "defendant", "label": { "ar": "اسم الممثل", "en": "Representative's name" }, "visibleWhen": [ { "field": "defendant.isLegalEntity", "is": "true" } ] },
    { "id": "defendant.representativeCapacity", "group": "defendant", "label": { "ar": "صفة الممثل القانوني أو الاتفاقي", "en": "Capacity of the legal or contractual representative" }, "visibleWhen": [ { "field": "defendant.isLegalEntity", "is": "true" } ] },

    { "id": "claim.subject", "group": "claim", "label": { "ar": "موضوع الدعوى", "en": "Subject of the claim" }, "hint": { "ar": "مثال: المطالبة بدين", "en": "e.g. recovery of a debt" } },
    { "id": "claim.concernsRegisteredRealProperty", "group": "claim", "kind": "boolean", "default": "false", "label": { "ar": "الدعوى تتعلق بعقار أو حق عيني عقاري مشهر", "en": "Claim concerns registered real property or a real right" } },
    { "id": "claim.publicationReference", "group": "claim", "label": { "ar": "مراجع إشهار العريضة لدى المحافظة العقارية", "en": "Publication reference at the land registry (conservation foncière)" }, "visibleWhen": [ { "field": "claim.concernsRegisteredRealProperty", "is": "true" } ] },

    { "id": "notes.facts", "group": "facts", "kind": "multilineText", "label": { "ar": "الوقائع", "en": "Facts" }, "hint": { "ar": "اكتب الوقائع بالعربية الفصحى، جملة في كل سطر؛ تدرج كما هي", "en": "Facts in formal Arabic, one sentence per line; used as written" } },
    { "id": "notes.grounds", "group": "grounds", "kind": "multilineText", "label": { "ar": "حججك الإضافية (اختياري)", "en": "Your own arguments (optional)" }, "hint": { "ar": "حجج أو مواد أخرى تريد إضافتها إلى المواد المعتمدة أعلاه", "en": "Other arguments or articles to add to the selected articles above" } },
    { "id": "notes.requests", "group": "requests", "kind": "multilineText", "label": { "ar": "الطلبات", "en": "Requests" }, "hint": { "ar": "ما تلتمسه من المحكمة", "en": "What you ask the court for" } },

    { "id": "documents.list", "group": "documents", "kind": "multilineText", "label": { "ar": "المستندات المؤيدة للدعوى (مستند في كل سطر)", "en": "Supporting documents (one per line)" } },

    { "id": "lawyer.name", "group": "signature", "label": { "ar": "اسم المحامي", "en": "Lawyer's name" } },
    { "id": "lawyer.gender", "group": "signature", "kind": "choice", "label": { "ar": "المحامي / المحامية", "en": "Lawyer's gender" }, "options": [ { "value": "male", "label": { "ar": "ذكر", "en": "Male" } }, { "value": "female", "label": { "ar": "أنثى", "en": "Female" } } ] },
    { "id": "lawyer.bar", "group": "signature", "label": { "ar": "صفة المحامي", "en": "Lawyer's standing" }, "hint": { "ar": "مثال: محامٍ لدى مجلس قضاء الجزائر", "en": "e.g. avocat à la Cour d'Alger" } },
    { "id": "lawyer.address", "group": "signature", "label": { "ar": "عنوان مكتب المحامي", "en": "Lawyer's office address" } },
    { "id": "document.place", "group": "signature", "label": { "ar": "مكان التحرير", "en": "Place of drafting" } },
    { "id": "document.date", "group": "signature", "kind": "date", "default": "today", "label": { "ar": "تاريخ التحرير", "en": "Date" }, "hint": { "ar": "يوم/شهر/سنة", "en": "dd/mm/yyyy" } }
  ],

  "sections": [
    { "id": "header", "formGroup": "court", "layout": { "align": "center", "bold": true, "size": 14, "spaceBefore": 0 }, "kind": "generated", "template": "templates/header.scriban", "title": { "ar": "الجهة القضائية", "en": "Court" } },
    { "id": "plaintiff", "formGroup": "plaintiff", "layout": { "align": "start", "spaceBefore": 14 }, "kind": "generated", "template": "templates/plaintiff.scriban", "title": { "ar": "المدعي", "en": "Plaintiff" },
      "hints": [ { "when": [ { "field": "plaintiff.gender", "is": "" }, { "field": "plaintiff.isLegalEntity", "isNot": "true" } ], "message": { "ar": "اختر جنس المدعي في الاستمارة لضبط الصيغة (السيد/السيدة، المدعي/المدعية).", "en": "Choose the plaintiff's gender in the form so the wording agrees." } } ] },
    { "id": "defendant", "formGroup": "defendant", "layout": { "align": "start", "spaceBefore": 8 }, "kind": "generated", "template": "templates/defendant.scriban", "title": { "ar": "المدعى عليه", "en": "Defendant" },
      "hints": [ { "when": [ { "field": "defendant.gender", "is": "" }, { "field": "defendant.isLegalEntity", "isNot": "true" } ], "message": { "ar": "اختر جنس المدعى عليه في الاستمارة لضبط الصيغة.", "en": "Choose the defendant's gender in the form so the wording agrees." } } ] },
    { "id": "subject", "formGroup": "claim", "layout": { "align": "start", "bold": true, "spaceBefore": 10 }, "kind": "generated", "template": "templates/subject.scriban", "title": { "ar": "الموضوع", "en": "Subject" } },
    { "id": "publication", "formGroup": "claim", "layout": { "align": "start", "spaceBefore": 6 }, "kind": "generated", "template": "templates/publication.scriban", "title": { "ar": "الإشهار العقاري", "en": "Land-registry publication" },
      "includeWhen": [ { "field": "claim.concernsRegisteredRealProperty", "is": "true" } ] },
    { "id": "opening", "formGroup": "court", "layout": { "align": "center", "bold": true, "spaceBefore": 14 }, "kind": "generated", "template": "templates/opening.scriban", "title": { "ar": "الافتتاح", "en": "Opening" } },
    { "id": "facts", "formGroup": "facts", "layout": { "align": "justify", "spaceBefore": 12 }, "kind": "generated", "template": "templates/facts.scriban", "showTitle": true, "title": { "ar": "الوقائع", "en": "Facts" } },
    { "id": "grounds", "formGroup": "grounds", "layout": { "align": "justify", "spaceBefore": 12 }, "kind": "narrative", "prompt": "prompts/grounds.ar.txt", "argumentPrompt": "prompts/grounds-argued.ar.txt", "sourceField": "notes.grounds", "maxTokens": 900, "showTitle": true, "title": { "ar": "المناقشة القانونية", "en": "Legal grounds" } },
    { "id": "requestsIntro", "formGroup": "requests", "layout": { "align": "start", "spaceBefore": 12 }, "kind": "generated", "template": "templates/requestsIntro.scriban", "showTitle": true, "title": { "ar": "لهذه الأسباب ومن أجلها", "en": "For these reasons" } },
    // Requests are the lawyer's own lines, numbered under the fixed formula: a model rewriting them changed the relief
    // asked of the court in 9 of 15 audited drafts (dropped requests, «أو» made «و», amounts in words ≠ digits).
    { "id": "requests", "formGroup": "requests", "layout": { "align": "start", "spaceBefore": 4 }, "kind": "generated", "template": "templates/requests.scriban", "title": { "ar": "الطلبات", "en": "Requests" } },
    { "id": "documents", "formGroup": "documents", "layout": { "align": "start", "spaceBefore": 12 }, "kind": "generated", "template": "templates/documents.scriban", "showTitle": true, "title": { "ar": "قائمة المرفقات", "en": "Supporting documents" } },
    { "id": "dateplace", "formGroup": "signature", "layout": { "align": "end", "spaceBefore": 18 }, "kind": "generated", "template": "templates/dateplace.scriban", "title": { "ar": "التاريخ", "en": "Date" } },
    { "id": "signature", "formGroup": "signature", "layout": { "align": "end", "bold": true, "spaceBefore": 6 }, "kind": "generated", "template": "templates/signature.scriban", "title": { "ar": "التوقيع", "en": "Signature" },
      "hints": [ { "when": [ { "field": "lawyer.gender", "is": "" } ], "message": { "ar": "اختر في الاستمارة: المحامي أو المحامية (الأستاذ/الأستاذة).", "en": "Choose the lawyer's gender in the form (الأستاذ/الأستاذة)." } } ] }
  ],

  "elements": [
    {
      "id": "art15.1.court",
      "article": "CPCA art. 15-1",
      "label": { "ar": "الجهة القضائية التي ترفع أمامها الدعوى", "en": "Court before which the action is brought" },
      "check": { "kind": "allOf", "checks": [
        { "kind": "fieldsPresent", "fields": [ "court.name" ] },
        { "kind": "sectionNotEmpty", "section": "header" } ] },
      "missingMessage": { "ar": "لم تحدد الجهة القضائية التي ترفع أمامها الدعوى — العريضة معرضة لعدم القبول شكلا.", "en": "The court is not identified — the requête would be inadmissible in form." },
      "verified": false,
      "sourceNote": "Art. 15 item 1, Loi 08-09."
    },
    {
      "id": "art15.2.plaintiff",
      "article": "CPCA art. 15-2",
      "label": { "ar": "اسم ولقب المدعي وموطنه", "en": "Plaintiff's name, surname and domicile" },
      "appliesWhen": [ { "field": "plaintiff.isLegalEntity", "isNot": "true" } ],
      "check": { "kind": "fieldsPresent", "fields": [ "plaintiff.lastName", "plaintiff.firstName", "plaintiff.domicile" ] },
      "missingMessage": { "ar": "بيانات المدعي (الاسم أو اللقب أو الموطن) ناقصة — العريضة معرضة لعدم القبول شكلا.", "en": "Plaintiff's name, surname or domicile is missing — inadmissible in form." },
      "verified": false,
      "sourceNote": "Art. 15 item 2. For a legal-person plaintiff, item 4 applies instead."
    },
    {
      "id": "art15.3.defendant",
      "article": "CPCA art. 15-3",
      "label": { "ar": "اسم ولقب وموطن المدعى عليه، أو آخر موطن له", "en": "Defendant's name, surname and domicile (or last known domicile)" },
      "appliesWhen": [ { "field": "defendant.isLegalEntity", "isNot": "true" } ],
      "check": { "kind": "allOf", "checks": [
        { "kind": "fieldsPresent", "fields": [ "defendant.lastName", "defendant.firstName" ] },
        { "kind": "anyOf", "checks": [
          { "kind": "fieldsPresent", "fields": [ "defendant.domicile" ] },
          { "kind": "fieldsPresent", "fields": [ "defendant.lastKnownDomicile" ] } ] } ] },
      "missingMessage": { "ar": "بيانات المدعى عليه (الاسم أو اللقب أو الموطن أو آخر موطن معلوم) ناقصة — العريضة معرضة لعدم القبول شكلا.", "en": "Defendant's name, surname or (last known) domicile is missing — inadmissible in form." },
      "verified": false,
      "sourceNote": "Art. 15 item 3: if the defendant has no known domicile, the last known domicile suffices."
    },
    {
      "id": "art15.4.plaintiff",
      "article": "CPCA art. 15-4",
      "label": { "ar": "تسمية وطبيعة الشخص المعنوي المدعي ومقره الاجتماعي وصفة ممثله", "en": "Legal-person plaintiff: name, nature, registered office, representative's capacity" },
      "appliesWhen": [ { "field": "plaintiff.isLegalEntity", "is": "true" } ],
      "check": { "kind": "fieldsPresent", "fields": [ "plaintiff.entityName", "plaintiff.entityNature", "plaintiff.headOffice", "plaintiff.representativeCapacity" ] },
      "missingMessage": { "ar": "بيانات الشخص المعنوي المدعي ناقصة (التسمية أو الطبيعة أو المقر الاجتماعي أو صفة الممثل) — العريضة معرضة لعدم القبول شكلا.", "en": "Legal-person plaintiff details are incomplete — inadmissible in form." },
      "verified": false,
      "sourceNote": "Art. 15 item 4. Confirm whether the representative's name is also expected in practice."
    },
    {
      "id": "art15.4.defendant",
      "article": "CPCA art. 15-4",
      "label": { "ar": "تسمية وطبيعة الشخص المعنوي المدعى عليه ومقره الاجتماعي وصفة ممثله", "en": "Legal-person defendant: name, nature, registered office, representative's capacity" },
      "appliesWhen": [ { "field": "defendant.isLegalEntity", "is": "true" } ],
      "check": { "kind": "fieldsPresent", "fields": [ "defendant.entityName", "defendant.entityNature", "defendant.headOffice", "defendant.representativeCapacity" ] },
      "missingMessage": { "ar": "بيانات الشخص المعنوي المدعى عليه ناقصة (التسمية أو الطبيعة أو المقر الاجتماعي أو صفة الممثل) — العريضة معرضة لعدم القبول شكلا.", "en": "Legal-person defendant details are incomplete — inadmissible in form." },
      "verified": false,
      "sourceNote": "Art. 15 item 4."
    },
    {
      "id": "art15.5.facts",
      "article": "CPCA art. 15-5",
      "label": { "ar": "عرض موجز للوقائع", "en": "Summary of the facts" },
      "check": { "kind": "sectionNotEmpty", "section": "facts" },
