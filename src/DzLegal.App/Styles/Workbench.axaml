<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="WelcomeGoldBrush" Color="#C6A76D" />
      <SolidColorBrush x:Key="WelcomeButtonTextBrush" Color="#28231D" />
      <!-- Dimensions shared with the Welcome/setup/Home family; Help and tour reference these directly. -->
      <x:Double x:Key="OnboardingWindowWidth">1366</x:Double>
      <x:Double x:Key="OnboardingWindowHeight">768</x:Double>
      <x:Double x:Key="OnboardingWindowMinWidth">800</x:Double>
      <x:Double x:Key="OnboardingWindowMinHeight">560</x:Double>
      <Thickness x:Key="OnboardingPageMargin">32,20</Thickness>
      <Thickness x:Key="OnboardingCardPadding">20,16</Thickness>
      <Thickness x:Key="OnboardingHeaderPadding">16,8</Thickness>
      <Thickness x:Key="OnboardingIconPadding">4</Thickness>
      <Thickness x:Key="OnboardingDialogPadding">28</Thickness>
      <Thickness x:Key="OnboardingButtonPadding">16,8</Thickness>
      <Thickness x:Key="OnboardingRowMargin">0,0,0,10</Thickness>
      <Thickness x:Key="OnboardingActionMargin">0,0,8,8</Thickness>
      <Thickness x:Key="OnboardingParagraphMargin">0,0,0,20</Thickness>
      <Thickness x:Key="OnboardingEdgeThickness">1</Thickness>
      <Thickness x:Key="OnboardingFocusThickness">3</Thickness>
      <CornerRadius x:Key="OnboardingCardRadius">16</CornerRadius>
      <CornerRadius x:Key="OnboardingButtonRadius">10</CornerRadius>
      <x:Double x:Key="OnboardingPageGap">12</x:Double>
      <x:Double x:Key="OnboardingDialogGap">20</x:Double>
      <x:Double x:Key="OnboardingTitleSize">26</x:Double>
      <x:Double x:Key="OnboardingBodySize">16</x:Double>
      <x:Double x:Key="OnboardingBodyLineHeight">29</x:Double>
      <x:Double x:Key="OnboardingSecondarySize">13</x:Double>
      <x:Double x:Key="OnboardingButtonSize">15</x:Double>
      <x:Double x:Key="OnboardingButtonHeight">44</x:Double>
      <x:Double x:Key="OnboardingPrimaryMinWidth">112</x:Double>
      <x:Double x:Key="OnboardingContentWidth">1280</x:Double>
      <x:Double x:Key="OnboardingReadingWidth">820</x:Double>
      <x:Double x:Key="OnboardingDialogWidth">620</x:Double>
      <x:Double x:Key="OnboardingIconSize">20</x:Double>
      <x:Double x:Key="OnboardingBackgroundBlur">8</x:Double>
      <x:Double x:Key="OnboardingTourWidth">420</x:Double>
      <x:Double x:Key="OnboardingTourMinWidth">240</x:Double>
      <x:Double x:Key="OnboardingTourEdgeSpace">32</x:Double>
      <x:Double x:Key="OnboardingTourAnchorGap">16</x:Double>
      <!-- The tour dims the live workbench with the same dark overlay character as Home. -->
      <LinearGradientBrush x:Key="OnboardingTourBackdropBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#B81D201E" Offset="0" />
        <GradientStop Color="#B31D201E" Offset="0.5" />
        <GradientStop Color="#B81D201E" Offset="1" />
      </LinearGradientBrush>
      <StreamGeometry x:Key="WelcomeScalesGeometry">M48,9 L48,78 M43,9 C43,3 53,3 53,9 C53,15 43,15 43,9 M18,25 C28,25 34,18 48,18 C62,18 68,25 78,25 M23,25 L10,53 L36,53 Z M73,25 L60,53 L86,53 Z M10,53 C12,69 34,69 36,53 M60,53 C62,69 84,69 86,53 M42,78 L54,78 M38,85 C38,75 58,75 58,85 M28,88 L68,88</StreamGeometry>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="OnboardingHighlightBrush" Color="#C6A76D" />
          <SolidColorBrush x:Key="WelcomeReadingBrush" Color="Transparent" />
          <SolidColorBrush x:Key="WelcomeLanguageSurfaceBrush" Color="Transparent" />
          <LinearGradientBrush x:Key="WelcomeOverlayBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#B81D201E" Offset="0" />
            <GradientStop Color="#B31D201E" Offset="0.5" />
            <GradientStop Color="#B81D201E" Offset="1" />
          </LinearGradientBrush>
          <SolidColorBrush x:Key="WelcomeTextBrush" Color="#F2EDE5" />
          <SolidColorBrush x:Key="WelcomeSecondaryBrush" Color="#ECE6DC" />
          <SolidColorBrush x:Key="WelcomeControlBrush" Color="#24201B" />
          <SolidColorBrush x:Key="SetupSurfaceBrush" Color="#8024201B" />
          <SolidColorBrush x:Key="WelcomeEdgeBrush" Color="#D2B981" />
          <SolidColorBrush x:Key="WelcomeFocusBrush" Color="#F2EDE5" />
          <SolidColorBrush x:Key="WelcomeButtonBorderBrush" Color="#D2B981" />
          <SolidColorBrush x:Key="WelcomeMarkBrush" Color="#C6A76D" />
          <LinearGradientBrush x:Key="WelcomeLogoBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#D2B981" Offset="0" /><GradientStop Color="#C6A76D" Offset="1" />
          </LinearGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="OnboardingHighlightBrush" Color="#D2B981" />
          <SolidColorBrush x:Key="WelcomeReadingBrush" Color="#EFF2F0EA" />
          <SolidColorBrush x:Key="WelcomeLanguageSurfaceBrush" Color="Transparent" />
          <LinearGradientBrush x:Key="WelcomeOverlayBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#00F2F0EA" Offset="0" />
            <GradientStop Color="#00F2F0EA" Offset="0.84" />
            <GradientStop Color="#D9F2F0EA" Offset="0.93" />
            <GradientStop Color="#E5F2F0EA" Offset="1" />
          </LinearGradientBrush>
          <SolidColorBrush x:Key="WelcomeTextBrush" Color="#28231D" />
          <SolidColorBrush x:Key="WelcomeSecondaryBrush" Color="#494238" />
          <SolidColorBrush x:Key="WelcomeControlBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="SetupSurfaceBrush" Color="#CCFFFFFF" />
          <SolidColorBrush x:Key="WelcomeEdgeBrush" Color="#786039" />
          <SolidColorBrush x:Key="WelcomeFocusBrush" Color="#28231D" />
          <SolidColorBrush x:Key="WelcomeButtonBorderBrush" Color="#786039" />
          <SolidColorBrush x:Key="WelcomeMarkBrush" Color="#786039" />
          <LinearGradientBrush x:Key="WelcomeLogoBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#786039" Offset="0" /><GradientStop Color="#80663C" Offset="1" />
          </LinearGradientBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>
  <!-- Workbench's primary colour must be declared before the Home family so Home keeps its own gold. -->
  <Style Selector="Button.primary"><Setter Property="Foreground" Value="{DynamicResource PrimaryButtonTextBrush}" /></Style>
  <!-- Home's card, text and button treatment, shared so Help and the tour use the same family look. -->
  <Style Selector="Border.home-panel">
    <Setter Property="Background" Value="{DynamicResource SetupSurfaceBrush}" /><Setter Property="CornerRadius" Value="16" /><Setter Property="Padding" Value="20,16" />
  </Style>
  <Style Selector="TextBlock.home-text">
    <Setter Property="Foreground" Value="{DynamicResource WelcomeTextBrush}" /><Setter Property="FontSize" Value="16" /><Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.home-title">
    <Setter Property="Foreground" Value="{DynamicResource WelcomeTextBrush}" /><Setter Property="FontSize" Value="26" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.home-note">
    <Setter Property="Foreground" Value="{DynamicResource WelcomeSecondaryBrush}" /><Setter Property="FontSize" Value="13" /><Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Button.home">
    <Setter Property="ToolTip.ShowOnDisabled" Value="True" />
    <Setter Property="Background" Value="{DynamicResource WelcomeControlBrush}" /><Setter Property="Foreground" Value="{DynamicResource WelcomeTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WelcomeEdgeBrush}" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" /><Setter Property="MinHeight" Value="44" /><Setter Property="FontSize" Value="15" />
    <Setter Property="Padding" Value="16,8" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.home.selected"><Setter Property="BorderThickness" Value="2" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="Button.home.main-action">
    <Setter Property="Height" Value="58" /><Setter Property="MinHeight" Value="58" />
    <Setter Property="Background" Value="{DynamicResource WelcomeGoldBrush}" /><Setter Property="Foreground" Value="{DynamicResource WelcomeButtonTextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.home.primary">
    <Setter Property="Background" Value="{DynamicResource WelcomeGoldBrush}" /><Setter Property="Foreground" Value="{DynamicResource WelcomeButtonTextBrush}" /><Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.home:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource WelcomeFocusBrush}" /><Setter Property="BorderThickness" Value="3" />
  </Style>
  <Style Selector="Button.home:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource WelcomeControlBrush}" /><Setter Property="Foreground" Value="{DynamicResource WelcomeTextBrush}" />
  </Style>
  <Style Selector="Button.home.main-action:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource WelcomeGoldBrush}" /><Setter Property="Foreground" Value="{DynamicResource WelcomeButtonTextBrush}" />
  </Style>
  <Style Selector="Button.home.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource WelcomeGoldBrush}" /><Setter Property="Foreground" Value="{DynamicResource WelcomeButtonTextBrush}" />
  </Style>
  <Style Selector="Button.home:disabled">
    <Setter Property="BorderBrush" Value="{DynamicResource WelcomeEdgeBrush}" /><Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.home:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource WelcomeControlBrush}" /><Setter Property="Foreground" Value="{DynamicResource WelcomeSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WelcomeEdgeBrush}" />
  </Style>
  <Style Selector="Border.onboarding-card">
    <Setter Property="Background" Value="{DynamicResource SetupSurfaceBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource OnboardingCardRadius}" />
    <Setter Property="Padding" Value="{DynamicResource OnboardingCardPadding}" />
  </Style>
  <Style Selector="Border.onboarding-dialog">
    <Setter Property="Background" Value="{DynamicResource WelcomeControlBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WelcomeEdgeBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource OnboardingEdgeThickness}" />
    <Setter Property="CornerRadius" Value="{DynamicResource OnboardingCardRadius}" />
    <Setter Property="Padding" Value="{DynamicResource OnboardingDialogPadding}" />
  </Style>
  <Style Selector="TextBlock.onboarding-title">
    <Setter Property="Foreground" Value="{DynamicResource WelcomeTextBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource OnboardingTitleSize}" />
    <Setter Property="FontWeight" Value="SemiBold" /><Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.onboarding-body">
    <Setter Property="Foreground" Value="{DynamicResource WelcomeTextBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource OnboardingBodySize}" />
    <Setter Property="LineHeight" Value="{DynamicResource OnboardingBodyLineHeight}" /><Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.onboarding-secondary">
    <Setter Property="Foreground" Value="{DynamicResource WelcomeSecondaryBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource OnboardingSecondarySize}" /><Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Button.onboarding">
    <Setter Property="Background" Value="{DynamicResource WelcomeControlBrush}" /><Setter Property="Foreground" Value="{DynamicResource WelcomeTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WelcomeEdgeBrush}" /><Setter Property="BorderThickness" Value="{DynamicResource OnboardingEdgeThickness}" />
    <Setter Property="CornerRadius" Value="{DynamicResource OnboardingButtonRadius}" /><Setter Property="MinHeight" Value="{DynamicResource OnboardingButtonHeight}" />
    <Setter Property="Padding" Value="{DynamicResource OnboardingButtonPadding}" /><Setter Property="FontSize" Value="{DynamicResource OnboardingButtonSize}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.onboarding.onboarding-primary">
    <Setter Property="Background" Value="{DynamicResource WelcomeGoldBrush}" /><Setter Property="Foreground" Value="{DynamicResource WelcomeButtonTextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" /><Setter Property="MinWidth" Value="{DynamicResource OnboardingPrimaryMinWidth}" />
  </Style>
  <Style Selector="Button.onboarding TextBlock"><Setter Property="Foreground" Value="{DynamicResource WelcomeTextBrush}" /></Style>
  <Style Selector="Button.onboarding.onboarding-primary TextBlock"><Setter Property="Foreground" Value="{DynamicResource WelcomeButtonTextBrush}" /></Style>
  <Style Selector="Button.onboarding:pointerover /template/ ContentPresenter, Button.onboarding:pressed /template/ ContentPresenter, Button.onboarding:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource WelcomeControlBrush}" /><Setter Property="Foreground" Value="{DynamicResource WelcomeTextBrush}" />
  </Style>
  <Style Selector="Button.onboarding.onboarding-primary:pointerover /template/ ContentPresenter, Button.onboarding.onboarding-primary:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource WelcomeGoldBrush}" /><Setter Property="Foreground" Value="{DynamicResource WelcomeButtonTextBrush}" />
  </Style>
  <Style Selector="Button.onboarding:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource WelcomeFocusBrush}" /><Setter Property="BorderThickness" Value="{DynamicResource OnboardingFocusThickness}" />
  </Style>
  <!-- Static tinted surfaces, not live backdrop blur. Reading surfaces remain opaque. -->
  <Style Selector="TextBlock#SaveStateText"><Setter Property="MaxWidth" Value="240" /></Style>
  <Style Selector="ComboBox#ProviderPicker"><Setter Property="MinWidth" Value="200" /><Setter Property="MaxWidth" Value="250" /></Style>
  <Style Selector="Border#FormPanel"><Setter Property="Padding" Value="16" /></Style>
  <Style Selector="Border#DraftPanel"><Setter Property="Padding" Value="16,12,16,16" /></Style>
  <Style Selector="Border#DocumentPaper"><Setter Property="Padding" Value="64,56" /></Style>
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BoxShadow" Value="0 6 16 0 #24000000" />
  </Style>
  <Style Selector="TextBlock.title"><Setter Property="FontSize" Value="18" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="TextBlock.muted"><Setter Property="FontSize" Value="12.5" /></Style>
  <Style Selector="Button.outline"><Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" /></Style>
  <Style Selector="TextBox.input">
    <Setter Property="FontSize" Value="18" /><Setter Property="MinHeight" Value="44" />
    <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
  </Style>
  <Style Selector="TextBox.input.missing"><Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" /></Style>
  <Style Selector="ComboBox"><Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" /></Style>
  <Style Selector="Expander"><Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" /></Style>
  <Style Selector="Expander /template/ ToggleButton"><Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" /></Style>
  <Style Selector="ListBox.steps ListBoxItem">
    <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" />
    <Setter Property="CornerRadius" Value="4" /><Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="MinHeight" Value="28" />
  </Style>
  <Style Selector="ListBox.steps ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>
  <Style Selector="TextBlock.step-label"><Setter Property="FontSize" Value="13" /></Style>
  <Style Selector="Window.arabic TextBlock.step-label"><Setter Property="FontSize" Value="15.5" /></Style>
  <Style Selector="Border.step-marker"><Setter Property="Background" Value="Transparent" /></Style>
  <Style Selector="ListBoxItem:selected Border.step-marker"><Setter Property="Background" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="ListBoxItem:selected TextBlock.step-label"><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="TextBox.document">
    <Setter Property="FontSize" Value="20.5" /><Setter Property="LineHeight" Value="31" />
    <Setter Property="Foreground" Value="#27241F" /><Setter Property="CaretBrush" Value="#27241F" />
    <Setter Property="Padding" Value="0" /><Setter Property="MinHeight" Value="31" />
  </Style>
  <Style Selector="Border.document-section:focus-within"><Setter Property="BorderBrush" Value="#637E8C" /></Style>
  <Style Selector="Border.document-section:pointerover"><Setter Property="BorderBrush" Value="#B0C0C5" /></Style>
  <Style Selector="TextBlock.document-heading">
    <Setter Property="FontFamily" Value="{StaticResource DocumentFont}" /><Setter Property="FontSize" Value="20.5" />
    <Setter Property="FontWeight" Value="Bold" /><Setter Property="Foreground" Value="#27241F" />
    <Setter Property="TextDecorations" Value="Underline" /><Setter Property="FlowDirection" Value="RightToLeft" />
  </Style>
  <Style Selector="Border.field-tools TextBlock"><Setter Property="Foreground" Value="{DynamicResource FieldToolsTextBrush}" /></Style>
  <Style Selector="Button.field-action">
    <Setter Property="Foreground" Value="{DynamicResource FieldToolsTextBrush}" /><Setter Property="Background" Value="#F0F4F5" />
    <Setter Property="BorderBrush" Value="#A9BBC2" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" /><Setter Property="FontSize" Value="12" /><Setter Property="Padding" Value="8,4" />
    <Setter Property="MinHeight" Value="30" />
  </Style>
  <Style Selector="Window.arabic Button.field-action"><Setter Property="FontSize" Value="14" /></Style>
  <Style Selector="TextBlock.field-caption"><Setter Property="FontSize" Value="12.5" /></Style>
  <Style Selector="Window.arabic TextBlock.field-caption"><Setter Property="FontSize" Value="15" /></Style>
  <Style Selector="Window.compact TextBlock.document-type"><Setter Property="IsVisible" Value="False" /></Style>
  <Style Selector="Window.compact TextBlock#SaveStateText"><Setter Property="MaxWidth" Value="150" /></Style>
  <Style Selector="Window.tight TextBlock#SaveStateText"><Setter Property="MaxWidth" Value="90" /></Style>
  <Style Selector="Window.tight TextBlock.offline-caption"><Setter Property="MaxWidth" Value="140" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /></Style>
  <Style Selector="Window.tight Border#FormPanel"><Setter Property="Padding" Value="12" /></Style>
  <Style Selector="Window.tight Border#DraftPanel"><Setter Property="Padding" Value="12,10" /></Style>
  <Style Selector="Window.tight TextBlock.draft-heading"><Setter Property="FontSize" Value="16" /></Style>
  <Style Selector="Window.tight Border#DraftBadgePanel"><Setter Property="MaxWidth" Value="160" /></Style>
  <Style Selector="Window.tight TextBlock#DraftBanner"><Setter Property="TextWrapping" Value="Wrap" /></Style>
  <Style Selector="Window.compact Border#DocumentPaper"><Setter Property="Padding" Value="32,42" /></Style>
  <Style Selector="Window.tight Border#DocumentPaper"><Setter Property="Padding" Value="24,32" /></Style>
  <Style Selector="Window.tight ComboBox#ProviderPicker"><Setter Property="MinWidth" Value="150" /><Setter Property="MaxWidth" Value="185" /></Style>
  <Style Selector="Window.tight Button#GenerateButton"><Setter Property="Padding" Value="8,6" /></Style>
  <Style Selector="Button.export"><Setter Property="Padding" Value="7,5" /><Setter Property="MinHeight" Value="32" /></Style>
  <Style Selector="TabControl#DraftTabs TabItem"><Setter Property="FontSize" Value="12.5" /><Setter Property="MinHeight" Value="32" /><Setter Property="Padding" Value="8,6" /></Style>
  <Style Selector="Window.arabic TabControl#DraftTabs TabItem"><Setter Property="FontSize" Value="15" /></Style>
</Styles>
