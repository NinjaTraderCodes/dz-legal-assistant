---
// The language pair of the welcome screen: العربية | English, the current one outlined. The other one links to the
// server's /lang endpoint, which remembers the choice in a first-party cookie and comes back to the same page.
import { otherLang, type Lang } from "../i18n";

interface Props { lang: Lang; path: string }
const { lang, path } = Astro.props;
const other = otherLang(lang);
const names: Record<Lang, string> = { ar: "العربية", en: "English" };
---
<div class="langs" role="group" aria-label={lang === "ar" ? "لغة الواجهة" : "Interface language"}>
    <span class="lang selected" aria-current="true" lang={lang}>{names[lang]}</span>
    <a class="lang" href={`/lang/${other}?to=${encodeURIComponent(`/${other}${path}`)}`} rel="nofollow" lang={other} hreflang={other}>{names[other]}</a>
</div>

<style>
    .langs { display: inline-flex; gap: 4px; }
    .lang { display: inline-flex; align-items: center; min-height: 40px; padding: 4px 10px; border: 1.5px solid transparent; border-radius: 2px; color: var(--w-text); font-size: 14px; text-decoration: none; }
    .lang.selected { border-color: var(--w-btn); font-weight: 600; }
    a.lang { text-decoration: underline; text-underline-offset: 4px; }
    a.lang:hover { text-decoration-thickness: 2px; }
</style>
