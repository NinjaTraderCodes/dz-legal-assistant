@using DzLegal.Presentation.ViewModels
@* The section assistant: the model rewords one section on request; the change is shown as a diff to accept or reject. *@
<div class="assistant" dir="@(Vm.IsRightToLeft ? "rtl" : "ltr")">
    <div class="row between">
        <strong>✦ @Vm.AssistantTitle</strong>
        <button class="link" @onclick="() => Vm.CloseAssistantCommand.Execute(null)">✕</button>
    </div>
    <div class="muted small">@Vm.L["AssistantScope"]</div>
    <div class="row wrap">
        @foreach (var s in Vm.Shortcuts)
        {
            <button class="chip" @onclick="() => Vm.UseShortcutCommand.ExecuteAsync(s)">@s.Label</button>
        }
    </div>
    <div class="row">
        <input class="grow" placeholder="@Vm.L["InstructionPlaceholder"]" @bind="Vm.AssistantInstruction" @bind:event="oninput" />
        @if (Vm.SendInstructionCommand.IsRunning)
        {
            <button class="danger" @onclick="() => Vm.SendInstructionCancelCommand.Execute(null)">@Vm.L["Cancel"]</button>
        }
        else
        {
            <button class="primary" @onclick="() => Vm.SendInstructionCommand.ExecuteAsync(null)">@Vm.L["Send"]</button>
        }
    </div>
    @foreach (var m in Vm.AssistantThread)
    {
        <div class="bubble @(m.FromLawyer ? "mine" : "")">@m.Text</div>
    }
    <ModelActivity Model="Vm.AssistantActivity" />
    @if (Vm.SendInstructionCommand.IsRunning && Vm.AssistantPartial.Length > 0)
    {
        <div class="arabic live-text" dir="rtl">@Vm.AssistantPartial</div>
    }
    @if (Vm.HasProposal)
    {
        <div class="diff arabic" dir="rtl">
            @foreach (var t in Vm.ProposalDiff)
            {
                <span class="@(t.IsAdded ? "added" : t.IsRemoved ? "removed" : "")">@t.Text</span>
            }
        </div>
        @if (Vm.ProposalHints.Length > 0)
        {
            <div class="review" dir="rtl">@Vm.ProposalHints</div>
        }
        <div class="row">
            <button class="primary" disabled="@(!Vm.CanAcceptProposal)" @onclick="() => Vm.AcceptProposalCommand.Execute(null)">@Vm.L["Accept"]</button>
            <button class="ghost" @onclick="() => Vm.RejectProposalCommand.Execute(null)">@Vm.L["Reject"]</button>
            <button class="ghost" @onclick="() => Vm.RetryProposalCommand.ExecuteAsync(null)">@Vm.L["TryAgain"]</button>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public MainWindowViewModel Vm { get; set; } = default!;
}
