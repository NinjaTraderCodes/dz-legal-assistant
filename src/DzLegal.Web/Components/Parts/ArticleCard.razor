@using DzLegal.Presentation.ViewModels
@* An article to cite or not: who suggested it, its role, why it applies, its official text and where to check it. *@
<div class="article-card @(Article.IsSelected ? "selected" : "")">
    <div class="top">
        <label class="check">
            <input id="@InputId" type="checkbox" checked="@Article.IsSelected" @onchange="e => Article.IsSelected = e.Value is true" />
            <span class="citation" dir="rtl" lang="ar">@Article.Citation</span>
        </label>
        <span class="tags">
            @if (Article.HasRole)
            {
                <span class="tag role" title="@RoleHelp">@Article.RoleText</span>
            }
        </span>
    </div>

    @if (Article.HasModelReason)
    {
        <div class="why" dir="rtl" lang="ar"><span class="who">@Vm.L["AiReason"]</span>@Article.ModelReason</div>
    }
    else if (Article.HasWhy)
    {
        <div class="why" dir="auto">@Article.Why</div>
    }

    @if (Article.IsAvailable)
    {
        <details>
            <summary><Icon Name="book_open" Size="14" /> @Vm.L["ShowOfficialText"]</summary>
            <p class="official" dir="rtl" lang="ar">@Article.Text</p>
        </details>
    }
    else
    {
        <div class="small muted"><em>@Article.Text</em></div>
    }

    @* The same provenance block as the desktop card: reference, link, how sure the text is, who proposed the article. *@
    <div class="provenance">
        <div class="reference" dir="auto">@Article.ReferenceText</div>
        <div class="source">
            @if (Article.SourceFile is { } file && Article.Page is { } page)
            {
                <a href="@($"/law-sources/{System.IO.Path.GetFileName(file)}#page={page}")" target="_blank" rel="noopener" title="@Article.LinkTooltip"><Icon Name="document_text" Size="14" /> @Vm.L.Format("SourcePage", page)</a>
            }
            else if (Article.HasSource)
            {
                <a href="@Article.SourceUrl" target="_blank" rel="noopener" title="@Article.LinkTooltip"><Icon Name="open" Size="14" /> @Article.LinkLabel</a>
            }
            <span class="tag @(Article.IsVerified ? "verified" : "unverified")">@if (Article.IsVerified) { <Icon Name="checkmark" Size="12" /> }@Article.ProvenanceTag</span>
            <span>@Article.SourceText</span>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ArticleChoiceViewModel Article { get; set; } = default!;

    [Parameter, EditorRequired] public MainWindowViewModel Vm { get; set; } = default!;

    [Parameter] public string IdPrefix { get; set; } = "art";

    private string InputId => IdPrefix + "-" + Article.Reference.Code + "-" + Article.Reference.Number.Replace(' ', '-');

    private string RoleHelp => Vm.L["RoleHelp_" + RoleKey];

    private string RoleKey => Article.RoleText == Vm.L["Role_basis"] ? "basis" : Article.RoleText == Vm.L["Role_proof"] ? "proof"
        : Article.RoleText == Vm.L["Role_damages"] ? "damages" : Article.RoleText == Vm.L["Role_procedure"] ? "procedure"
        : Article.RoleText == Vm.L["Role_limit"] ? "limit" : "prerequisite";
}
