---
// The problem in one sentence, beside the thing the product shows the lawyer: the formal check dropping to 7 of 9
// with the article that requires the missing element. The card is the workbench's own finding card.
import Icon from "./Icon.astro";
import { s, t, type Lang } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
---
<section id="problem" class="section page problem" aria-labelledby="problem-title">
    <div class="text">
        <h2 id="problem-title" class="h1">{t(lang, "problem.title")}</h2>
        <p class="lead">{t(lang, "problem.body")}</p>
    </div>
    <aside class="check card" aria-label={s(lang, "Compliance")}>
        <div class="score-row">
            <span class="muted">{s(lang, "ComplianceScore")}</span>
            <span class="score">7 / 9</span>
        </div>
        <div class="bar"><span style="width: 78%"></span></div>
        <p class="verdict"><Icon name="error_circle" size={18} /> {t(lang, "story.missing")}</p>
        <div class="finding">
            <strong>{t(lang, "problem.finding.title")}</strong>
            <span class="caption">{t(lang, "problem.finding.article")}</span>
            <span class="small">{t(lang, "problem.finding.text")}</span>
        </div>
    </aside>
</section>

<style>
    .problem { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(280px, 0.8fr); gap: clamp(32px, 6vw, 96px); align-items: center; }
    .text { display: grid; gap: 20px; }
    .check { display: grid; gap: 10px; background: var(--surface-alt); box-shadow: var(--shadow-card); padding: 18px; }
    .score-row { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
    .score { font-size: 26px; font-weight: 700; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .muted { color: var(--muted-aa); font-size: 0.9rem; }
    .bar { height: 6px; border-radius: 3px; background: var(--hairline); overflow: hidden; }
    .bar span { display: block; height: 100%; background: var(--danger); }
    .verdict { display: flex; gap: 8px; align-items: flex-start; color: var(--danger); font-weight: 600; max-width: none; }
    .verdict :global(.icon) { flex: none; margin-top: 3px; }
    .finding strong { font-size: 0.95rem; }
    @media (max-width: 899px) { .problem { grid-template-columns: 1fr; } }
</style>
