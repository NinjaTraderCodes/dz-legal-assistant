{
  // Shipped defaults. To change a setting on your machine, put only that key in
  // appsettings.local.json next to this file (ignored by git), e.g.
  //   { "ollama": { "model": "qwen2.5:7b-instruct" } }
  // "ollama" = local model on this computer; "stub" = template mode (no AI).
  "defaultProvider": "ollama",
  // "ar" or "en"
  "language": "ar",
  "ollama": {
    // Must be a loopback address: case data never leaves this computer.
    "endpoint": "http://127.0.0.1:11434",
    // gemma3:4b: best measured on 8 GB RAM without a GPU (~2 min per requête).
    // With 16 GB RAM or a GPU, a 7B model such as "qwen2.5:7b-instruct" writes better Arabic.
    "model": "gemma3:4b",
    "timeoutMinutes": 10,
    // Low temperature = faithful rephrasing. maxTokens caps each section.
    "temperature": 0.2,
    "maxTokens": 1000,
    "repeatPenalty": 1.1,
    // Load the model into memory in the background at startup (local only), so the first request is faster.
    "warmUp": true,
    // How long the model stays in memory after each request. Ollama's default (5 minutes) makes the next
    // request wait for the model to load again.
    "keepAlive": "60m"
    // For reasoning models such as qwen3, add:  "think": false
  }
}
