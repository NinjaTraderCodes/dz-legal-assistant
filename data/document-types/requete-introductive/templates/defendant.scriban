{{~ g = defendant.gender ~}}
{{~ if defendant.isLegalEntity ~}}
{{~ if defendant.entityName ~}}
ضد: {{ defendant.entityName }}{{ if defendant.entityNature }}، {{ defendant.entityNature }}{{ end }}{{ if defendant.headOffice }}، الكائن مقرها الاجتماعي بـ: {{ defendant.headOffice }}{{ end }}{{ if defendant.representativeCapacity }}، ممثلة من طرف {{ defendant.representativeCapacity }}{{ if defendant.representativeName }} {{ defendant.representativeName }}{{ end }}{{ end }}.
{{~ end ~}}
(مدعى عليها)
{{~ else ~}}
{{~ if defendant.lastName || defendant.firstName ~}}
ضد: {{ if g }}{{ gendered g "السيد" "السيدة" }} {{ end }}{{ defendant.lastName }} {{ defendant.firstName }}{{ if defendant.domicile }}، {{ gendered g "القاطن" "القاطنة" }} بـ: {{ defendant.domicile }}{{ else if defendant.lastKnownDomicile }}، {{ gendered g "مجهول الموطن، وآخر موطن معلوم له" "مجهولة الموطن، وآخر موطن معلوم لها" }}: {{ defendant.lastKnownDomicile }}{{ end }}.
{{~ end ~}}
{{ gendered g "(مدعى عليه)" "(مدعى عليها)" }}
{{~ end ~}}
{{~ if (area court.section) == "family" ~}}
{{~ # Family Code art. 3 bis: the prosecution is a principal party in every family case; written as practitioners do. ~}}
بحضور: السيد وكيل الجمهورية{{ if court.name }} لدى {{ court.name }}{{ end }}.
{{~ end ~}}
