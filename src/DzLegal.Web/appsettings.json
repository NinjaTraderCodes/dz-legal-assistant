{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Hosted engines for the public demo. API keys are NOT here: set GOOGLE_API_KEY (and optionally GROQ_API_KEY,
  // OPENROUTER_API_KEY) as environment variables or host secrets. See docs/WEB-DEMO.md.
  "Engines": {
    // Services tried in order; a service without a key is skipped. Google's Gemma 4 26B comes first: it drafted
    // complete grounds in the audit, where OpenRouter's Gemma 3 4B (the desktop's model) left them blank. The page says
    // the demo uses a larger hosted model than the desktop.
    "Order": [ "google", "openrouter", "groq" ],
    // Gemma on Google AI Studio, tried in order; each model has its own rate limit. At startup, models Google no longer
    // serves are dropped (and if none is left, any Gemma model the key can use is taken).
    "GoogleModels": [ "gemma-4-26b-a4b-it", "gemma-4-31b-it" ],
    "GroqModel": "llama-3.3-70b-versatile",
    // Nemotron 3 Ultra (paid per token, reasoning switched off by the provider): the online model of the Alpha-02
    // upper-bound run of 31 Oct 2026, 18 of 20 hard cases right at 9 s each. Used only when OPENROUTER_API_KEY is set.
    "OpenRouterModel": "nvidia/nemotron-3-ultra-550b-a55b",
    // Model calls running at once across all visitors; the rest wait their turn.
    "MaxConcurrentCalls": 2,
    // Model calls per hour (a full run of the demo is about six): per browser session, and per network address.
    "CallsPerSessionPerHour": 60,
    "CallsPerAddressPerHour": 150,
    "Temperature": 0.2,
    "MaxTokens": 1500
  }
}
