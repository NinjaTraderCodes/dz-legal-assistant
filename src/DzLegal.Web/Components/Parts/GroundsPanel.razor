@using DzLegal.Presentation.ViewModels
@* AI step 1: the AI reads the facts and proposes articles; the lawyer decides which ones the draft cites. *@
<div class="grounds">
    <p class="muted small">@Vm.L["GroundsIntro"]</p>
    <div>
        @if (Vm.AnalyseGroundsCommand.IsRunning)
        {
            <button type="button" @onclick="() => Vm.AnalyseGroundsCancelCommand.Execute(null)"><Icon Name="stop" /> @Vm.L["Cancel"]</button>
        }
        else
        {
            <button type="button" class="ai" disabled="@CommandRunner.IsAiBusy(Vm)" @onclick="() => CommandRunner.RunAsync(Vm, Vm.AnalyseGroundsCommand)"><Icon Name="sparkle" /> @Vm.L["AnalyseGrounds"]</button>
        }
    </div>

    <ModelActivity Model="Vm.AnalysisActivity" LiveLabel="@Vm.L["ActivityLive"]" />

    @if (Vm.AnalysisStatus.Length > 0)
    {
        <div class="small muted" role="status">@Vm.AnalysisStatus</div>
    }
    @if (Vm.HasAnsweredBy && !Vm.AnalyseGroundsCommand.IsRunning)
    {
        <div class="small answered-by" dir="ltr"><Icon Name="sparkle" Size="12" /> @Vm.AnsweredBy</div>
    }
    @if (Vm.IsAnalysisStale)
    {
        <div class="notice">@Vm.L["AnalysisStale"]</div>
    }
    @if (Vm.HasPrerequisites)
    {
        <div class="notice arabic" dir="rtl" lang="ar">@Vm.Prerequisites</div>
    }

    @if (Vm.HasReading)
    {
        <div class="reading">
            <div class="section-title-row"><h3>@Vm.L["ModelReading"]</h3><span class="tag ai"><Icon Name="sparkle" Size="12" /> @Vm.L["ModelTag"]</span></div>
            <dl>
                <dt>@Vm.L["ReadingRelationship"]</dt><dd dir="rtl" lang="ar">@Vm.ReadingRelationship</dd>
                <dt>@Vm.L["ReadingBreach"]</dt><dd dir="rtl" lang="ar">@Vm.ReadingBreach</dd>
                <dt>@Vm.L["ReadingSought"]</dt><dd dir="rtl" lang="ar">@Vm.ReadingSought</dd>
                <dt>@Vm.L["ReadingClaims"]</dt><dd>@Vm.ReadingClaims</dd>
            </dl>
            @if (Vm.IsClaimConfirmed)
            {
                <div class="small ok-text">@Vm.L["ClaimConfirmedNote"]</div>
            }
        </div>
    }

    @* Nothing is ticked until the lawyer confirms the claim type the model recognised. *@
    @if (Vm.NeedsClaimConfirmation)
    {
        <div class="notice confirm-claim">
            <p>@Vm.L["ClaimConfirmPrompt"]</p>
            <div class="row">
                <button type="button" class="primary" @onclick="() => Vm.ConfirmClaimCommand.Execute(null)">@Vm.L["ConfirmClaim"]</button>
                <button type="button" @onclick="() => Vm.RejectClaimCommand.Execute(null)">@Vm.L["RejectClaim"]</button>
            </div>
        </div>
    }

    @if (Vm.HasAnalysedArticles)
    {
        <div class="section-title-row">
            <h3>@Vm.L["ProposedArticles"]</h3>
            <button type="button" class="link" @onclick="() => Vm.TickBasisArticlesCommand.Execute(null)">@Vm.L["TickBasis"]</button>
        </div>
        @foreach (var a in Vm.AnalysedArticles)
        {
            <ArticleCard Article="a" Vm="Vm" />
        }
    }

    <div class="reading">
        <h3>@Vm.L["SelectedGrounds"] (@Vm.SelectedArticleCount)</h3>
        @if (!Vm.HasSelectedArticles)
        {
            <div class="muted small">@Vm.L["SelectedGroundsEmpty"]</div>
        }
        <div class="selected-list">
            @foreach (var s in Vm.SelectedGrounds)
            {
                <span class="chip" dir="rtl" lang="ar">@s.Citation
                    <button type="button" class="link" aria-label="@Vm.L.Format("RemoveArticle", s.Citation)" @onclick="() => s.RemoveCommand.Execute(null)"><Icon Name="dismiss" Size="12" /></button>
                </span>
            }
        </div>
    </div>

    @* Always open, as on the desktop: the lawyer can cite an article the analysis did not propose. *@
    <div class="search">
        <h3>@Vm.L["AddArticleByHand"]</h3>
        <label class="small muted" for="article-search">@Vm.L["ArticleSearchPlaceholder"]</label>
        <input id="article-search" class="arabic" dir="auto" @bind="Vm.ArticleQuery" @bind:event="oninput" />
        @if (Vm.ArticleSearchHint.Length > 0)
        {
            <div class="muted small">@Vm.ArticleSearchHint</div>
        }
        @foreach (var a in Vm.ArticleResults)
        {
            <ArticleCard Article="a" Vm="Vm" />
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public MainWindowViewModel Vm { get; set; } = default!;
}
