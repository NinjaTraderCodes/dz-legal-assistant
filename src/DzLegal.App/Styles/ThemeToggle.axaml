<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The existing workbench bar button's dimensions, colors and interaction styling. -->
  <Style Selector="Button.global-theme-toggle">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AppBarTextBrush}" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="CornerRadius" Value="{DynamicResource ControlRadius}" />
  </Style>
  <Style Selector="Button.global-theme-toggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#26FFFFFF" />
    <Setter Property="Foreground" Value="{DynamicResource AppBarTextBrush}" />
  </Style>
</Styles>
