@page "/app"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IDisposable
@using DzLegal.Presentation.ViewModels
@using DzLegal.Web.Components.Parts
@using DzLegal.Web.Services

<PageTitle>DZ Legal Assistant · demo</PageTitle>

@if (Vm is null)
{
    <div class="loading">DZ Legal Assistant…</div>
    return;
}

<div class="app @(Vm.IsDarkTheme ? "dark" : "")" dir="@(Vm.IsRightToLeft ? "rtl" : "ltr")" lang="@Lang">
    <header class="appbar">
        <div class="brand">
            @* The brand leads back to the website's home. target="_top" makes it a full page load: "/" is the static
               site, not a route of this app, so Blazor must not handle the link itself. The case stays in the
               browser's recovery copy. *@
            <a class="brand-link" href="/" target="_top" title="@T("BackToSite")">
                <span class="brand-mark"><Icon Name="gavel" Size="20" /></span>
                <h1>@L["AppTitle"]</h1>
            </a>
            <span class="doc-type">@Vm.DocumentTypeName</span>
        </div>
        @* As on the desktop, next to the brand: New, Open, Save and the save state. Below 1440 px they show as icons
           (the label stays for the screen reader and as the tooltip); on a phone they fold behind More. *@
        <div class="tools secondary @(showMore ? "open" : "")">
            <button type="button" title="@L["New"]" @onclick="() => Vm.NewCommand.Execute(null)"><Icon Name="document_add" /> <span class="label">@L["New"]</span></button>
            @* Open and Save as on the desktop: a draft file (.dzdraft.json) from and to the visitor's own disk. *@
            <label class="button-like" title="@L["Open"]"><Icon Name="folder_open" /> <span class="label">@L["Open"]</span><InputFile class="visually-hidden" accept=".json,application/json" OnChange="OpenDraftFile" /></label>
            <button type="button" title="@L["Save"]" @onclick="() => Run(Vm.SaveCommand)"><Icon Name="save" /> <span class="label">@L["Save"]</span></button>
            @if (Vm.HasSaveState)
            {
                <span class="save-state">@Vm.SaveStateText</span>
            }
        </div>
        @* The demo's own items, between the desktop's two groups: the chip, the sample picker, Download for Windows and Guide. *@
        <div class="tools demo">
            <span class="demo-chip">@T("DemoChip")</span>
            <select id="sample-picker" aria-label="@T("Samples")" value="" @onchange="OpenSample">
                <option value="">@T("Samples")</option>
                @foreach (var sample in Engine.Samples)
                {
                    <option value="@sample.Id">@sample.Title.Get(Lang)</option>
                }
            </select>
            <button type="button" class="more-toggle" aria-expanded="@(showMore ? "true" : "false")" @onclick="() => showMore = !showMore"><Icon Name="chevron_down" Size="16" /> @T("More")</button>
            <div class="secondary @(showMore ? "open" : "")">
                @* The desktop app, for judges and lawyers who want it on their own computer: the zip itself, so no GitHub page opens (change it with each release). *@
                <a class="button-like" id="download-windows" href="@DownloadUrl" target="_blank" rel="noopener" title="@T("DownloadWindows")"><Icon Name="arrow_download" /> <span class="label">@T("DownloadWindows")</span></a>
                <button type="button" title="@T("GuideShow")" aria-pressed="@(showGuide ? "true" : "false")" @onclick="OpenGuide"><Icon Name="question_circle" /> <span class="label">@T("GuideShow")</span></button>
            </div>
        </div>
        @* At the far end, as on the desktop: the theme button and the language as plain text. *@
        <div class="tools end">
            <button type="button" aria-label="@T("Theme")" title="@T("Theme")" aria-pressed="@(Vm.IsDarkTheme ? "true" : "false")" @onclick="ToggleThemeAsync"><Icon Name="@(Vm.IsDarkTheme ? "weather_sunny" : "weather_moon")" /></button>
            <button type="button" class="lang" lang="@(Lang == "en" ? "ar" : "en")" @onclick="SwitchLanguageAsync">@L["SwitchLanguage"]</button>
        </div>
    </header>

    <div class="strip">
        @if (!Engine.Settings.HasAnyEngine)
        {
            <div class="notice" role="status">@T("NoEngine")</div>
        }
        @if (Vm.IsConfirmingReplace)
        {
            <div class="notice" role="alertdialog" aria-label="@Vm.ReplacePrompt">
                <span class="grow">@Vm.ReplacePrompt</span>
                <button type="button" class="primary small" @onclick="() => Run(Vm.SaveThenReplaceCommand)">@L["SaveFirst"]</button>
                <button type="button" class="small" @onclick="() => Run(Vm.ReplaceWithoutSavingCommand)">@L["ContinueWithoutSaving"]</button>
                <button type="button" class="small" @onclick="() => Vm.CancelReplaceCommand.Execute(null)">@L["Cancel"]</button>
            </div>
        }
        @if (SavedCase is not null)
        {
            <div class="notice info" role="status">
                <span class="grow">@string.Format(L.Culture, T("SavedCase"), SavedAt?.ToLocalTime().ToString("g", L.Culture))</span>
                <button type="button" class="primary small" @onclick="RestoreSavedCase">@T("RestoreCase")</button>
                <button type="button" class="small" @onclick="DiscardSavedCase">@T("DiscardCase")</button>
            </div>
        }
        @* The demo's warning, always on screen in one line; the full wording and the browser-copy button one click away. *@
        <details class="disclosure">
            <summary><Icon Name="warning" Size="14" /> <span class="line">@T("DisclosureLine")</span> <span class="details-label">@T("Details")</span></summary>
            <div class="disclosure-body">
                <p class="muted small">@T("AboutDemo")</p>
                <p class="muted small">@T("DownloadNote") <a href="@DownloadUrl" target="_blank" rel="noopener">@T("DownloadWindows")</a></p>
                <p class="row small"><button type="button" class="small" @onclick="ClearBrowserCopy">@T("ClearBrowserCopy")</button>
                    @if (_browserCopyCleared) { <span class="muted" role="status">@T("BrowserCopyCleared")</span> }</p>
            </div>
        </details>
        @if (showInvite)
        {
            <div class="invite" role="region" aria-label="@T("GuideTitle")">
                <span class="invite-text"><Icon Name="question_circle" Size="16" /> @T("GuideInvite")</span>
                <button type="button" class="primary small" @onclick="OpenGuide">@T("GuideOpen")</button>
                <button type="button" class="quiet small" aria-label="@T("GuideHide")" title="@T("GuideHide")" @onclick="DismissInvite"><Icon Name="dismiss" Size="14" /></button>
            </div>
        }
    </div>

    <nav class="mobile-tabs" role="tablist" aria-label="@L["AppTitle"]">
        <button type="button" role="tab" aria-selected="@(mobileTab == 0 ? "true" : "false")" @onclick="() => mobileTab = 0">@T("TabCase")</button>
        <button type="button" role="tab" aria-selected="@(mobileTab == 1 ? "true" : "false")" @onclick="() => mobileTab = 1">@T("TabDraft")</button>
        <button type="button" role="tab" aria-selected="@(mobileTab == 2 ? "true" : "false")" @onclick="() => mobileTab = 2">@T("TabChecks") @(Vm.HasIssues || Vm.HasSubstanceIssues ? "•" : "")</button>
    </nav>

    <main class="columns">
        @* ── The case: the guided form ─────────────────────────────── *@
        <section class="panel form-panel @(mobileTab == 0 ? "current" : "")" aria-labelledby="case-title">
            <h2 id="case-title">@L["CaseForm"]</h2>
            <nav class="steps" aria-label="@L["CaseForm"]">
                @foreach (var step in Vm.FieldGroups)
                {
                    var current = step == Vm.SelectedStep;
                    <button type="button" class="step @StepClass(step) @(current ? "selected" : "")" aria-current="@(current ? "step" : null)" @onclick="() => SelectStep(step)">
                        <span class="marker" aria-hidden="true"></span>
                        <span class="num" aria-hidden="true">@($"{step.Number:00}")</span>
                        <span class="label">@step.Label</span>
                        <span class="state">
                            @if (step.IsMissing)
                            {
                                <Icon Name="error_circle" Size="13" />
                            }
                            else if (step.IsWarning)
                            {
                                <Icon Name="error_circle" Size="13" />
                            }
                            else if (step.IsDone)
                            {
                                <Icon Name="checkmark_circle" Size="13" />
                            }
                        </span>
                    </button>
                }
            </nav>

            @if (Vm.SelectedStep is { } selectedStep)
            {
                <h3>@selectedStep.Label</h3>
                @if (Vm.IsGroundsStep)
                {
                    <GroundsPanel Vm="Vm" />
                }
                @foreach (var field in selectedStep.Fields.Where(f => f.IsVisible))
                {
                    <FieldEditor Field="field" ChooseLabel="@L["ChooseOption"]" />
                }
                @if (Vm.IsRequestsStep || Vm.IsDocumentsStep)
                {
                    var chips = Vm.IsRequestsStep ? Vm.RequestChips : Vm.DocumentChips;
                    <div class="chips">
                        <div class="label">@(Vm.IsRequestsStep ? L["UsualRequests"] : L["UsualDocuments"])</div>
                        @if (chips.Count == 0)
                        {
                            <div class="muted small">@(Vm.IsRequestsStep ? L["UsualRequestsNeedAnalysis"] : L["UsualDocumentsNeedAnalysis"])</div>
                        }
                        @foreach (var chip in chips)
                        {
                            <button type="button" class="chip-line @(chip.IsInserted ? "inserted" : "")" dir="rtl" @onclick="() => chip.InsertCommand.Execute(null)">
                                <Icon Name="@(chip.IsInserted ? "checkmark" : "add")" Size="14" /> @chip.Text
                            </button>
                        }
                    </div>
                }
                @if (Vm.IsRequestsStep)
                {
                    @* The document shows the lawyer's own lines; the AI may only propose a checked formal wording. *@
                    <div class="requests-wording">
                        <p class="muted small">@L["RequestsWordingIntro"]</p>
                        @if (Vm.CanProposeRequestsWording)
                        {
                            @if (Vm.ProposeRequestsWordingCommand.IsRunning)
                            {
                                <button type="button" @onclick="() => Vm.ProposeRequestsWordingCancelCommand.Execute(null)"><Icon Name="stop" /> @L["Cancel"]</button>
                            }
                            else
                            {
                                <button type="button" class="ai" disabled="@CommandRunner.IsAiBusy(Vm)" @onclick="() => CommandRunner.RunAsync(Vm, Vm.ProposeRequestsWordingCommand)"><Icon Name="sparkle" /> @L["ProposeRequestsWording"]</button>
                            }
                        }
                        @if (Vm.RequestsWordingStatus.Length > 0)
                        {
                            <div class="small muted" role="status">@Vm.RequestsWordingStatus</div>
                        }
                        @if (Vm.HasRequestsProposal)
                        {
                            <div class="reading">
                                <div class="section-title-row"><h3>@L["RequestsWordingLabel"]</h3><span class="tag ai"><Icon Name="sparkle" Size="12" /> @L["ModelTag"]</span></div>
                                <ol class="arabic" dir="rtl" lang="ar">
                                    @foreach (var line in Vm.RequestsProposal.Split('\n'))
                                    {
                                        <li>@line</li>
                                    }
                                </ol>
                                <div class="row">
                                    @* Suggestion only (audit C-02): the checks see amounts and counts, not who pays whom or what is asked. *@
                                    <button type="button" @onclick="() => Vm.RejectRequestsProposalCommand.Execute(null)">@L["RejectRequestsWording"]</button>
                                </div>
                            </div>
                        }
                    </div>
                }
                <div class="step-nav">
                    <span class="muted small">@Vm.StepPosition</span>
                    <span class="buttons">
                        <button type="button" @onclick="() => Move(-1)">@L["Previous"]</button>
                        <button type="button" class="primary" @onclick="() => Move(1)">@L["Next"]</button>
                    </span>
                </div>
            }
        </section>

        @* ── The statement of claim on paper: drafting, preview, export ──── *@
        <section class="panel draft-panel @(mobileTab == 1 ? "current" : "")" aria-labelledby="draft-title">
            <div class="panel-head">
                <h2 id="draft-title">@L["Document"]</h2>
                <span class="badge" title="@L["DraftBanner"]">@L["DraftBadge"]</span>
            </div>
            <div class="engine-row">
                @* The desktop's status dot beside the engine: green when it can answer, red when it cannot; its text is the tooltip. *@
                <span class="status-dot @(Engine.Settings.HasAnyEngine && Vm.IsModelReady ? "" : "down")" title="@(Vm.ModelStatusText.Length > 0 ? Vm.ModelStatusText : Engine.Settings.HasAnyEngine ? Vm.SelectedProvider?.DisplayName : T("NoEngine"))" aria-hidden="true"></span>
                <select id="engine-picker" aria-label="@L["ProviderLabel"]" value="@Vm.SelectedProvider?.Key" @onchange="SelectProvider">
                    @foreach (var p in Vm.Providers)
                    {
                        <option value="@p.Key">@p.DisplayName</option>
                    }
                </select>
                @if (Vm.GenerateCommand.IsRunning)
                {
                    <button type="button" @onclick="() => Vm.GenerateCancelCommand.Execute(null)"><Icon Name="stop" /> @L["Cancel"]</button>
                }
                else
                {
                    <button type="button" class="ai" title="@L["GenerateHint"]" disabled="@CommandRunner.IsAiBusy(Vm)" @onclick="() => Run(Vm.GenerateCommand)"><Icon Name="sparkle" /> @L["Generate"]</button>
                }
            </div>
            @if (Vm.HasAnsweredBy)
            {
                <p class="small answered-by" dir="ltr"><Icon Name="sparkle" Size="12" /> @Vm.AnsweredBy</p>
            }

            <div class="toolbar">
                <div class="tabs" role="tablist">
                    <button type="button" role="tab" class="tab" aria-selected="@(Vm.SelectedDraftTab == 0 ? "true" : "false")" @onclick="() => Vm.SelectedDraftTab = 0">@L["Edit"]</button>
                    <button type="button" role="tab" class="tab" aria-selected="@(Vm.SelectedDraftTab == 1 ? "true" : "false")" @onclick="() => Vm.SelectedDraftTab = 1">@L["Preview"]</button>
                </div>
                <div class="tools">
                    <label class="check" title="@Vm.WatermarkHint"><input id="watermark" type="checkbox" @bind="Vm.DraftWatermark" disabled="@Vm.IsSampleCase" /> @L["WatermarkShort"]</label>
                    @* The short names of the desktop; the full names stay the accessible names and tooltips (the guides use them). *@
                    <button type="button" class="export" title="@L["ExportPdf"]" aria-label="@L["ExportPdf"]" @onclick="() => Run(Vm.ExportPdfCommand)"><Icon Name="document_pdf" Size="16" /> PDF</button>
                    <button type="button" class="export" title="@L["ExportWord"]" aria-label="@L["ExportWord"]" @onclick="() => Run(Vm.ExportWordCommand)"><Icon Name="document_text" Size="16" /> Word</button>
                    <button type="button" class="quiet icon-only" title="@L["CopyText"]" aria-label="@L["CopyText"]" @onclick="() => Run(Vm.CopyTextCommand)"><Icon Name="copy" Size="18" /></button>
                </div>
            </div>

            @* The strip of the selected section, as on the desktop: its name, its origin, its tools. Not printed. *@
            @if (Vm.SelectedDraftTab == 0 && SelectedSection is { } tools)
            {
                <div class="field-tools" title="@L["FieldControlsHint"]">
                    <div class="row">
                        <span class="field-caption strong">@tools.Title</span>
                        <span class="field-caption hint">
                            @if (tools.IsLocked)
                            {
                                <Icon Name="lock_closed" Size="12" />
                            }
                            else if (tools.IsOverridden)
                            {
                                <Icon Name="edit" Size="12" />
                            }
                            else if (tools.IsAiWritten)
                            {
                                <Icon Name="sparkle" Size="12" />
                            }
                            @tools.Hint
                        </span>
                        <span class="field-actions">
                            @if (tools.CanOverride)
                            {
                                <button type="button" class="field-action" @onclick="() => tools.OverrideCommand.Execute(null)">@L["EditManually"]</button>
                            }
                            @if (tools.IsOverridden)
                            {
                                <button type="button" class="field-action" @onclick="() => tools.RestoreCommand.Execute(null)">@L["RestoreFromForm"]</button>
                            }
                            @if (tools.IsEditable)
                            {
                                @if (tools.CanUndo)
                                {
                                    <button type="button" class="field-action" @onclick="() => tools.UndoCommand.Execute(null)">@L["Undo"]</button>
                                }
                                <button type="button" class="field-action" disabled="@CommandRunner.IsAiBusy(Vm)" @onclick="() => CommandRunner.RunAsync(Vm, tools.RedraftCommand)">@L["Redraft"]</button>
                                <button type="button" class="field-action" @onclick="() => tools.OpenAssistantCommand.Execute(null)">@L["Assistant"]</button>
                            }
                        </span>
                    </div>
                    @if (tools.IsConfirmingRedraft)
                    {
                        <div class="confirm">
                            <button type="button" class="field-action" @onclick="() => CommandRunner.RunAsync(Vm, tools.RedraftCommand)">@L["ConfirmRedraft"]</button>
                            <button type="button" class="field-action" @onclick="() => tools.CancelRedraftCommand.Execute(null)">@L["Cancel"]</button>
                        </div>
                    }
                </div>
            }

            @if (Vm.ShowsExportBlockers)
            {
                <div class="notice export-blockers" role="@(Vm.IsExportBlockedShown ? "alert" : "status")">
                    <strong>@Vm.ExportBlockersTitle</strong>
                    <div class="small" style="white-space: pre-line">@Vm.ExportBlockers</div>
                </div>
            }

            <ModelActivity Model="Vm.GenerationActivity" LiveLabel="@L["ActivityLive"]" />

            @if (Vm.SelectedDraftTab == 0)
            {
                <div class="paper-scroll">
                    <div class="paper @(Vm.DraftWatermark ? "watermark" : "")" dir="rtl" lang="ar">
                        @foreach (var section in Vm.Sections)
                        {
                            <SectionEditor Section="section" Vm="Vm" IsSelected="@(section.Id == SelectedSection?.Id)" OnSelect="SelectSection" />
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="paper-scroll preview" aria-busy="@(Vm.IsRenderingPreview ? "true" : "false")">
                    @if (Vm.IsRenderingPreview)
                    {
                        <div class="preview-wait" role="status">@L["RenderingPreview"]</div>
                    }
                    @for (var i = 0; i < Vm.PreviewPages.Count; i++)
                    {
                        <img class="page-img" alt="@($"{L["Preview"]} {i + 1}/{Vm.PreviewPages.Count}")" src="@PageSource(Vm.PreviewPages[i])" />
                    }
                </div>
            }

            @* Review requirements stay visible for every section, independent of selection and paper scrolling, as on the desktop. *@
            @if (Vm.Sections.Any(s => s.IsAiWritten || s.HasReview || s.IsWriting))
            {
                <div class="review-list">
                    @foreach (var section in Vm.Sections)
                    {
                        @if (section.IsAiWritten)
                        {
                            <div class="review-row">
                                <span class="muted small">@(section.Title)</span>
                                <label class="check small reviewed"><input type="checkbox" @bind="section.IsReviewed" /> @L["ReviewedCheck"]</label>
                            </div>
                        }
                        @if (section.HasReview)
                        {
                            <div class="review" dir="@(Vm.IsRightToLeft ? "rtl" : "ltr")" lang="@Vm.L.Language">@(section.ReviewText)</div>
                        }
                        @if (section.IsWriting)
                        {
                            <div class="writing-mark"><span class="pulse"></span> <span>@(section.Title)</span> <span>@L["SectionWriting"]</span></div>
                        }
                    }
                </div>
            }
        </section>

        @* ── The checks: form (rule engine, no AI) and substance ──────────── *@
        <section class="panel check-panel @(mobileTab == 2 ? "current" : "")" aria-labelledby="check-title">
            <h2 id="check-title">@L["Compliance"]</h2>
            <div class="score-card">
                <div class="score-row">
                    <span class="muted">@L["ComplianceScore"]</span>
                    <span class="score">@Vm.ScoreText</span>
                </div>
                <div class="bar" role="progressbar" aria-label="@L["ComplianceScore"]" aria-valuemin="0" aria-valuemax="@Vm.ApplicableCount" aria-valuenow="@Vm.PresentCount">
                    <span style="width:@(Vm.ApplicableCount == 0 ? 0 : 100 * Vm.PresentCount / Vm.ApplicableCount)%"></span>
                </div>
                <div class="summary @(Vm.IsAdmissible ? "ok" : "ko")"><Icon Name="@(Vm.IsAdmissible ? "checkmark_circle" : "error_circle")" Size="16" /> <span>@Vm.Summary</span></div>
                @if (Vm.WarningSummary.Length > 0)
                {
                    <div class="small warning-text">@Vm.WarningSummary</div>
                }
                <div class="caveats muted small">
                    <span>@L["SummaryDisclaimer"]</span>
                    <span class="italic">@L["Unverified"]</span>
                </div>
            </div>

            @if (Vm.HasSubstanceIssues)
            {
                <div class="card substance">
                    <h3>@L["SubstanceHeader"]</h3>
                    @foreach (var point in Vm.SubstanceIssues)
                    {
                        <div class="legal-point"><Icon Name="warning" Size="15" /> <span>@point</span></div>
                    }
                </div>
            }

            @foreach (var f in Vm.IssueFindings)
            {
                <button type="button" class="finding @(f.IsMissingMandatory ? "mandatory" : "warning")" @onclick="() => GoToFinding(f)">
                    <span class="row"><Icon Name="error_circle" Size="16" /> <strong>@f.Label</strong></span>
                    <span class="article">@f.Article</span>
                    @if (f.HasMessage)
                    {
                        <span class="message">@f.Message</span>
                    }
                    @if (f.HasMissingParts)
                    {
                        <span class="article">@f.MissingPartsText</span>
                    }
                </button>
            }

            <details class="present card" open="@(Vm.IssueFindings.Count == 0)">
                <summary><Icon Name="chevron_down" Size="16" /> <span>@Vm.PresentHeader</span></summary>
                @foreach (var f in Vm.PresentFindings)
                {
                    <div class="present-item">
                        <Icon Name="checkmark_circle" Size="14" />
                        <span class="text"><span>@f.Label</span><span class="article">@f.Article</span></span>
                    </div>
                }
            </details>
        </section>
    </main>

    @if (Vm.AssistantSection is not null)
    {
        <div class="drawer-backdrop" @onclick="() => Vm.CloseAssistantCommand.Execute(null)"></div>
        <AssistantPanel Vm="Vm" />
    }

    @if (showGuide)
    {
        <div class="tour-backdrop" @onclick="() => showGuide = false"></div>
        <section class="guide tour" role="dialog" aria-modal="true" aria-labelledby="guide-title" tabindex="-1" @ref="guideCard"
                 @onkeydown="@(e => { if (e.Key == "Escape") showGuide = false; })">
            <div class="guide-head">
                <h2 id="guide-title">@T("GuideTitle")</h2>
                <button type="button" class="quiet small" @onclick="() => showGuide = false"><Icon Name="dismiss" Size="14" /> @T("GuideHide")</button>
            </div>
            <ol>
                <li>
                    <strong>@T("Guide1Title")</strong>
                    <p class="muted">@T("Guide1")</p>
                    <span class="actions">
                        @foreach (var sample in Engine.Samples)
                        {
                            <button type="button" class="small" @onclick="() => { showGuide = false; Open(sample); }">@sample.Title.Get(Lang)</button>
                        }
                    </span>
                </li>
                <li>
                    <strong>@T("Guide2Title")</strong>
                    <p class="muted">@T("Guide2")</p>
                    <span class="actions"><button type="button" class="small" @onclick='() => { showGuide = false; GoToStep("defendant"); }'>@T("OpenDefendant")</button></span>
                </li>
                <li class="ai">
                    <strong>@T("Guide3Title") <span class="tag ai"><Icon Name="sparkle" Size="12" /> @L["ModelTag"]</span></strong>
                    <p class="muted">@T("Guide3")</p>
                    <span class="actions"><button type="button" class="small" @onclick='() => { showGuide = false; GoToStep(MainWindowViewModel.GroundsStepId); }'>@T("OpenGrounds")</button></span>
                </li>
                <li class="ai">
                    <strong>@T("Guide4Title") <span class="tag ai"><Icon Name="sparkle" Size="12" /> @L["ModelTag"]</span></strong>
                    <p class="muted">@T("Guide4")</p>
                </li>
                <li>
                    <strong>@T("Guide5Title")</strong>
                    <p class="muted">@T("Guide5")</p>
                </li>
            </ol>
        </section>
    }

    <footer class="statusbar @(Vm.IsError ? "error" : "")" role="status" aria-live="polite">
        <span>@Vm.StatusMessage</span>
        @if (Engine.Gate.Waiting > 0)
        {
            <span class="muted">@string.Format(L.Culture, T("Waiting"), Engine.Gate.Waiting)</span>
        }
    </footer>
</div>
