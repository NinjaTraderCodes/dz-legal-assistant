---
// A screenshot of the product on the site: WebP renditions from a PNG crop in src/assets/shots, lazy, with its size
// known before it loads. One <img> per picture, not a <picture> with AVIF and WebP sources and a PNG fallback: with
// forty pictures on the home, the extra elements and candidates cost more main-thread time on a phone than AVIF
// saves in bytes (measured with Lighthouse, phase 5). A picture can come in a light and a dark version, and only the
// one matching the theme is shown (the other has no box, so a lazy browser never asks for it). With `large` the
// picture opens bigger in the page's Lightbox when clicked; ui.js wires the button, nothing inline.
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { t, type Lang } from "../i18n";

interface Props {
    lang: Lang;
    /** The light-theme picture, or the only one. */
    light: ImageMetadata;
    /** The dark-theme picture, when the screen was captured in both themes. */
    dark?: ImageMetadata;
    alt: string;
    caption?: string;
    /** The width the picture is shown at on wide screens, in CSS px, capped at half the crop's pixels: the rendition widths follow it. */
    width?: number;
    /** Shown at its own size, never stretched: for small strips cut from a 1x frame. */
    natural?: boolean;
    /** The provenance of the capture, as a short note under the picture. */
    note?: string;
    large?: boolean;
    /** WebP quality: 72 by default; a page of dense text can take less and stay sharp at twice its size. */
    quality?: number;
    class?: string;
}
const { lang, light, dark, alt, caption, width = 420, natural = false, note, large = false, quality = 72, class: className } = Astro.props;
// Shown at half the crop's pixel width at most, so it stays sharp on a high-density screen; the box is the picture's
// own size, never stretched past it.
const shown = natural ? light.width : Math.min(width, Math.floor(light.width / 2));
const widths = natural ? [light.width] : [shown, Math.min(light.width, shown * 2)].map(Math.round);
const sizes = natural ? `${light.width}px` : `(min-width: 900px) ${shown}px, calc(100vw - 32px)`;
const full = large ? await getImage({ src: light, format: "webp", width: Math.min(light.width, 1280), quality: 74 }) : null;
const fullDark = large && dark ? await getImage({ src: dark, format: "webp", width: Math.min(dark.width, 1280), quality: 74 }) : null;
const Wrap = large ? "button" : "div";
---
<figure class:list={["shot", natural && "natural", className]} style={natural ? undefined : `max-width: min(100%, ${shown}px)`}>
    <Wrap class="shot-frame" {...(large ? { type: "button", "data-lightbox": "", "aria-label": t(lang, "shot.open") } : {})}>
        <Image src={light} alt={alt} widths={widths} width={widths.at(-1)} sizes={sizes} format="webp" quality={quality} loading="lazy" decoding="async" class:list={["shot-img", dark ? "shot-light" : "shot-any"]} data-full={full?.src} />
        {dark && <Image src={dark} alt={alt} widths={widths} width={widths.at(-1)} sizes={sizes} format="webp" quality={quality} loading="lazy" decoding="async" class="shot-img shot-dark" data-full={fullDark?.src} />}
    </Wrap>
    {(caption || note) && <figcaption class="small">{caption}{caption && note && " "}{note && <span class="muted">{note}</span>}</figcaption>}
</figure>

<style>
    .shot { display: grid; gap: 8px; margin: 0; }
    .shot-frame { display: block; width: 100%; padding: 0; border: 1px solid var(--hairline); border-radius: var(--radius-control); overflow: hidden; background: var(--surface-alt); box-shadow: var(--shadow-card); text-align: start; }
    .natural .shot-frame { width: fit-content; max-width: 100%; }
    button.shot-frame { cursor: zoom-in; }
    button.shot-frame:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    .shot :global(img) { display: block; width: 100%; height: auto; }
    .natural :global(img) { width: auto; max-width: 100%; }
    /* Only the version of the theme shown exists in the layout: the other is never fetched. */
    :global(html:not([data-theme="dark"])) .shot :global(img.shot-dark) { display: none; }
    :global(html[data-theme="dark"]) .shot :global(img.shot-light) { display: none; }
    figcaption { color: var(--muted-aa); }
    .muted { color: var(--muted); }
</style>
