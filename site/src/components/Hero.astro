---
// The first folder of the case file: the product's own title and tagline, the two actions (the demo filled, the
// download outlined), the note on the demo, and the app itself on a laptop lying on the folder beside the text (under
// it on a phone), with the one stamp of the screen, "works offline". The laptop's screen is a real capture of the app
// (src/assets/hero/NOTES.txt); the one image serves both languages and themes and is never mirrored, so the Arabic
// layout turns the text, not the picture.
import { Picture } from "astro:assets";
import laptop from "../assets/hero/laptop.png";
import Folder from "./Folder.astro";
import Icon from "./Icon.astro";
import { s, t, type Lang } from "../i18n";
import { downloadUrl } from "../content/product";

interface Props { lang: Lang }
const { lang } = Astro.props;
/**
 * The laptop's responsive set: AVIF with a WebP fallback, the transparent background kept, 1440 the cap (the source is
 * 1536 wide, and the fallback <img> is told the same cap, or it would carry a fifth rendition at the source's size).
 * Beside the text it takes a little under half the stage, at most 600 px; on a phone the whole width.
 */
export const laptopImage = { widths: [480, 720, 960, 1440], sizes: "(min-width: 900px) min(46vw - 40px, 600px), calc(100vw - 32px)", formats: ["avif"] as const, fallbackFormat: "webp" as const, quality: 68 };
---
<Folder tone="salmon" no="01" tab={t(lang, "tab.hero")} class="hero" labelledby="hero-title">
    <div class="page stage">
        <div class="reading">
            <h1 id="hero-title" class="display">{s(lang, "WelcomeTitle")}</h1>
            <p class="tagline">{s(lang, "WelcomeTagline")}</p>
            <div class="actions">
                <a class="btn btn-primary" href={`/app?lang=${lang}`}>{t(lang, "hero.cta")}</a>
                <a class="btn" href={downloadUrl} rel="noopener"><Icon name="arrow_download" size={18} /> {t(lang, "hero.download")}</a>
            </div>
            <p class="note small">{t(lang, "hero.note")} <a class="try-link" href={`/${lang}/try/`}>{t(lang, "nav.try")}</a></p>
        </div>
        <div class="device">
            <Picture src={laptop} alt={t(lang, "hero.laptopAlt")} class="laptop" widths={laptopImage.widths} sizes={laptopImage.sizes} formats={laptopImage.formats} fallbackFormat={laptopImage.fallbackFormat} quality={laptopImage.quality} width={1440} height={960} loading="eager" decoding="async" fetchpriority="high" />
            <p class="stamp offline" data-strike>{t(lang, "stamp.offline")}</p>
        </div>
    </div>
</Folder>

<style>
    .hero { padding-block: clamp(40px, 6vw, 72px) clamp(64px, 8vw, 96px); }
    .stage { display: grid; gap: 32px; }
    .reading { display: grid; justify-items: start; align-content: center; }
    .tagline { margin-top: 18px; max-width: 30ch; }
    .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 34px; }
    .note { margin-top: 20px; color: var(--w-muted); max-width: 52ch; }
    .try-link { font-weight: 600; white-space: nowrap; }
    /* The picture's box follows its ratio, so the text never moves when it arrives. */
    .device { position: relative; width: 100%; }
    .laptop { display: block; width: 100%; height: auto; filter: var(--w-lift); }
    .device .stamp { position: absolute; bottom: -4%; inset-inline-start: -2%; --stamp-turn: -5deg; font-size: 1.35rem; }
    /* Two columns from 900 px: the text in the first, the laptop in the second. The grid follows the writing direction,
       so Arabic reads the text on the right and sees the laptop on the left; the picture itself is the same. */
    @media (min-width: 900px) {
        .hero { min-height: min(calc(100dvh - 64px - var(--w-tab-h)), 760px); display: grid; align-items: center; }
        .stage { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); align-items: center; gap: clamp(32px, 4vw, 56px); }
        .device .stamp { bottom: -7%; inset-inline-start: -7%; font-size: 1.6rem; }
    }
    @media (max-width: 599px) { .actions .btn { width: 100%; } .device { margin-top: 8px; } .device .stamp { inset-inline-start: auto; inset-inline-end: 0; bottom: -10%; } }
</style>
