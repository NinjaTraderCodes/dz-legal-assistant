---
// Who built it, closing the file like a petition's signature block: each person's picture clipped on like an
// identity photo in a file (TeamPhoto.astro), the name as the About screen gives it (Arabic script on the Arabic page), the role, and
// what each person did in one line (the About page keeps the full account); then the programme line and the honest note on how it was built.
import Folder from "./Folder.astro";
import TeamPhoto from "./TeamPhoto.astro";
import { s, t, type Lang } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const people = (["Lead", "Design", "Legal"] as const).map((who) => {
    const [name, role] = s(lang, `AboutTeam${who}`).split(" — ");
    return { who, name, role, did: t(lang, `team.did.${who.toLowerCase()}`) };
});
---
<Folder tone="kraft" no="06" tab={t(lang, "tab.team")} id="team" labelledby="team-title">
    <div class="page team">
        <h2 id="team-title" class="h1">{t(lang, "team.title")}</h2>
        <ul class="people">
            {people.map((p) => (
                <li class="person">
                    <TeamPhoto lang={lang} who={p.who} name={p.name} />
                    <div class="lines">
                        <strong class="name">{p.name}</strong>
                        <span class="role">{p.role}</span>
                        <p class="small">{p.did}</p>
                    </div>
                </li>
            ))}
        </ul>
        <p class="lead">{s(lang, "AboutThirdUni")}</p>
        <p class="caption">{t(lang, "team.lead")}</p>
    </div>
</Folder>

<style>
    .team { display: grid; gap: 24px; }
    /* The signature block: three entries over a heavy rule, each a photo clipped to the file and the signed name (the
       rule leaves room for the raised clips). */
    .people { list-style: none; margin: 0; padding: 40px 0 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; border-top: 2px solid var(--w-text); }
    .person { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 16px; align-items: start; }
    .lines { display: grid; gap: 4px; align-content: start; }
    .name { font-family: var(--w-display); font-size: 1.45rem; font-weight: 600; line-height: 1.2; padding-bottom: 6px; border-bottom: 1px solid var(--w-rule); }
    .role { font-weight: 600; font-size: 0.92rem; }
    .lines p { margin-top: 4px; color: var(--w-muted); }
    /* The app's English roles are lower-case fragments ("project lead and development"); the entry opens them with a capital. */
    :global(html[lang="en"]) .role::first-letter { text-transform: uppercase; }
    @media (max-width: 899px) { .people { grid-template-columns: 1fr; } }
</style>
