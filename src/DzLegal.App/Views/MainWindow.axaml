<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DzLegal.Presentation.ViewModels"
        xmlns:app="using:DzLegal.App"
        xmlns:ic="using:FluentIcons.Avalonia"
        x:Class="DzLegal.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="1440" Height="900" MinWidth="1100" MinHeight="640"
        FontFamily="{StaticResource UiFont}"
        RequestedThemeVariant="{Binding IsDarkTheme, Converter={x:Static app:Converters.DarkTheme}}"
        FlowDirection="{Binding IsRightToLeft, Converter={x:Static app:Converters.RightToLeft}}"
        Background="{DynamicResource CanvasBrush}">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewCommand}" />
    <KeyBinding Gesture="Ctrl+P" Command="{Binding ExportPdfCommand}" />
    <KeyBinding Gesture="Ctrl+G" Command="{Binding GenerateCommand}" />
  </Window.KeyBindings>

  <Window.Resources>
    <!-- One article to tick: citation, role, the model's reason, official text, provenance (reference, official link, tag). -->
    <DataTemplate x:Key="ArticleChoiceTemplate" x:DataType="vm:ArticleChoiceViewModel">
      <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
        <StackPanel Spacing="3">
          <Grid ColumnDefinitions="*,Auto">
            <CheckBox IsChecked="{Binding IsSelected}">
              <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Citation}" />
            </CheckBox>
            <Border Grid.Column="1" Classes="chip" Padding="6,1" VerticalAlignment="Center" IsVisible="{Binding HasRole}">
              <TextBlock FontSize="11" Text="{Binding RoleText}" />
            </Border>
          </Grid>
          <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" Text="{Binding ModelReason}" IsVisible="{Binding HasModelReason}" />
          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding Why}" IsVisible="{Binding HasWhy}" />
          <Expander Padding="6,2" HorizontalAlignment="Stretch" IsVisible="{Binding IsAvailable}">
            <Expander.Header>
              <TextBlock FontFamily="{StaticResource DocumentFont}" FontSize="13" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Text="{Binding Text}" />
            </Expander.Header>
            <TextBlock FontFamily="{StaticResource DocumentFont}" FontSize="13" TextWrapping="Wrap" Text="{Binding Text}" />
          </Expander>
          <TextBlock Classes="muted" FontSize="11" FontStyle="Italic" TextWrapping="Wrap" Text="{Binding Text}" IsVisible="{Binding !IsAvailable}" />
          <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="0,5,0,0" Margin="0,3,0,0">
            <StackPanel Spacing="3">
              <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" Text="{Binding ReferenceText}" />
              <WrapPanel>
                <Button Classes="subtle" Padding="0,2" Margin="0,0,10,0" Command="{Binding OpenSourceCommand}" IsVisible="{Binding HasSource}" ToolTip.Tip="{Binding LinkTooltip}">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <ic:SymbolIcon Symbol="Open" FontSize="12" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock FontSize="11" Foreground="{DynamicResource AccentBrush}" TextDecorations="Underline" Text="{Binding LinkLabel}" />
                  </StackPanel>
                </Button>
                <Border CornerRadius="4" Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center" Background="{DynamicResource WarningSoftBrush}" IsVisible="{Binding !IsVerified}">
                  <TextBlock FontSize="10" Foreground="{DynamicResource WarningBrush}" Text="{Binding ProvenanceTag}" />
                </Border>
                <Border CornerRadius="4" Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center" Background="{DynamicResource SuccessSoftBrush}" IsVisible="{Binding IsVerified}">
                  <TextBlock FontSize="10" Foreground="{DynamicResource SuccessBrush}" Text="{Binding ProvenanceTag}" />
                </Border>
                <TextBlock Classes="muted" FontSize="10" VerticalAlignment="Center" Text="{Binding SourceText}" />
              </WrapPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- A usual request or document to insert with one click. -->
    <DataTemplate x:Key="InsertChipTemplate" x:DataType="vm:InsertChipViewModel">
      <Button Classes="outline" Margin="0,0,0,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="{Binding InsertCommand}">
        <Grid ColumnDefinitions="Auto,*">
          <ic:SymbolIcon Symbol="Add" FontSize="13" Margin="0,0,6,0" IsVisible="{Binding !IsInserted}" />
          <ic:SymbolIcon Symbol="Checkmark" FontSize="13" Margin="0,0,6,0" Foreground="{DynamicResource SuccessBrush}" IsVisible="{Binding IsInserted}" />
          <TextBlock Grid.Column="1" FontSize="12" TextWrapping="Wrap" Text="{Binding Text}" />
        </Grid>
      </Button>
    </DataTemplate>

    <!-- What the local model is doing: steps (done, current, next), a timer, "waking up" until the first words, then the words live. -->
    <DataTemplate x:Key="ModelActivityTemplate" x:DataType="vm:ModelActivityViewModel">
      <Border Name="ActivityPanel" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
              CornerRadius="8" Padding="10,8" IsVisible="{Binding IsActive}">
        <StackPanel Spacing="6">
          <ItemsControl ItemsSource="{Binding Steps}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ActivityStepViewModel">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,1">
                  <Panel Width="16" Height="16" VerticalAlignment="Center">
                    <ic:SymbolIcon Symbol="CheckmarkCircle" FontSize="16" Foreground="{DynamicResource SuccessBrush}" IsVisible="{Binding IsDone}" />
                    <Ellipse Classes="pulse" Width="10" Height="10" Fill="{DynamicResource AccentBrush}" IsVisible="{Binding IsActive}" />
                    <Ellipse Width="8" Height="8" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.5" IsVisible="{Binding IsPending}" />
                  </Panel>
                  <TextBlock FontSize="12" VerticalAlignment="Center" Text="{Binding Label}" Classes.muted="{Binding IsPending}" Classes.current="{Binding IsActive}" />
                  <TextBlock Classes="muted" FontSize="11" VerticalAlignment="Center" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ProgressBar IsIndeterminate="True" Height="3" MinHeight="3" CornerRadius="2" IsVisible="{Binding IsWaiting}" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" Text="{Binding WaitingText}" IsVisible="{Binding IsWaiting}" />
            <TextBlock Classes="muted" FontSize="11" Text="{Binding WordsText}" IsVisible="{Binding !IsWaiting}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0">
              <ic:SymbolIcon Symbol="Clock" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
              <TextBlock Name="ActivityElapsed" Classes="muted" FontSize="11" Text="{Binding Elapsed}" />
            </StackPanel>
          </Grid>
          <Border Background="{DynamicResource PaperBrush}" CornerRadius="6" Padding="8,6" IsVisible="{Binding HasLiveText}">
            <StackPanel Spacing="2">
              <TextBlock FontSize="10" Foreground="#6A706D" Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).L[ActivityLive]}" />
              <TextBlock Name="ActivityLiveText" FontFamily="{StaticResource DocumentFont}" FontSize="13" Foreground="#1C2321" TextWrapping="Wrap"
                         FlowDirection="RightToLeft" Text="{Binding LiveText}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.status.error">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
    </Style>
    <Style Selector="Border.chip">
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
    </Style>

    <!-- App bar buttons -->
    <Style Selector="Button.bar">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AppBarTextBrush}" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
    </Style>
    <Style Selector="Button.bar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#26FFFFFF" />
      <Setter Property="Foreground" Value="{DynamicResource AppBarTextBrush}" />
    </Style>
    <Style Selector="Button.subtle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource PrimaryButtonBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.outline">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
    </Style>

    <!-- Form inputs: roomy, rounded, always right-to-left (Arabic document content). -->
    <Style Selector="TextBox.input">
      <Setter Property="FlowDirection" Value="RightToLeft" />
      <Setter Property="FontFamily" Value="{StaticResource DocumentFont}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    </Style>
    <Style Selector="TextBox.input.missing">
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
    </Style>

    <!-- Draft section editor: reads like the document, not like a form. -->
    <Style Selector="TextBox.document">
      <Setter Property="FontFamily" Value="{StaticResource DocumentFont}" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="FlowDirection" Value="RightToLeft" />
      <Setter Property="Foreground" Value="#1C2321" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="CaretBrush" Value="#1C2321" />
    </Style>
    <Style Selector="TextBox.document:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#0A1E5A4B" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.document:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#061E5A4B" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <!-- A gentle pulse on whatever the model is working on right now. -->
    <Style Selector="Ellipse.pulse">
      <Style.Animations>
        <Animation Duration="0:0:0.9" IterationCount="Infinite" PlaybackDirection="Alternate">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.2" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="TextBlock.current">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Ellipse.status-dot">
      <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
    </Style>
    <Style Selector="Ellipse.status-dot.down">
      <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="Border.added">
      <Setter Property="Background" Value="#D7F0DF" />
    </Style>
    <Style Selector="Border.removed">
      <Setter Property="Background" Value="#F8D9D6" />
    </Style>
    <Style Selector="Border.lawyer">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
    <Style Selector="TextBlock.review">
      <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Margin" Value="0,6,0,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Step list -->
    <Style Selector="ListBox.steps ListBoxItem">
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
    </Style>
    <Style Selector="ListBox.steps ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>

    <!-- Findings -->
    <Style Selector="Button.finding">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.finding.warning">
      <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <!-- App bar -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource AppBarBrush}" Padding="16,8">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <ic:SymbolIcon Symbol="Gavel" Foreground="{DynamicResource AppBarTextBrush}" FontSize="22" />
          <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource AppBarTextBrush}" VerticalAlignment="Center" Text="{Binding L[AppTitle]}" />
          <TextBlock Foreground="#B9D3CA" VerticalAlignment="Center" Text="{Binding DocumentTypeName}" />
          <Border Width="1" Height="22" Background="#33FFFFFF" Margin="8,0" />
          <Button Classes="bar" Command="{Binding NewCommand}" ToolTip.Tip="{Binding L[New]}">
            <StackPanel Orientation="Horizontal" Spacing="6"><ic:SymbolIcon Symbol="DocumentAdd" Foreground="{DynamicResource AppBarTextBrush}" /><TextBlock Foreground="{DynamicResource AppBarTextBrush}" Text="{Binding L[New]}" /></StackPanel>
          </Button>
          <Button Classes="bar" Command="{Binding OpenCommand}" ToolTip.Tip="{Binding L[Open]}">
            <StackPanel Orientation="Horizontal" Spacing="6"><ic:SymbolIcon Symbol="FolderOpen" Foreground="{DynamicResource AppBarTextBrush}" /><TextBlock Foreground="{DynamicResource AppBarTextBrush}" Text="{Binding L[Open]}" /></StackPanel>
          </Button>
          <Button Classes="bar" Command="{Binding SaveCommand}" ToolTip.Tip="{Binding L[Save]}">
            <StackPanel Orientation="Horizontal" Spacing="6"><ic:SymbolIcon Symbol="Save" Foreground="{DynamicResource AppBarTextBrush}" /><TextBlock Foreground="{DynamicResource AppBarTextBrush}" Text="{Binding L[Save]}" /></StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Border Classes="chip" Background="#264CAF7F" VerticalAlignment="Center" IsVisible="{Binding IsOfflineEngine}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ic:SymbolIcon Symbol="ShieldCheckmark" Foreground="#9FE0C3" FontSize="14" />
              <TextBlock Foreground="#CFEBDD" FontSize="12" Text="{Binding L[OfflineStatus]}" />
            </StackPanel>
          </Border>
          <!-- Testing build only: an online engine is selected, so the case notes leave the computer. -->
          <Border Name="OnlineEngineChip" Classes="chip" Background="#FFF3DC" VerticalAlignment="Center" IsVisible="{Binding !IsOfflineEngine}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ic:SymbolIcon Symbol="Warning" Foreground="#935600" FontSize="14" />
              <TextBlock Foreground="#5B3B00" FontSize="12" FontWeight="SemiBold" Text="{Binding L[OnlineEngineStatus]}" />
            </StackPanel>
          </Border>
          <Button Classes="bar" Command="{Binding ToggleThemeCommand}" ToolTip.Tip="{Binding L[ToggleTheme]}">
            <ic:SymbolIcon Symbol="WeatherMoon" Foreground="{DynamicResource AppBarTextBrush}" />
          </Button>
          <Button Name="LanguageButton" Classes="bar" Command="{Binding SwitchLanguageCommand}" Content="{Binding L[SwitchLanguage]}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Recovery of an autosaved session -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource AccentSoftBrush}" Padding="16,8" IsVisible="{Binding HasRecoverableDraft}">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <ic:SymbolIcon Symbol="ArrowUndo" Foreground="{DynamicResource AccentBrush}" />
        <TextBlock VerticalAlignment="Center" Text="{Binding L[RecoveryPrompt]}" />
        <Button Classes="primary" Command="{Binding RestoreLastSessionCommand}" Content="{Binding L[Restore]}" />
        <Button Classes="subtle" Command="{Binding DismissRecoveryCommand}" Content="{Binding L[Dismiss]}" />
      </StackPanel>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Padding="16,5" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource SurfaceBrush}">
      <TextBlock Name="StatusText" Classes="status" Classes.error="{Binding IsError}" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" FontSize="12" />
    </Border>

    <Grid ColumnDefinitions="390,*,330" Margin="12">
      <!-- Case form, one step at a time -->
      <Border Classes="panel" Name="FormPanel" Padding="16">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="title" Text="{Binding L[CaseForm]}" Margin="0,0,0,10" />
          <ListBox DockPanel.Dock="Top" Classes="steps" Name="StepsList" ItemsSource="{Binding FieldGroups}" SelectedItem="{Binding SelectedStep}"
                   Background="Transparent" Margin="0,0,0,12">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:FieldGroupViewModel">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <ic:SymbolIcon Symbol="CheckmarkCircle" FontSize="15" Foreground="{DynamicResource SuccessBrush}" IsVisible="{Binding IsDone}" />
                  <ic:SymbolIcon Symbol="ErrorCircle" FontSize="15" Foreground="{DynamicResource DangerBrush}" IsVisible="{Binding IsMissing}" />
                  <ic:SymbolIcon Symbol="ErrorCircle" FontSize="15" Foreground="{DynamicResource WarningBrush}" IsVisible="{Binding IsWarning}" />
                  <TextBlock FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding Number}" IsVisible="{Binding IsEmpty}" />
                  <TextBlock FontSize="13" Text="{Binding Label}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto" Margin="0,12,0,0">
            <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding StepPosition}" />
            <Button Grid.Column="1" Classes="outline" Command="{Binding PreviousStepCommand}" Content="{Binding L[Previous]}" Margin="0,0,8,0" />
            <Button Grid.Column="2" Classes="primary" Command="{Binding NextStepCommand}" Content="{Binding L[Next]}" />
          </Grid>

          <ScrollViewer>
            <StackPanel>
              <TextBlock FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" Text="{Binding SelectedStep.Label}" />

              <!-- Grounds step: the analysis (model reads the facts, the library is searched, the model proposes articles). -->
              <StackPanel Name="GroundsPanel" Spacing="10" Margin="0,0,8,14" IsVisible="{Binding IsGroundsStep}">
                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding L[GroundsIntro]}" />
                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding CanAnalyseGrounds}">
                  <Button Name="AnalyseButton" Classes="primary" Command="{Binding AnalyseGroundsCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <ic:SymbolIcon Symbol="Sparkle" Foreground="White" FontSize="15" />
                      <TextBlock Foreground="White" Text="{Binding L[AnalyseGrounds]}" />
                    </StackPanel>
                  </Button>
                  <Button Classes="outline" Command="{Binding AnalyseGroundsCancelCommand}" Content="{Binding L[Cancel]}" IsVisible="{Binding AnalyseGroundsCommand.IsRunning}" />
                </StackPanel>
                <ContentControl Name="AnalysisActivityView" Content="{Binding AnalysisActivity}" ContentTemplate="{StaticResource ModelActivityTemplate}" />
                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding AnalysisStatus}"
                           IsVisible="{Binding AnalysisStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <Border Name="StaleBanner" Background="{DynamicResource WarningSoftBrush}" CornerRadius="6" Padding="8,6" IsVisible="{Binding IsAnalysisStale}">
                  <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" Text="{Binding L[AnalysisStale]}" />
                </Border>

                <Border Classes="card" Padding="10" IsVisible="{Binding HasReading}">
                  <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding L[ModelReading]}" />
                      <Border Classes="chip" Padding="6,0"><TextBlock FontSize="10" Text="{Binding L[ModelTag]}" /></Border>
                    </StackPanel>
                    <TextBlock FontSize="12" TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="{Binding L[ReadingRelationship]}" /><Run Text=" " /><Run Text="{Binding ReadingRelationship}" /></TextBlock>
                    <TextBlock FontSize="12" TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="{Binding L[ReadingBreach]}" /><Run Text=" " /><Run Text="{Binding ReadingBreach}" /></TextBlock>
                    <TextBlock FontSize="12" TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="{Binding L[ReadingSought]}" /><Run Text=" " /><Run Text="{Binding ReadingSought}" /></TextBlock>
                    <TextBlock FontSize="12" TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="{Binding L[ReadingClaims]}" /><Run Text=" " /><Run Text="{Binding ReadingClaims}" /></TextBlock>
                    <TextBlock FontSize="12" Foreground="{DynamicResource SuccessBrush}" Text="{Binding L[ClaimConfirmedNote]}" IsVisible="{Binding IsClaimConfirmed}" />
                  </StackPanel>
                </Border>

                <!-- Nothing is ticked until the lawyer confirms the claim type the model recognised. -->
                <Border Name="ClaimConfirmBar" CornerRadius="6" Padding="10" Background="{DynamicResource WarningSoftBrush}" IsVisible="{Binding NeedsClaimConfirmation}">
                  <StackPanel Spacing="8">
                    <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding L[ClaimConfirmPrompt]}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Name="ConfirmClaimButton" Classes="primary" Command="{Binding ConfirmClaimCommand}">
                        <TextBlock Foreground="White" Text="{Binding L[ConfirmClaim]}" />
                      </Button>
                      <Button Classes="outline" Command="{Binding RejectClaimCommand}" Content="{Binding L[RejectClaim]}" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasAnalysedArticles}">
                  <TextBlock FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding L[ProposedArticles]}" />
                  <Button Grid.Column="1" Classes="subtle" FontSize="12" Command="{Binding TickBasisArticlesCommand}" Content="{Binding L[TickBasis]}" />
                </Grid>
                <ItemsControl Name="AnalysedArticlesList" ItemsSource="{Binding AnalysedArticles}" ItemTemplate="{StaticResource ArticleChoiceTemplate}" />

                <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding L[SelectedGrounds]}" />
                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding L[SelectedGroundsEmpty]}" IsVisible="{Binding !HasSelectedArticles}" />
                <ItemsControl Name="SelectedGroundsList" ItemsSource="{Binding SelectedGrounds}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SelectedArticleViewModel">
                      <Border Classes="chip" Padding="8,2" Margin="0,0,6,6">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <TextBlock FontSize="12" VerticalAlignment="Center" Text="{Binding Citation}" />
                          <Button Classes="subtle" Padding="2" Command="{Binding RemoveCommand}"><ic:SymbolIcon Symbol="Dismiss" FontSize="11" /></Button>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- Requests / Documents steps: the usual lines of the claim types the analysis recognised. -->
              <StackPanel Name="RequestsHelpPanel" Spacing="6" Margin="0,0,8,14" IsVisible="{Binding IsRequestsStep}">
                <Border Background="{DynamicResource WarningSoftBrush}" CornerRadius="6" Padding="8,6" IsVisible="{Binding HasPrerequisites}">
                  <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" Text="{Binding Prerequisites}" />
                </Border>
                <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding L[UsualRequests]}" IsVisible="{Binding HasRequestChips}" />
                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding L[UsualLinesNeedAnalysis]}" IsVisible="{Binding !HasRequestChips}" />
                <ItemsControl ItemsSource="{Binding RequestChips}" ItemTemplate="{StaticResource InsertChipTemplate}" />

                <!-- The document shows the lawyer's own lines; the AI may only propose a checked formal wording. -->
                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" Text="{Binding L[RequestsWordingIntro]}" />
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding CanProposeRequestsWording}">
                  <Button Name="ProposeRequestsWordingButton" Classes="outline" Command="{Binding ProposeRequestsWordingCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <ic:SymbolIcon Symbol="Sparkle" FontSize="14" />
                      <TextBlock Text="{Binding L[ProposeRequestsWording]}" />
                    </StackPanel>
                  </Button>
                  <Button Classes="outline" Command="{Binding ProposeRequestsWordingCancelCommand}" Content="{Binding L[Cancel]}" IsVisible="{Binding ProposeRequestsWordingCommand.IsRunning}" />
                </StackPanel>
                <TextBlock Name="RequestsWordingStatusText" Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding RequestsWordingStatus}"
                           IsVisible="{Binding RequestsWordingStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <Border Classes="card" Padding="10" IsVisible="{Binding HasRequestsProposal}">
                  <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding L[RequestsWordingLabel]}" />
                      <Border Classes="chip" Padding="6,0"><TextBlock FontSize="10" Text="{Binding L[ModelTag]}" /></Border>
                    </StackPanel>
                    <TextBlock Name="RequestsProposalText" FontSize="13" TextWrapping="Wrap" FlowDirection="RightToLeft" Text="{Binding RequestsProposal}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Classes="primary" Command="{Binding AcceptRequestsProposalCommand}"><TextBlock Foreground="White" Text="{Binding L[AcceptRequestsWording]}" /></Button>
                      <Button Classes="outline" Command="{Binding RejectRequestsProposalCommand}" Content="{Binding L[RejectRequestsWording]}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel Spacing="6" Margin="0,0,8,14" IsVisible="{Binding IsDocumentsStep}">
                <Border Background="{DynamicResource WarningSoftBrush}" CornerRadius="6" Padding="8,6" IsVisible="{Binding HasPrerequisites}">
                  <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" Text="{Binding Prerequisites}" />
                </Border>
                <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding L[UsualDocuments]}" IsVisible="{Binding HasDocumentChips}" />
                <ItemsControl ItemsSource="{Binding DocumentChips}" ItemTemplate="{StaticResource InsertChipTemplate}" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding SelectedStep.Fields}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:FieldViewModel">
                    <StackPanel Margin="0,0,8,14" Spacing="5" IsVisible="{Binding IsVisible}">
                      <TextBlock FontSize="13" FontWeight="Medium" Text="{Binding Label}" IsVisible="{Binding !IsBoolean}" />
                      <TextBox Classes="input" Classes.missing="{Binding IsMissing}" Text="{Binding Value}" PlaceholderText="{Binding Hint}" IsVisible="{Binding IsSingleLine}" />
                      <TextBox Classes="input" Classes.missing="{Binding IsMissing}" Text="{Binding Value}" PlaceholderText="{Binding Hint}" IsVisible="{Binding IsMultiline}"
                               AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" MaxHeight="260" />
                      <CheckBox IsChecked="{Binding BoolValue}" Content="{Binding Label}" IsVisible="{Binding IsBoolean}" />
                      <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" IsVisible="{Binding IsChoice}"
                                MinWidth="180" CornerRadius="8" PlaceholderText="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).L[ChooseOption]}">
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="vm:ChoiceOptionViewModel">
                            <TextBlock Text="{Binding Label}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <TextBlock FontSize="12" Foreground="{DynamicResource DangerBrush}" Text="{Binding MissingNote}" IsVisible="{Binding IsMissing}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Grounds step: add an article by hand (number or words, searched in the official texts). -->
              <StackPanel Spacing="6" Margin="0,0,8,8" IsVisible="{Binding IsGroundsStep}">
                <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding L[AddArticleByHand]}" />
                <TextBox Classes="input" Name="ArticleSearchBox" Text="{Binding ArticleQuery}" PlaceholderText="{Binding L[ArticleSearchPlaceholder]}" />
                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding ArticleSearchHint}"
                           IsVisible="{Binding ArticleSearchHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <ItemsControl ItemsSource="{Binding ArticleResults}" ItemTemplate="{StaticResource ArticleChoiceTemplate}" />
              </StackPanel>

            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- Draft -->
      <Border Grid.Column="1" Classes="panel" Margin="12,0" Padding="16,12,16,16">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,0,0,8">
            <TextBlock Classes="title" VerticalAlignment="Center" Text="{Binding L[Document]}" />
            <Border Grid.Column="1" Classes="chip" Margin="10,0,0,0" VerticalAlignment="Center" ToolTip.Tip="{Binding L[DraftBanner]}">
              <TextBlock Name="DraftBanner" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" Text="{Binding L[DraftBadge]}" />
            </Border>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
              <Ellipse Name="ModelStatusDot" Width="10" Height="10" VerticalAlignment="Center" ToolTip.Tip="{Binding ModelStatusText}"
                       Classes="status-dot" Classes.down="{Binding !IsModelReady}"
                       IsVisible="{Binding ModelStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <ComboBox MinWidth="150" MaxWidth="210" CornerRadius="8" ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}" ToolTip.Tip="{Binding L[ProviderLabel]}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProviderOption">
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Name="GenerateButton" Classes="primary" Command="{Binding GenerateCommand}" ToolTip.Tip="{Binding L[GenerateHint]}">
                <StackPanel Orientation="Horizontal" Spacing="6"><ic:SymbolIcon Symbol="Sparkle" Foreground="White" /><TextBlock Foreground="White" Text="{Binding L[Generate]}" /></StackPanel>
              </Button>
              <Button Classes="outline" Command="{Binding GenerateCancelCommand}" Content="{Binding L[Cancel]}" IsVisible="{Binding GenerateCommand.IsRunning}" />
            </StackPanel>
          </Grid>

          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
            <TabControl Name="DraftTabs" SelectedIndex="{Binding SelectedDraftTab}" Padding="0">
              <TabItem Header="{Binding L[Edit]}" FontSize="15" />
              <TabItem Header="{Binding L[Preview]}" FontSize="15" />
            </TabControl>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <CheckBox IsChecked="{Binding DraftWatermark}" Content="{Binding L[Watermark]}" />
              <Button Classes="outline" Name="ExportPdfButton" Command="{Binding ExportPdfCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6"><ic:SymbolIcon Symbol="DocumentPdf" /><TextBlock Text="{Binding L[ExportPdf]}" /></StackPanel>
              </Button>
              <Button Classes="outline" Command="{Binding ExportWordCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6"><ic:SymbolIcon Symbol="DocumentText" /><TextBlock Text="{Binding L[ExportWord]}" /></StackPanel>
              </Button>
              <Button Classes="subtle" Command="{Binding CopyTextCommand}" ToolTip.Tip="{Binding L[CopyText]}">
                <ic:SymbolIcon Symbol="Copy" />
              </Button>
            </StackPanel>
          </Grid>

          <!-- Shown after a refused export: what the lawyer must still do before the document leaves the app. -->
          <Border Name="ExportBlockersPanel" DockPanel.Dock="Top" Margin="0,0,0,6" CornerRadius="6" Padding="10,8"
                  Background="{DynamicResource WarningSoftBrush}" IsVisible="{Binding IsExportBlockedShown}">
            <StackPanel Spacing="4">
              <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding L[ExportBlocked]}" />
              <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding ExportBlockers}" />
            </StackPanel>
          </Border>

          <ContentControl Name="GenerationActivityView" DockPanel.Dock="Top" Margin="0,0,0,6"
                          Content="{Binding GenerationActivity}" ContentTemplate="{StaticResource ModelActivityTemplate}" />

          <Grid>
            <!-- Edit: the sections on paper -->
            <ScrollViewer Background="{DynamicResource PaperCanvasBrush}" CornerRadius="8" IsVisible="{Binding SelectedDraftTab, Converter={x:Static app:Converters.IsZero}}">
              <Border Background="{DynamicResource PaperBrush}" Margin="18" Padding="36,28" CornerRadius="4" MaxWidth="860"
                      BoxShadow="0 2 10 0 #26000000">
                <ItemsControl Name="SectionsList" ItemsSource="{Binding Sections}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SectionViewModel">
                      <StackPanel Margin="0,0,0,14">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,0,0,2">
                          <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#1E5A4B" VerticalAlignment="Center" Text="{Binding Title}" />
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0" VerticalAlignment="Center">
                            <ic:SymbolIcon Symbol="LockClosed" FontSize="12" Foreground="#8A918E" IsVisible="{Binding IsLocked}" />
                            <ic:SymbolIcon Symbol="Edit" FontSize="12" Foreground="#935600" IsVisible="{Binding IsOverridden}" />
                            <TextBlock FontSize="11" Foreground="#8A918E" Text="{Binding Hint}" IsVisible="{Binding !IsWriting}" />
                            <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding IsWriting}">
                              <Ellipse Classes="pulse" Width="8" Height="8" Fill="#1E5A4B" VerticalAlignment="Center" />
                              <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#1E5A4B"
                                         Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).L[SectionWriting]}" />
                            </StackPanel>
                          </StackPanel>
                          <Button Grid.Column="3" Classes="subtle" FontSize="12" Foreground="#1E5A4B" Command="{Binding OverrideCommand}"
                                  Content="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).L[EditManually]}" IsVisible="{Binding CanOverride}" />
                          <Button Grid.Column="3" Classes="subtle" FontSize="12" Foreground="#935600" Command="{Binding RestoreCommand}"
                                  Content="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).L[RestoreFromForm]}" IsVisible="{Binding IsOverridden}" />
                          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" IsVisible="{Binding IsEditable}">
                            <Button Classes="subtle" FontSize="12" Foreground="#1E5A4B" Command="{Binding UndoCommand}" IsVisible="{Binding CanUndo}"
                                    Content="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).L[Undo]}" />
                            <Button Classes="subtle" FontSize="12" Foreground="#1E5A4B" Command="{Binding RedraftCommand}"
                                    Content="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).L[Redraft]}" />
                            <Button Classes="subtle" Name="AssistantButton" FontSize="12" Foreground="#1E5A4B" Command="{Binding OpenAssistantCommand}">
                              <StackPanel Orientation="Horizontal" Spacing="4">
                                <ic:SymbolIcon Symbol="Sparkle" FontSize="13" Foreground="#1E5A4B" />
                                <TextBlock FontSize="12" Foreground="#1E5A4B" Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).L[Assistant]}" />
                              </StackPanel>
                            </Button>
                          </StackPanel>
                        </Grid>
                        <Border Background="#FFF3DC" CornerRadius="6" Padding="8,4" Margin="0,2" IsVisible="{Binding IsConfirmingRedraft}">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="primary" FontSize="12" Command="{Binding RedraftCommand}"
                                    Content="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).L[ConfirmRedraft]}" />
                            <Button Classes="subtle" FontSize="12" Foreground="#1C2321" Command="{Binding CancelRedraftCommand}"
                                    Content="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).L[Cancel]}" />
                          </StackPanel>
                        </Border>
                        <TextBox Classes="document" Text="{Binding Text}" IsReadOnly="{Binding IsReadOnly}" PlaceholderText="{Binding Watermark}" MinHeight="34" />
                        <TextBlock Classes="review" Text="{Binding ReviewText}" IsVisible="{Binding HasReview}" />
                        <CheckBox Name="ReviewedCheck" FontSize="12" IsChecked="{Binding IsReviewed}" IsVisible="{Binding IsAiWritten}"
                                  Content="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).L[ReviewedCheck]}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </ScrollViewer>

            <!-- Preview: the actual PDF pages -->
            <Grid IsVisible="{Binding SelectedDraftTab, Converter={x:Static app:Converters.IsOne}}">
              <ScrollViewer Background="{DynamicResource PaperCanvasBrush}" CornerRadius="8">
                <ItemsControl Name="PreviewPagesList" ItemsSource="{Binding PreviewPages}" Margin="18">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="White" Margin="0,0,0,18" HorizontalAlignment="Center" BoxShadow="0 2 10 0 #33000000">
                        <Image Source="{Binding Converter={x:Static app:Converters.PngToBitmap}}" Stretch="Uniform" MaxWidth="860" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <Border Classes="chip" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10" IsVisible="{Binding IsRenderingPreview}">
                <TextBlock FontSize="12" Text="{Binding L[RenderingPreview]}" />
              </Border>
            </Grid>
          </Grid>
        </DockPanel>
      </Border>

      <!-- Compliance (the assistant takes its place while open, so the paper keeps its width) -->
      <Border Grid.Column="2" Classes="panel" Padding="16" IsVisible="{Binding !IsAssistantOpen}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="title" Text="{Binding L[Compliance]}" Margin="0,0,0,12" />

          <Expander DockPanel.Dock="Bottom" Header="{Binding L[Evaluation]}" IsExpanded="{Binding IsEvaluationOpen}" HorizontalAlignment="Stretch" Margin="0,10,0,0">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding L[Verdict]}" />
              <ComboBox ItemsSource="{Binding Verdicts}" SelectedItem="{Binding SelectedVerdict}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:VerdictOption">
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="{Binding L[MinutesSaved]}" />
              <TextBox Width="120" HorizontalAlignment="Left" Text="{Binding MinutesSaved}" />
              <TextBlock Text="{Binding L[Comments]}" />
              <TextBox AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" Text="{Binding EvaluationComments}" />
              <Button Classes="primary" Command="{Binding SaveEvaluationCommand}" Content="{Binding L[SaveEvaluation]}" />
            </StackPanel>
          </Expander>

          <ScrollViewer>
            <StackPanel Spacing="10">
              <!-- Score -->
              <Border Classes="card" Padding="14" Background="{DynamicResource SurfaceAltBrush}">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding L[ComplianceScore]}" />
                    <TextBlock Grid.Column="1" FontSize="22" FontWeight="Bold" Text="{Binding ScoreText}" />
                  </Grid>
                  <ProgressBar Minimum="0" Maximum="{Binding ApplicableCount}" Value="{Binding PresentCount}" Height="6" CornerRadius="3" />
                  <Grid ColumnDefinitions="Auto,*">
                    <ic:SymbolIcon Symbol="CheckmarkCircle" FontSize="16" Margin="0,2,6,0" VerticalAlignment="Top" Foreground="{DynamicResource SuccessBrush}" IsVisible="{Binding IsAdmissible}" />
                    <ic:SymbolIcon Symbol="ErrorCircle" FontSize="16" Margin="0,2,6,0" VerticalAlignment="Top" Foreground="{DynamicResource DangerBrush}" IsVisible="{Binding !IsAdmissible}" />
                    <TextBlock Grid.Column="1" Name="SummaryText" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Summary}" />
                  </Grid>
                  <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource WarningBrush}" Text="{Binding WarningSummary}"
                             IsVisible="{Binding WarningSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding L[SummaryDisclaimer]}" />
                  <TextBlock Classes="muted" FontStyle="Italic" TextWrapping="Wrap" Text="{Binding L[Unverified]}" />
                </StackPanel>
              </Border>

              <!-- Legal points on the substance (not only the form), as on the web -->
              <Border Name="SubstancePanel" Classes="card" Padding="12" IsVisible="{Binding HasSubstanceIssues}">
                <StackPanel Spacing="6">
                  <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding L[SubstanceHeader]}" />
                  <ItemsControl ItemsSource="{Binding SubstanceIssues}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,6">
                          <ic:SymbolIcon Symbol="Warning" FontSize="15" Margin="0,1,6,0" VerticalAlignment="Top" Foreground="{DynamicResource WarningBrush}" />
                          <TextBlock Grid.Column="1" FontSize="12" TextWrapping="Wrap" Text="{Binding}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <!-- Issues first, clickable -->
              <ItemsControl Name="FindingsList" ItemsSource="{Binding IssueFindings}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:FindingViewModel">
                    <Button Classes="finding" Classes.warning="{Binding IsMissingWarning}"
                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GoToFindingCommand}" CommandParameter="{Binding}">
                      <StackPanel Spacing="3">
                        <Grid ColumnDefinitions="Auto,*">
                          <ic:SymbolIcon Symbol="ErrorCircle" FontSize="16" Margin="0,0,8,0" Foreground="{DynamicResource DangerBrush}" IsVisible="{Binding IsMissingMandatory}" />
                          <ic:SymbolIcon Symbol="ErrorCircle" FontSize="16" Margin="0,0,8,0" Foreground="{DynamicResource WarningBrush}" IsVisible="{Binding IsMissingWarning}" />
                          <TextBlock Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Label}" />
                        </Grid>
                        <TextBlock Classes="muted" Text="{Binding Article}" />
                        <TextBlock FontSize="13" TextWrapping="Wrap" Text="{Binding Message}" />
                        <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding MissingPartsText}" IsVisible="{Binding HasMissingParts}" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Present elements, folded -->
              <Expander Header="{Binding PresentHeader}" HorizontalAlignment="Stretch">
                <ItemsControl ItemsSource="{Binding PresentFindings}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FindingViewModel">
                      <Grid ColumnDefinitions="Auto,*" Margin="0,3">
                        <ic:SymbolIcon Symbol="CheckmarkCircle" FontSize="14" Margin="0,2,8,0" VerticalAlignment="Top" Foreground="{DynamicResource SuccessBrush}" />
                        <StackPanel Grid.Column="1">
                          <TextBlock FontSize="13" TextWrapping="Wrap" Text="{Binding Label}" />
                          <TextBlock Classes="muted" Text="{Binding Article}" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
      <!-- Section assistant -->
      <Border Grid.Column="2" Name="AssistantPanel" Classes="panel" Padding="16" IsVisible="{Binding IsAssistantOpen}">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,4">
            <ic:SymbolIcon Symbol="Sparkle" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" />
            <TextBlock Grid.Column="1" Classes="title" Text="{Binding AssistantTitle}" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="2" Classes="subtle" Command="{Binding CloseAssistantCommand}" Content="✕" />
          </Grid>
          <TextBlock DockPanel.Dock="Top" Classes="muted" TextWrapping="Wrap" Text="{Binding L[AssistantScope]}" Margin="0,0,0,8" />
          <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Shortcuts}" Margin="0,0,0,8">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ShortcutViewModel">
                <Button Classes="outline" FontSize="12" Padding="10,4" Margin="0,0,6,6" CornerRadius="999" Content="{Binding Label}"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).UseShortcutCommand}" CommandParameter="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
            <TextBox Classes="input" Name="InstructionBox" Text="{Binding AssistantInstruction}" PlaceholderText="{Binding L[InstructionPlaceholder]}"
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" MaxHeight="120" />
            <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Bottom">
              <Button Classes="primary" Command="{Binding SendInstructionCommand}" Content="{Binding L[Send]}" IsVisible="{Binding !SendInstructionCommand.IsRunning}" />
              <Button Classes="outline" Command="{Binding SendInstructionCancelCommand}" Content="{Binding L[Cancel]}" IsVisible="{Binding SendInstructionCommand.IsRunning}" />
            </StackPanel>
          </Grid>

          <ScrollViewer>
            <StackPanel Spacing="8">
              <ItemsControl ItemsSource="{Binding AssistantThread}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AssistantMessage">
                    <Border CornerRadius="10" Padding="10,6" Margin="0,0,0,6" Background="{DynamicResource SurfaceAltBrush}" Classes.lawyer="{Binding FromLawyer}">
                      <TextBlock TextWrapping="Wrap" FontSize="13" Text="{Binding Text}" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <ContentControl Content="{Binding AssistantActivity}" ContentTemplate="{StaticResource ModelActivityTemplate}" />

              <Border Background="{DynamicResource PaperBrush}" CornerRadius="8" Padding="10"
                      IsVisible="{Binding AssistantPartial, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock FontFamily="{StaticResource DocumentFont}" FontSize="15" Foreground="#1C2321" TextWrapping="Wrap" FlowDirection="RightToLeft" Text="{Binding AssistantPartial}" />
              </Border>

              <Border Background="{DynamicResource PaperBrush}" CornerRadius="8" Padding="10" IsVisible="{Binding HasProposal}">
                <StackPanel Spacing="8">
                  <ItemsControl Name="ProposalDiffList" ItemsSource="{Binding ProposalDiff}" FlowDirection="RightToLeft">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:DiffTokenViewModel">
                        <Border Margin="0,0,4,3" CornerRadius="3" Padding="2,0" Classes.added="{Binding IsAdded}" Classes.removed="{Binding IsRemoved}">
                          <TextBlock FontFamily="{StaticResource DocumentFont}" FontSize="15" Foreground="#1C2321" Text="{Binding Text}"
                                     TextDecorations="{Binding IsRemoved, Converter={x:Static app:Converters.Strike}}" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="review" Text="{Binding ProposalHints}" IsVisible="{Binding ProposalHints, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Classes="primary" Name="AcceptButton" Command="{Binding AcceptProposalCommand}" IsEnabled="{Binding CanAcceptProposal}" Content="{Binding L[Accept]}" />
                    <Button Classes="outline" Command="{Binding RejectProposalCommand}" Content="{Binding L[Reject]}" />
                    <Button Classes="subtle" Command="{Binding RetryProposalCommand}" Content="{Binding L[TryAgain]}" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
