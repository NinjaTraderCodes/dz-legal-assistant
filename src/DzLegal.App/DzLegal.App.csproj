<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>DzLegalAssistant</AssemblyName>
    <RootNamespace>DzLegal.App</RootNamespace>
    <Description>Desktop shell: guided case form, draft editor and compliance report. Runs fully offline.</Description>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <IncludeLegalData>true</IncludeLegalData>
    <!-- UI strings are resources; the Arabic neutral language lives in Strings.resx. -->
    <NeutralLanguage>ar</NeutralLanguage>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- Shared Arabic fonts (also embedded in PDFs by DzLegal.Documents). -->
    <AvaloniaResource Include="..\..\assets\fonts\*.ttf" Link="Assets\Fonts\%(Filename)%(Extension)" />
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Personal overrides, git-ignored; copied next to the executable when present. -->
    <None Update="appsettings.local.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="FluentIcons.Avalonia" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DzLegal.Documents\DzLegal.Documents.csproj" />
    <ProjectReference Include="..\DzLegal.Drafting\DzLegal.Drafting.csproj" />
    <ProjectReference Include="..\DzLegal.FormEngine\DzLegal.FormEngine.csproj" />
    <ProjectReference Include="..\DzLegal.Law\DzLegal.Law.csproj" />
    <ProjectReference Include="..\DzLegal.ModelProviders.Ollama\DzLegal.ModelProviders.Ollama.csproj" />
    <ProjectReference Include="..\DzLegal.ModelProviders.Stub\DzLegal.ModelProviders.Stub.csproj" />
    <ProjectReference Include="..\DzLegal.Storage\DzLegal.Storage.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DzLegal.App.Tests" />
  </ItemGroup>
</Project>
