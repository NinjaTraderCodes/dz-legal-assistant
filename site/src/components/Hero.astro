---
// The welcome screen of the desktop app, on the web: the photograph under its overlay, the scales mark, the
// product's own title and tagline, one gold action, and the offline line. Nothing else competes with it.
import { Image } from "astro:assets";
import welcome from "../../../src/DzLegal.App/Assets/Images/welcome-bg.jpg";
import ScalesMark from "./ScalesMark.astro";
import Icon from "./Icon.astro";
import { s, t, type Lang } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
/** The photograph's responsive set, shared with the page head's preload so the two name the same files. */
export const heroImage = { widths: [480, 768, 1280, 1920], sizes: "100vw", format: "avif" as const, quality: 62 };
---
<section class="hero" aria-labelledby="hero-title">
    <Image src={welcome} alt="" class="photo" widths={heroImage.widths} sizes={heroImage.sizes} format={heroImage.format} quality={heroImage.quality} loading="eager" fetchpriority="high" />
    <div class="overlay" aria-hidden="true"></div>
    <div class="reading">
        <ScalesMark class="mark" size={88} />
        <h1 id="hero-title" class="display">{s(lang, "WelcomeTitle")}</h1>
        <span class="divider" aria-hidden="true"></span>
        <p class="lead tagline">{s(lang, "WelcomeTagline")}</p>
        <div class="actions">
            <a class="btn btn-gold" href={`/app?lang=${lang}`}>{t(lang, "hero.cta")}</a>
            <a class="btn btn-quiet" href="https://github.com/NinjaTraderCodes/dz-legal-assistant/releases/latest" rel="noopener"><Icon name="arrow_download" size={18} /> {t(lang, "hero.download")}</a>
        </div>
        <p class="note small">{t(lang, "hero.note")}</p>
    </div>
    <p class="offline small"><Icon name="shield_checkmark" size={16} /> {t(lang, "site.offline")}</p>
</section>

<style>
    .hero { position: relative; min-height: min(92dvh, 900px); display: grid; grid-template-rows: 1fr auto; place-items: center; overflow: hidden; isolation: isolate; padding: clamp(24px, 4vw, 48px) var(--gutter) 20px; }
    .photo { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; object-position: center; }
    .overlay { position: absolute; inset: 0; z-index: -1; background: var(--overlay-image); }
    .reading { display: grid; justify-items: center; text-align: center; gap: 0; max-width: 760px; padding: clamp(24px, 4vw, 40px) clamp(20px, 4vw, 48px); border-radius: var(--radius-onboarding-card); background: var(--reading); }
    :global([data-theme="dark"]) .reading { background: transparent; }
    .mark { color: var(--mark); margin-bottom: 24px; }
    h1 { color: var(--welcome-text); }
    :global(html[lang="en"]) h1.display { font-size: clamp(2.25rem, 1.1rem + 3.2vw, 4rem); letter-spacing: 0.01em; white-space: nowrap; }
    @media (max-width: 599px) { :global(html[lang="en"]) h1.display { white-space: normal; } }
    .divider { width: 48px; height: 2px; background: var(--mark); margin-block: 20px; }
    .tagline { max-width: 560px; color: var(--welcome-secondary); }
    .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 32px; }
    .note { margin-top: 20px; color: var(--welcome-secondary); max-width: 520px; }
    .offline { display: inline-flex; align-items: center; gap: 8px; margin-top: 24px; padding: 4px 12px; border-radius: var(--radius-control); background: var(--reading); color: var(--welcome-text); }
    :global([data-theme="dark"]) .offline { background: rgb(36 32 27 / 0.6); }
    @media (max-width: 599px) { .hero { min-height: 0; padding-top: 32px; } .reading { padding-inline: 16px; } .actions .btn { width: 100%; } }
</style>
