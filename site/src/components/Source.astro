---
// The line under a figure or a claim: where in the repository it comes from. Every number on the site has one.
// The file is named, not linked: the site does not send visitors to the repository. The six documents the site
// renders (src/content/docs-pages.ts) are the exception: they are linked to their own pages here.
import { t, type Lang } from "../i18n";
import { isDocPage, docPath } from "../content/docs-pages";

interface Props { lang: Lang; files: string[]; note?: string }
const { lang, files, note } = Astro.props;
const separator = lang === "ar" ? "، " : ", ";
---
<p class="source caption">{t(lang, "source.label")} {files.map((file, i) => <>{isDocPage(file) ? <a class="file" href={`/${lang}${docPath(file)}`} dir="ltr">{file}</a> : <span class="file" dir="ltr">{file}</span>}{i < files.length - 1 ? separator : ""}</>)}{note && <> · {note}</>}</p>

<style>
    .source { margin-top: 6px; }
    .source .file { color: var(--w-muted); overflow-wrap: anywhere; }
    .source a.file { text-decoration: underline; }
</style>
