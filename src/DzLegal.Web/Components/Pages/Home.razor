@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IDisposable
@using DzLegal.Presentation.ViewModels
@using DzLegal.Web.Components.Parts
@using DzLegal.Web.Services

<PageTitle>DZ Legal Assistant · demo</PageTitle>

@if (Vm is null)
{
    <div class="loading">DZ Legal Assistant…</div>
    return;
}

<div id="workbench" class="app @(Vm.IsDarkTheme ? "dark" : "") @(Vm.IsOutlineCompact ? "outline-compact" : "") @(!Vm.IsOutlineVisible ? "outline-hidden" : "") @(Vm.IsToolsOpen ? "tools-open" : "") @(Vm.IsDraftMaximized ? "draft-focus" : "")" data-mobile-tab="@mobileTab" data-tool="@Vm.WorkbenchTool" data-tools-open="@Vm.IsToolsOpen.ToString().ToLowerInvariant()" data-compact="@Vm.IsOutlineCompact.ToString().ToLowerInvariant()" data-outline-visible="@Vm.IsOutlineVisible.ToString().ToLowerInvariant()" dir="@(Vm.IsRightToLeft ? "rtl" : "ltr")" lang="@Lang">
    <header class="appbar">
        <div class="brand">
            <svg class="brand-mark" viewBox="0 0 48 48" aria-hidden="true"><path d="M7 7H30L42 19V44H27V18H7Z" fill="currentColor"/><path d="M7 22H20V44H7Z" fill="#D0AA80"/></svg>
            <h1>DZ Legal</h1><span class="case-name" title="@Vm.CaseTitle">@Vm.CaseTitle</span>
            <span class="doc-type">@Vm.DocumentTypeName</span>
            <span class="demo-chip">@T("DemoChip")</span>
        </div>
        <button class="command-search" type="button" title="@L["WB.Search"]" @onclick="ShowCommands"><span>@L["WB.Search"]</span> <kbd>Ctrl+K</kbd></button>
        <div class="tools"><details class="demo-menu"><summary>@T("Samples")</summary><div>            <select id="sample-picker" aria-label="@T("Samples")" value="" @onchange="OpenSample">
                <option value="">@T("Samples")</option>
                @foreach (var sample in Engine.Samples)
                {
                    <option value="@sample.Id">@sample.Title.Get(Lang)</option>
                }
            </select>            <button type="button" aria-pressed="@(showGuide ? "true" : "false")" @onclick="() => showGuide = !showGuide"><Icon Name="question_circle" /> @T("GuideShow")</button></div></details>
            <button type="button" title="@L["WB.ToggleOutline"]" aria-label="@L["WB.ToggleOutline"]" @onclick="() => Vm.ToggleOutlineCommand.Execute(null)"><Icon Name="document_text" /></button>

            <button type="button" title="@L["New"]" aria-label="@L["New"]" @onclick="() => Vm.NewCommand.Execute(null)"><Icon Name="add" /> <span class="header-label">@L["New"]</span></button>
            @* Open and Save as on the desktop: a draft file (.dzdraft.json) from and to the visitor's own disk. *@
            <label class="button-like" title="@L["Open"]" aria-label="@L["Open"]"><Icon Name="folder_open" /> <span class="header-label">@L["Open"]</span><InputFile aria-label="@L["Open"]" class="visually-hidden" accept=".json,application/json" OnChange="OpenDraftFile" /></label>
            <button type="button" title="@L["Save"]" aria-label="@L["Save"]" @onclick="() => Run(Vm.SaveCommand)"><Icon Name="save" /> <span class="header-label">@L["Save"]</span></button>
            @if (Vm.HasSaveState)
            {
                <span class="save-state">@Vm.SaveStateText</span>
            }

            <button type="button" aria-label="@T("Theme")" title="@T("Theme")" @onclick="() => Vm.ToggleThemeCommand.Execute(null)"><Icon Name="weather_moon" /></button>
            <button type="button" lang="@(Lang == "en" ? "ar" : "en")" @onclick="() => Vm.SwitchLanguageCommand.Execute(null)"><Icon Name="translate" /> @L["SwitchLanguage"]</button>
        </div>
    </header>

    <div class="strip">
        @if (!Engine.Settings.HasAnyEngine)
        {
            <div class="notice" role="status">@T("NoEngine")</div>
        }
        @if (Vm.IsConfirmingReplace)
        {
            <div class="notice" role="alertdialog" aria-label="@Vm.ReplacePrompt">
                <span class="grow">@Vm.ReplacePrompt</span>
                <button type="button" class="primary small" @onclick="() => Run(Vm.SaveThenReplaceCommand)">@L["SaveFirst"]</button>
                <button type="button" class="small" @onclick="() => Run(Vm.ReplaceWithoutSavingCommand)">@L["ContinueWithoutSaving"]</button>
                <button type="button" class="small" @onclick="() => Vm.CancelReplaceCommand.Execute(null)">@L["Cancel"]</button>
            </div>
        }
        @if (SavedCase is not null)
        {
            <div class="notice info" role="status">
                <span class="grow">@string.Format(L.Culture, T("SavedCase"), SavedAt?.ToLocalTime().ToString("g", L.Culture))</span>
                <button type="button" class="primary small" @onclick="RestoreSavedCase">@T("RestoreCase")</button>
                <button type="button" class="small" @onclick="DiscardSavedCase">@T("DiscardCase")</button>
            </div>
        }
        @if (showGuide)
        {
            <section class="guide" aria-labelledby="guide-title">
                <div class="guide-head">
                    <h2 id="guide-title">@T("GuideTitle")</h2>
                    <button type="button" class="quiet small" @onclick="() => showGuide = false"><Icon Name="dismiss" Size="14" /> @T("GuideHide")</button>
                </div>
                <ol>
                    <li>
                        <strong>@T("Guide1Title")</strong>
                        <p class="muted">@T("Guide1")</p>
                        <span class="actions">
                            @foreach (var sample in Engine.Samples)
                            {
                                <button type="button" class="small" @onclick="() => Open(sample)">@sample.Title.Get(Lang)</button>
                            }
                        </span>
                    </li>
                    <li>
                        <strong>@T("Guide2Title")</strong>
                        <p class="muted">@T("Guide2")</p>
                        <span class="actions"><button type="button" class="small" @onclick='() => GoToStep("defendant")'>@T("OpenDefendant")</button></span>
                    </li>
                    <li class="ai">
                        <strong>@T("Guide3Title")</strong>
                        <p class="muted">@T("Guide3")</p>
                        <span class="actions"><button type="button" class="small" @onclick='() => GoToStep(MainWindowViewModel.GroundsStepId)'>@T("OpenGrounds")</button></span>
                    </li>
                    <li class="ai">
                        <strong>@T("Guide4Title")</strong>
                        <p class="muted">@T("Guide4")</p>
                    </li>
                    <li>
                        <strong>@T("Guide5Title")</strong>
                        <p class="muted">@T("Guide5")</p>
                    </li>
                </ol>
                <p class="muted small">@T("AboutDemo")</p>
                <p class="row small"><button type="button" class="small" @onclick="ClearBrowserCopy">@T("ClearBrowserCopy")</button>
                    @if (_browserCopyCleared) { <span class="muted" role="status">@T("BrowserCopyCleared")</span> }</p>
            </section>
        }
    </div>

    @if(Vm.IsError) { <div class="notice error-notice" role="alert">@Vm.StatusMessage</div> }
    <nav class="mobile-tabs" role="tablist" aria-label="@L["AppTitle"]">
        <button type="button" role="tab" aria-selected="@(mobileTab == 0 ? "true" : "false")" @onclick="() => SelectMobileTab(0)">@T("TabCase")</button>
        <button type="button" role="tab" aria-selected="@(mobileTab == 1 ? "true" : "false")" @onclick="() => SelectMobileTab(1)">@T("TabDraft")</button>
        <button type="button" role="tab" aria-selected="@(mobileTab == 2 ? "true" : "false")" @onclick="() => SelectMobileTab(2)">@T("TabChecks") @(Vm.HasIssues || Vm.HasSubstanceIssues ? "•" : "")</button>
    </nav>

    <main class="columns">
<aside class="outline" dir="@(Vm.IsRightToLeft ? "rtl" : "ltr")" aria-label="@L["WB.Outline"]">
 <button class="quiet" type="button" title="@L["WB.CompactOutline"]" aria-label="@L["WB.CompactOutline"]" @onclick="() => Vm.ToggleOutlineCompactCommand.Execute(null)"><Icon Name="document_text"/></button>
            <nav class="steps" aria-label="@L["CaseForm"]">
                @foreach (var step in Vm.FieldGroups)
                {
                    var current = step == Vm.SelectedStep;
                    <button type="button" class="step @StepClass(step) @(current ? "selected" : "")" title="@step.Label" aria-label="@step.Label" aria-current="@(current ? "step" : null)" @onclick="() => SelectStep(step)">
                        <Icon Name="@StepIcon(step.Id)" Size="20"/>
                        <span class="mark">
                            @if (step.IsDone)
                            {
                                <Icon Name="checkmark" Size="12" />
                            }
                            else if (step.IsMissing && Visited(step))
                            {
                                <span>!</span>
                            }
                            else
                            {
                                <span>@step.Number</span>
                            }
                        </span>
                        <span class="step-label">@step.Label</span>
                    </button>
                }
            </nav></aside>
<div class="workbench-splitter" data-resize="outline" tabindex="0" role="separator" aria-orientation="vertical" aria-label="@L["WB.ResizeOutline"]"></div>
<div class="editor-stack" dir="@(Vm.IsRightToLeft ? "rtl" : "ltr")">
        <section class="panel form-panel @(mobileTab == 0 ? "current" : "")" dir="@(Vm.IsRightToLeft ? "rtl" : "ltr")" aria-labelledby="case-title">
            <h2 id="case-title">@L["CaseForm"]</h2>


            @if (Vm.SelectedStep is { } selectedStep)
            {
                <div class="editor-head"><h3>@selectedStep.Label</h3>                <div class="step-nav">
                    <span class="muted small">@Vm.StepPosition</span>
                    <span class="buttons">
                        <button type="button" @onclick="() => Move(-1)">@L["Previous"]</button>
                        <button type="button" class="primary" @onclick="() => Move(1)">@L["Next"]</button>
                    </span>
                </div></div>
                @if (Vm.IsGroundsStep)
                {
                    <GroundsPanel Vm="Vm" />
                }
                @foreach (var field in selectedStep.Fields.Where(f => f.IsVisible))
                {
                    <FieldEditor @key="field.Id" Field="field" ChooseLabel="@L["ChooseOption"]" HelpLabel="@L["WB.Help"]" />
                }
                @if (Vm.IsRequestsStep || Vm.IsDocumentsStep)
                {
                    var chips = Vm.IsRequestsStep ? Vm.RequestChips : Vm.DocumentChips;
                    <div class="chips">
                        <div class="label">@(Vm.IsRequestsStep ? L["UsualRequests"] : L["UsualDocuments"])</div>
                        @if (chips.Count == 0)
                        {
                            <div class="muted small">@(Vm.IsRequestsStep ? L["UsualRequestsNeedAnalysis"] : L["UsualDocumentsNeedAnalysis"])</div>
                        }
                        @foreach (var chip in chips)
                        {
                            <button type="button" class="chip-line @(chip.IsInserted ? "inserted" : "")" dir="rtl" @onclick="() => chip.InsertCommand.Execute(null)">
                                <Icon Name="@(chip.IsInserted ? "checkmark" : "add")" Size="14" /> @chip.Text
                            </button>
                        }
                    </div>
                }
                @if (Vm.IsRequestsStep)
                {
                    @* The document shows the lawyer's own lines; the AI may only propose a checked formal wording. *@
                    <div class="requests-wording">
                        <p class="muted small">@L["RequestsWordingIntro"]</p>
                        @if (Vm.CanProposeRequestsWording)
                        {
                            @if (Vm.ProposeRequestsWordingCommand.IsRunning)
                            {
                                <button type="button" @onclick="() => Vm.ProposeRequestsWordingCancelCommand.Execute(null)"><Icon Name="stop" /> @L["Cancel"]</button>
                            }
                            else
                            {
                                <button type="button" class="ai" disabled="@CommandRunner.IsAiBusy(Vm)" @onclick="() => CommandRunner.RunAsync(Vm, Vm.ProposeRequestsWordingCommand)"><Icon Name="sparkle" /> @L["ProposeRequestsWording"]</button>
                            }
                        }
                        @if (Vm.RequestsWordingStatus.Length > 0)
                        {
                            <div class="small muted" role="status">@Vm.RequestsWordingStatus</div>
                        }
                        @if (Vm.HasRequestsProposal)
                        {
                            <div class="reading">
                                <div class="section-title-row"><h3>@L["RequestsWordingLabel"]</h3><span class="tag ai"><Icon Name="sparkle" Size="12" /> @L["ModelTag"]</span></div>
                                <ol class="arabic" dir="rtl" lang="ar">
                                    @foreach (var line in Vm.RequestsProposal.Split('\n'))
                                    {
                                        <li>@line</li>
                                    }
                                </ol>
                                <div class="row">
                                    @* Suggestion only (audit C-02): the checks see amounts and counts, not who pays whom or what is asked. *@
                                    <button type="button" @onclick="() => Vm.RejectRequestsProposalCommand.Execute(null)">@L["RejectRequestsWording"]</button>
                                </div>
                            </div>
                        }
                    </div>
                }

            }
        </section>

<div class="editor-engine">                <div class="draft-actions">
                    <select id="engine-picker" aria-label="@L["ProviderLabel"]" value="@Vm.SelectedProvider?.Key" @onchange="SelectProvider">
                        @foreach (var p in Vm.Providers)
                        {
                            <option value="@p.Key">@p.DisplayName</option>
                        }
                    </select>
                    @if (Vm.GenerateCommand.IsRunning)
                    {
                        <button type="button" @onclick="() => Vm.GenerateCancelCommand.Execute(null)"><Icon Name="stop" /> @L["Cancel"]</button>
                    }
                    else
                    {
                        <button type="button" class="ai" disabled="@CommandRunner.IsAiBusy(Vm)" @onclick="() => Run(Vm.GenerateCommand)"><Icon Name="sparkle" /> @L["Generate"]</button>
                    }
                </div></div>
<div class="workbench-splitter horizontal" data-resize="tools" tabindex="0" role="separator" aria-orientation="horizontal" aria-label="@L["WB.ResizeTools"]" hidden="@(!Vm.IsToolsOpen)"></div>
<div class="workbench-tools">        @* ── The checks: form (rule engine, no AI) and substance ──────────── *@
        <section class="panel check-panel @(mobileTab == 2 ? "current" : "")" hidden="@(!Vm.IsToolsOpen || !Vm.IsReviewTool)" aria-labelledby="check-title">
            <h2 id="check-title">@L["Compliance"]</h2>
            <div class="score-card @(Vm.IsAdmissible ? "ok" : "ko")">
                <div class="score-row">
                    <span class="muted">@L["ComplianceScore"]</span>
                    <span class="score">@Vm.PresentCount / @Vm.ApplicableCount</span>
                </div>
                <div class="bar" role="progressbar" aria-label="@L["ComplianceScore"]" aria-valuemin="0" aria-valuemax="@Vm.ApplicableCount" aria-valuenow="@Vm.PresentCount">
                    <span style="width:@(Vm.ApplicableCount == 0 ? 0 : 100 * Vm.PresentCount / Vm.ApplicableCount)%"></span>
                </div>
                <div class="summary"><Icon Name="@(Vm.IsAdmissible ? "checkmark_circle" : "error_circle")" /> @Vm.Summary</div>
                @if (Vm.WarningSummary.Length > 0)
                {
                    <div class="small">@Vm.WarningSummary</div>
                }
                <div class="caveats muted small">
                    <span>@L["SummaryDisclaimer"]</span>
                    <span>@L["Unverified"]</span>
                </div>
            </div>

            @if (Vm.HasSubstanceIssues)
            {
                <h3>@L["SubstanceHeader"]</h3>
                @foreach (var point in Vm.SubstanceIssues)
                {
                    <div class="legal-point"><Icon Name="warning" /> <span>@point</span></div>
                }
            }

            @if (Vm.IssueFindings.Count > 0)
            {
                <h3>@T("Issues")</h3>
                @foreach (var f in Vm.IssueFindings)
                {
                    <button type="button" class="finding @(f.IsMissingMandatory ? "mandatory" : "warning")" @onclick="() => GoToFinding(f)">
                        <strong>@f.Label</strong>
                        <span class="article">@f.Article</span>
                        @if (f.HasMessage)
                        {
                            <span class="small">@f.Message</span>
                        }
                        @if (f.HasMissingParts)
                        {
                            <span class="small muted">@f.MissingPartsText</span>
                        }
                    </button>
                }
            }

            <details class="present" open="@(Vm.IssueFindings.Count == 0)">
                <summary>@Vm.PresentHeader</summary>
                @foreach (var f in Vm.PresentFindings)
                {
                    <div class="present-item">
                        <span><Icon Name="checkmark" Size="14" /> @f.Label</span>
                        <span class="article">@f.Article</span>
                    </div>
                }
            </details>
        </section>
<section class="source-tool" hidden="@(!Vm.IsToolsOpen || !Vm.IsSourceTool)" aria-label="@L["WB.Source"]">
 <p class="small muted">@L["WB.NoSource"]</p>
 <input class="arabic" dir="rtl" aria-label="@L["ArticleSearchPlaceholder"]" placeholder="@L["ArticleSearchPlaceholder"]" @bind="Vm.ArticleQuery" @bind:event="oninput"/>
 <p class="small">@Vm.ArticleSearchHint</p>
 @foreach(var article in Vm.ArticleResults) { <ArticleCard Article="article" Vm="Vm" IdPrefix="source-art"/> }
</section>
<section class="assistant-tool" hidden="@(!Vm.IsToolsOpen || !Vm.IsAssistantTool)" aria-label="@L["WB.Assistant"]">
 @if(Vm.AssistantSection is not null) { <AssistantPanel Vm="Vm"/> } else { <p>@L["AssistantScope"]</p> }
</section>
<section class="activity-tool" hidden="@(!Vm.IsToolsOpen || !Vm.IsActivityTool)" aria-label="@L["WB.Activity"]">
 <p>@Vm.ModelStatusText</p>
 <ModelActivity Model="Vm.AnalysisActivity" LiveLabel="@L["ActivityLive"]"/>
 <ModelActivity Model="Vm.GenerationActivity" LiveLabel="@L["ActivityLive"]"/>
 <ModelActivity Model="Vm.AssistantActivity" LiveLabel="@L["ActivityLive"]"/>
</section></div><nav class="tool-tabs" aria-label="@L["WB.HideTools"]">
 @foreach(var tool in new[] { ("WB.BeforeExport", "review"), ("WB.Source", "source"), ("WB.Assistant", "assistant"), ("WB.Activity", "activity") })
 {
  <button type="button" aria-pressed="@(Vm.IsToolsOpen && Vm.WorkbenchTool == tool.Item2 ? "true" : "false")" @onclick="() => ShowTool(tool.Item2)">@L[tool.Item1] @(tool.Item2 == "review" && Vm.ShowsExportBlockers ? Vm.ExportBlockerCount.ToString(L.Culture) : "")</button>
 }
 <button class="quiet" type="button" hidden="@(!Vm.IsToolsOpen)" aria-label="@L["WB.HideTools"]" @onclick="() => Vm.HideWorkbenchToolsCommand.Execute(null)"><Icon Name="dismiss"/></button>
</nav></div>
<div class="workbench-splitter" data-resize="editor" tabindex="0" role="separator" aria-orientation="vertical" aria-label="@L["WB.ResizeDraft"]"></div>
        @* ── The statement of claim on paper: drafting, preview, export ──── *@
        <section class="panel draft-panel @(mobileTab == 1 ? "current" : "")" dir="@(Vm.IsRightToLeft ? "rtl" : "ltr")" aria-labelledby="draft-title">
            <div class="panel-head">
                <h2 id="draft-title">@L["Document"] <span class="badge">@L["DraftBadge"]</span></h2>
<button type="button" class="quiet" title="@L["WB.FocusDraft"]" aria-label="@L["WB.FocusDraft"]" @onclick="() => Vm.ToggleDraftFocusCommand.Execute(null)"><Icon Name="eye"/></button>
            </div>
            <p class="muted small">@L["GenerateHint"]</p>
            @if (Vm.HasAnsweredBy)
            {
                <p class="small answered-by" dir="ltr"><Icon Name="sparkle" Size="12" /> @Vm.AnsweredBy</p>
            }

            <div class="toolbar">
                <div class="tabs" role="tablist">
                    <button type="button" role="tab" class="tab" aria-selected="@(Vm.SelectedDraftTab == 0 ? "true" : "false")" @onclick="() => Vm.SelectedDraftTab = 0"><Icon Name="edit" Size="16" /> @L["Edit"]</button>
                    <button type="button" role="tab" class="tab" aria-selected="@(Vm.SelectedDraftTab == 1 ? "true" : "false")" @onclick="() => Vm.SelectedDraftTab = 1"><Icon Name="eye" Size="16" /> @L["Preview"]</button>
                </div>
                <label class="check small"><input id="watermark" type="checkbox" @bind="Vm.DraftWatermark" /> @L["Watermark"]</label>
                <button type="button" class="small" @onclick="() => Run(Vm.ExportPdfCommand)"><Icon Name="arrow_download" Size="16" /> @L["ExportPdf"]</button>
                <button type="button" class="small" @onclick="() => Run(Vm.ExportWordCommand)"><Icon Name="arrow_download" Size="16" /> @L["ExportWord"]</button>
                <button type="button" class="small" @onclick="() => Run(Vm.CopyTextCommand)"><Icon Name="copy" Size="16" /> @L["CopyText"]</button>
            </div>

            @if (Vm.ShowsExportBlockers)
            {
                <div class="notice export-blockers" role="@(Vm.IsExportBlockedShown ? "alert" : "status")">
                    <strong>@Vm.ExportBlockersTitle</strong>
                    <div class="small" style="white-space: pre-line">@Vm.ExportBlockers</div>
                </div>
            }

            <ModelActivity Model="Vm.GenerationActivity" LiveLabel="@L["ActivityLive"]" />

            @if (Vm.SelectedDraftTab == 0)
            {
                <div class="paper-canvas">
                    <div class="paper" dir="rtl" lang="ar">
                        @foreach (var section in Vm.Sections)
                        {
                            <SectionEditor Section="section" Vm="Vm" />
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="paper-canvas" aria-busy="@(Vm.IsRenderingPreview ? "true" : "false")">
                    @if (Vm.IsRenderingPreview)
                    {
                        <div class="preview-wait" role="status">@L["RenderingPreview"]</div>
                    }
                    @for (var i = 0; i < Vm.PreviewPages.Count; i++)
                    {
                        <img class="page-img" alt="@($"{L["Preview"]} {i + 1}/{Vm.PreviewPages.Count}")" src="@PageSource(Vm.PreviewPages[i])" />
                    }
                </div>
            }
        </section>

    </main>

    @if(commandOpen)
    {
      <div class="command-backdrop" @onclick="HideCommands"></div>
      <section class="command-palette" role="dialog" aria-modal="true" aria-labelledby="commands-title">
        <h2 id="commands-title">@L["WB.Commands"]</h2>
        <input id="command-query" aria-label="@L["WB.Search"]" placeholder="@L["WB.Search"]" @bind="commandQuery" @bind:event="oninput"/>
        <div class="command-results" role="group" aria-label="@L["WB.Commands"]">
         @foreach(var command in FilteredCommands)
         {
          <button type="button" @onclick="() => ExecuteWebCommand(command)">@command.Label</button>
         }
        </div>
        @if(!FilteredCommands.Any()) { <p class="small muted" role="status">@L["WB.NoCommands"]</p> }
        <p class="small muted">@L["WB.PaletteKeys"]</p>
        <button type="button" class="quiet" @onclick="HideCommands">@L["Cancel"]</button>
      </section>
    }
    <footer class="statusbar @(Vm.IsError ? "error" : "")" role="status" aria-live="polite">
        <span>@Vm.StatusMessage</span><span>@Vm.StepPosition</span><span>@Vm.ModelStatusText</span>
        @if(Vm.HasWorkbenchActivity) { <span>@Vm.WorkbenchActivity.EstimateText</span><span>@Vm.WorkbenchActivity.PowerNote</span> }
        <button class="quiet small" type="button" @onclick='() => ShowTool("activity")'>@L["WB.WatchActivity"]</button>
        @if (Engine.Gate.Waiting > 0)
        {
            <span class="muted">@string.Format(L.Culture, T("Waiting"), Engine.Gate.Waiting)</span>
        }
    </footer>
</div>
